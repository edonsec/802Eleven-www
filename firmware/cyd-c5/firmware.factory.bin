<body>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>802Eleven</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='14'%20fill='%230f1420'/%3E%3Ctext%20x='32'%20y='40'%20font-family='Arial,Helvetica,sans-serif'%20font-size='24'%20font-weight='700'%20text-anchor='middle'%20fill='%234da3ff'%3E802%3C/text%3E%3Cpath%20d='M44%2016a16%2016%200%200%201%2012%205'%20stroke='%2337d67a'%20stroke-width='3'%20fill='none'%20stroke-linecap='round'/%3E%3Cpath%20d='M47%2020a10%2010%200%200%201%207%203'%20stroke='%2337d67a'%20stroke-width='3'%20fill='none'%20stroke-linecap='round'%20opacity='.85'/%3E%3Ccircle%20cx='51'%20cy='25'%20r='2.5'%20fill='%2337d67a'/%3E%3C/svg%3E">


</head>
<body>
<div id="authGate">
  <form id="authForm" onsubmit="authSubmit(event)">
    <div class="agtitle"><span class="brandlong">802</span><span>Eleven</span></div>
    <div class="agsub">Enter access password</div>
    <input id="authPass" type="password" autocomplete="current-password" placeholder="password">
    <button type="submit">Unlock</button>
    <div id="authErr" class="agerr"></div>
  </form>
</div>
<div id="splashGate">
  <div class="spltitle"><span class="brandlong">802</span><span>Eleven</span></div>
  <div class="splsub">Continue live, or jump straight to reviewing an offline import.</div>
  <div class="splrow">
    <button class="splbadge wifi" onclick="splashPick('wifi')">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 8.5a16 16 0 0 1 20 0"/><path d="M5.5 12.5a11 11 0 0 1 13 0"/>
        <path d="M9 16.5a5.5 5.5 0 0 1 6 0"/><circle cx="12" cy="20" r="1.2" fill="currentColor" stroke="none"/>
      </svg>
      <div class="spllabel">WiFi Radar</div>
      <div class="splhint">Probe/beacon capture</div>
    </button>
    <button class="splbadge offline" onclick="splashPick('offline')">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 8.5a16 16 0 0 1 20 0"/><path d="M5.5 12.5a11 11 0 0 1 13 0"/>
        <path d="M9 16.5a5.5 5.5 0 0 1 6 0"/><circle cx="12" cy="20" r="1.2" fill="currentColor" stroke="none"/>
        <line x1="3" y1="3" x2="21" y2="21"/>
      </svg>
      <div class="spllabel">Offline</div>
      <div class="splhint">Import/export only, no scan</div>
    </button>
  </div>
</div>
<div id="wifiLoadGate">
  <div class="spltitle">Resume a capture?</div>
  <div class="splsub">Saved data is on this board's SD card. Pick a source, then a file to load.</div>
  <div class="wlgbox">
    <div class="wlgtabs" id="wlgTabs"></div>
    <select id="wifiLoadSel" size="6"></select>
    <button class="go" onclick="wifiLoadPick(true)">Load selected</button>
    <button onclick="wifiLoadPick(false)">Start fresh session</button>
  </div>
</div>
<header>
  <h1 id="title" onclick="reopenSplash()" title="change mode"><span class="brandlong">802</span><span>Eleven</span></h1>
  <div class="controls">
    <div class="segwrap">
      <div class="seg" id="modeSeg" title="WiFi probe/beacon capture">
        <button id="modeWifi" class="segbtn"     onclick="onWifiBtn()">WiFi&nbsp;<span id="wifiCaret" class="caret" style="display:none">&#9662;</span></button>
      </div>
      <div id="capPop" class="cappop">
        <div class="captabs" style="display:none" id="capScoutTabs">
          <button id="ctabCap"   class="captab on" onclick="capTab('cap')">Capture</button>
          <button id="ctabScout" class="captab" onclick="capTab('scout')">Scout</button>
        </div>
        <!-- CAPTURE pane: timed monitor-mode burst on the primary radio -->
        <div id="capPane" class="cappane">
          <div class="utabs" style="margin-bottom:7px">
            <button id="csubScan"    class="utab on" onclick="capSubTab('scan')">Scan</button>
            <button id="csubIntelli" class="utab"    onclick="capSubTab('intelli')">Intelliscan</button>
          </div>
          <!-- SCAN sub-pane: plain timed window over a channel/type/data set -->
          <div id="capSubScanPane">
            <div class="cappop-hd">Scan window</div>
            <div class="cappre">
              <button onclick="setCapDur(15)">15s</button>
              <button onclick="setCapDur(30)">30s</button>
              <button onclick="setCapDur(60)">1m</button>
              <button onclick="setCapDur(120)">2m</button>
              <button onclick="setCapDur(300)">5m</button>
            </div>
            <div class="caprow">
              <input type="range" id="capRange" min="5" max="300" value="30" step="5"
                     oninput="document.getElementById('capLbl').textContent=fmtDur(+this.value)">
              <b id="capLbl">20s</b>
            </div>
<div class="cappop-hd" style="margin-top:11px">Channels</div>
            <!-- 2.4GHz/5GHz tabs, hidden (2.4GHz-only) until this board's own
                 radio reports dual-band capability (WIFI_BAND_DUAL, e.g. a
                 standalone T-Dongle-C5/esp32-c5-wifi-only build) -- see
                 syncCapBand/d.capdual. Same pattern as scoutBandTabs below. -->
            <div id="capBandTabs" class="captabs" style="display:none">
              <button id="cbtab24" class="captab on" onclick="setCapChipBand('24')">2.4GHz</button>
              <button id="cbtab5"  class="captab"    onclick="setCapChipBand('5')">5GHz</button>
            </div>
            <div id="capChips" class="chanchips" title="Auto hops 1-13. Tap channels to hop only those (more dwell each). One channel = lock."></div>
            <div id="cap5Chips" class="chanchips" style="display:none" title="5GHz channels to hop (dual-band radio only, e.g. a standalone ESP32-C5). Independent of the 2.4GHz set -- the capture alternates a dwell on each band."></div>
            <!-- Band on/off: hard-excludes one band from the hop entirely (vs. just
                 narrowing its channel set). Both start highlighted (= active);
                 un-click one to exclude that band -- inverted from a normal
                 pause button (highlighted = active, not "paused"), so it reads
                 the same as a channel chip. Staged like every other cap toggle
                 (flip only, applied together at Start capture -- see
                 startCapture's query string) since this board's own capture
                 popover isn't even reachable mid-run. Hidden until dual-band
                 (see syncCapBand) -- meaningless with only one band to hop. -->
            <span id="capBandPause" style="display:none">
              <button id="capPause24Btn" class="tgl on" onclick="toggleCapBandPause('24')" title="2.4GHz band is included in this capture. Click to exclude it (5GHz only).">2.4GHz</button>
              <button id="capPause5Btn" class="tgl on" onclick="toggleCapBandPause('5')" title="5GHz band is included in this capture. Click to exclude it (2.4GHz only).">5GHz</button>
            </span>
            <div class="cappop-hd" style="margin-top:11px">Frame types</div>
            <div id="capTypes" class="chanchips" title="Which 802.11 frame kinds the local capture keeps. Dropped kinds never reach the store.">
              <button id="capTBeacon" class="tgl on" onclick="toggleCapType('capTBeacon')">BCN</button>
              <button id="capTProbe"  class="tgl on" onclick="toggleCapType('capTProbe')">PRB</button>
              <button id="capTAssoc"  class="tgl on" onclick="toggleCapType('capTAssoc')">ASC</button>
              <button id="capTDeauth" class="tgl on" onclick="toggleCapType('capTDeauth')">DEA</button>
              <button id="capDataBtn" class="tgl" onclick="toggleCapData()" title="Also capture 802.11 DATA frames to pair already-connected clients to their AP (not just ones that re-associate during the window). Heavier: data frames vastly outnumber mgmt frames.">DAT</button>
            </div>
            <div class="caphint muted">AP drops while capturing (no full-duplex). Reconnects and loads results when the window ends.</div>
            <button class="iconbtn on cappop-go" onclick="startCaptureModal()">Start capture</button>
          </div>
          <!-- INTELLISCAN sub-pane: locks the capture to already-known beacon channels only -->
          <div id="capSubIntelliPane" style="display:none">
            <div class="cappop-hd">Intelliscan</div>
            <div class="caphint muted" id="intelliInfo">Hops only the 2.4GHz channels a known beacon has already been seen on, instead of all 13.</div>
            <div class="cappop-hd" style="margin-top:11px">Per-channel time</div>
            <div class="cappre">
              <button onclick="setIntelliDur(15)">15s</button>
              <button onclick="setIntelliDur(30)">30s</button>
              <button onclick="setIntelliDur(60)">1m</button>
              <button onclick="setIntelliDur(120)">2m</button>
              <button onclick="setIntelliDur(300)">5m</button>
            </div>
            <div class="caprow">
              <input type="range" id="intelliSecsInput" min="5" max="300" value="30" step="5"
                     oninput="document.getElementById('intelliSecsLbl').textContent=fmtDur(+this.value);refreshIntelliInfo()">
              <b id="intelliSecsLbl">20s</b>
            </div>
            <button id="intelliStartBtn" class="iconbtn on cappop-go" onclick="startIntelliScan()">Start Intelliscan</button>
          </div>
        </div>
        <!-- SCOUT pane: independent channel set for the always-on companion -->
        <div id="scoutPane" class="cappane" style="display:none">
          <div class="cappop-hd">Scout channels</div>
          <!-- 2.4GHz/5GHz tabs: both chip sets together overflow the popover's
               fixed 236px width on mobile (13 + 25 chips), so only one band's
               chips render at a time. Tabs stay hidden (2.4GHz-only, no
               switcher shown) until a dual-band scout is linked. -->
          <div id="scoutBandTabs" class="captabs" style="display:none">
            <button id="sbtab24" class="captab on" onclick="setScoutChipBand('24')">2.4GHz</button>
            <button id="sbtab5"  class="captab"    onclick="setScoutChipBand('5')">5GHz</button>
          </div>
          <div id="scoutChips" class="chanchips" title="Channels the scout hops. Independent of capture."></div>
          <button id="scoutPause24Btn" class="tgl" onclick="toggleScoutBandPause('24')" title="Pause the 2.4GHz band on the scout's single radio -- independent of the 5GHz band below. Use this to keep the radio pinned entirely on a locked 5GHz channel instead of alternating a dwell back to 2.4GHz.">Pause 2.4GHz</button>
          <div id="scout5Chips" class="chanchips" style="display:none" title="5GHz channels the scout hops (dual-band scout only, e.g. ESP32-C5). Independent of the 2.4GHz set -- the scout alternates a dwell on each band."></div>
          <button id="scoutPause5Btn" class="tgl" style="display:none" onclick="toggleScoutBandPause('5')" title="Pause the 5GHz band on the scout's single radio -- independent of the 2.4GHz band above.">Pause 5GHz</button>
          <div class="cappop-hd" style="margin-top:11px">Frame types <span class="muted">(sent over UART)</span></div>
          <div id="scoutTypes" class="chanchips" title="Which 802.11 frame kinds the scout forwards. Turn off noisy kinds (beacons/probes) to free UART bandwidth for rare assoc/deauth lines.">
            <button id="scoutTBeacon" class="tgl on" onclick="toggleScoutType('scoutTBeacon')">BCN</button>
            <button id="scoutTProbe"  class="tgl on" onclick="toggleScoutType('scoutTProbe')">PRB</button>
            <button id="scoutTAssoc"  class="tgl on" onclick="toggleScoutType('scoutTAssoc')">ASC</button>
            <button id="scoutTDeauth" class="tgl on" onclick="toggleScoutType('scoutTDeauth')">DEA</button>
            <button id="scoutDataBtn" class="tgl" onclick="toggleScoutData()" title="Scout also captures 802.11 DATA frames â€” pairs already-connected clients continuously. Independent of the primary capture toggle. Heavier: floods the UART link.">DAT</button>
          </div>
          <div class="cappop-hd" style="margin-top:11px">UART recovery</div>
          <div class="caprow">
            <button id="scoutPauseBtn" class="tgl" onclick="toggleScoutPause()" title="Idle by default: the scout stays out of promiscuous mode until armed. Toggle to arm/stop it â€” stopped means it's a bare, cheap UART pipe, not sniffing.">Pause link</button>
            <button id="scoutFlushBtn" class="iconbtn" onclick="flushScout()" title="Drop whatever's still queued in the scout's TX buffer and this side's stale RX bytes, then resync on a clean line.">Flush</button>
          </div>
          <div class="caphint muted">The scout board streams continuously. Pick which channels it hops, then tap Send.</div>
          <button id="scoutSend" class="iconbtn cappop-go" onclick="sendScout()">Sent to Scout</button>
        </div>
      </div>
    </div>
    <button id="liveBtn" class="iconbtn on" onclick="toggleLive()" title="live auto-refresh on/off"><span class="livedot"></span><span class="btxt">Live</span></button>
    <button id="liteRefreshBtn" class="iconbtn" style="display:none" onclick="liteRefresh()" title="Lite mode: no auto-refresh/WebSocket -- tap to pull the latest data"><span class="btxt">&#8635; Refresh</span></button>
    <button id="gearBtn" class="iconbtn" onclick="openSetModal()" title="settings"><span class="gear">&#9881;</span></button>
  </div>
</header>
