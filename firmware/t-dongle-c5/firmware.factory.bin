  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%;text-size-adjust:100%}   /* iOS Safari else auto-inflates text on pinch-zoom/rotate */
  /* Soft decorative background wash, purely cosmetic. Lives directly on `body`'s own background
     -- NOT a ::before pseudo -- so it's guaranteed to paint as the bottommost layer of body's
     box, below every real child (header/sidenav/table/etc) with zero stacking-context
     ambiguity (a positioned ::before pseudo outranks ordinary non-positioned content in paint
     order regardless of z-index, so it'd show through the header/sidebar/table instead of
     sitting behind them). Pure CSS (no SVG/data-URI): a diagonal `var(--accent)` wash via
     color-mix() -- tracks whatever theme is active live. Two fade layers clip its edges the way
     a `mask` would (CSS `mask` can't be put on `body` itself without also masking its real
     children): a top fade (var(--bg) solid near the very top, out by mid-page, so it doesn't
     crowd the header) and a radial vignette (transparent center, fading to var(--bg) past ~55%
     radius) clipping the other edges. Wash alpha kept deliberately prominent (22%/16%) so the
     theme colour reads as a real gradient, not just a faint tint; 315deg angle so the brighter
     stop sits near the bottom of the page rather than the top. */
  body{margin:0;font:14px/1.45 system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
       color:var(--fg);display:flex;flex-direction:column;min-height:100vh;
       background-color:var(--bg);
       background-image:
         linear-gradient(to bottom,var(--bg) 0%,var(--bg) 6%,transparent 32%),
         radial-gradient(ellipse 85% 75% at 50% 45%,transparent 0%,transparent 55%,var(--bg) 100%),
         linear-gradient(315deg,color-mix(in srgb,var(--accent) 22%,transparent),transparent 55%,color-mix(in srgb,var(--accent) 16%,transparent));
       background-repeat:no-repeat,no-repeat,no-repeat;
       background-size:100% 100%,100% 100%,100% 100%}
  /* ---- password gate overlay (shown only on a 401 from the API) ---- */
  #authGate{position:fixed;inset:0;z-index:1000;display:none;
       align-items:center;justify-content:center;
       background:radial-gradient(circle at 50% 38%,var(--onbg),var(--surface2))}
  #authGate.show{display:flex}
  #authForm{display:flex;flex-direction:column;gap:12px;width:min(320px,86vw);
       padding:26px;background:var(--panel);border:1px solid var(--line);
       border-radius:12px;box-shadow:0 20px 60px #000a}
  .agtitle{font-size:22px;letter-spacing:.5px;text-align:center}
  .agtitle span{color:var(--accent)} .agtitle .brandlong{color:var(--fg)}
  .agsub{color:var(--muted);font-size:12px;text-align:center;margin-bottom:2px}
  #authForm input{padding:10px}
  #authForm button{padding:10px;background:var(--onbg);border-color:var(--accent);color:var(--accent)}
  .agerr{color:var(--cli);font-size:12px;text-align:center;min-height:15px}
  /* ---- boot splash (confirms live before the radio is polled) ---- */
  #splashGate{position:fixed;inset:0;z-index:900;display:flex;
       flex-direction:column;gap:26px;align-items:center;justify-content:center;
       padding:24px;box-sizing:border-box;
       background:radial-gradient(circle at 50% 38%,var(--onbg),var(--surface2))}
  #splashGate.hide{display:none}
  .spltitle{font-size:26px;letter-spacing:.5px;text-align:center}
  .spltitle span{color:var(--accent)} .spltitle .brandlong{color:var(--fg)}
  .splsub{color:var(--muted);font-size:13px;text-align:center;margin-top:-14px;max-width:320px}
  .splrow{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;max-width:100%}
  .splbadge{display:flex;flex-direction:column;align-items:center;gap:10px;
       width:180px;padding:28px 18px;background:var(--panel);border:1px solid var(--line);
       border-radius:16px;cursor:pointer;color:var(--fg);font:inherit;
       box-shadow:0 20px 60px #000a;transition:border-color .15s,transform .15s}
  .splbadge:hover{border-color:var(--accent);transform:translateY(-2px)}
  .splbadge svg{width:52px;height:52px}
  .splbadge .spllabel{font-size:16px;letter-spacing:.5px}
  .splbadge .splhint{color:var(--muted);font-size:11px;text-align:center}
  .splbadge.wifi svg{stroke:var(--pub)}
  .splbadge.offline svg{stroke:var(--muted)}
  /* ---- WiFi resume-capture sub-splash (only shown when picking WiFi Radar and a saved capture exists) ---- */
  #wifiLoadGate{position:fixed;inset:0;z-index:910;display:none;
       flex-direction:column;gap:22px;align-items:center;justify-content:center;
       padding:24px;box-sizing:border-box;
       background:radial-gradient(circle at 50% 38%,var(--onbg),var(--surface2))}
  #wifiLoadGate.show{display:flex}
  .wlgbox{display:flex;flex-direction:column;gap:12px;width:min(320px,90vw)}
  .wlgbox select{width:100%;padding:6px;min-height:0}
  .wlgbox button{padding:10px}
  .wlgtabs{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
  .wlgtabs button{flex:1;border:0;border-radius:0;padding:8px;background:var(--surface);color:var(--muted)}
  .wlgtabs button.on{background:var(--onbg);color:var(--accent)}
  .wlgbox button.go{background:var(--onbg);border-color:var(--accent);color:var(--accent)}
  /* ---- header ---- */
  header{position:sticky;top:0;z-index:15;background:var(--header-bg,var(--panel));
         border-bottom:1px solid var(--line);padding:8px 12px;
         display:flex;gap:8px 14px;align-items:center;flex-wrap:wrap}
  h1{font-size:15px;margin:0;letter-spacing:.5px;white-space:nowrap;cursor:pointer}
  h1 span{color:var(--accent)}
  h1 .brandlong{color:var(--fg)}
  .chips{display:flex;gap:6px;flex-wrap:wrap}
  .chip{background:var(--surface);border:1px solid var(--line);border-radius:20px;
        padding:3px 9px;font-size:12px;color:var(--muted);white-space:nowrap}
  .chip b{color:var(--fg)}
  .controls{margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
  input,button,select,textarea,a.icobtn{font:inherit;background:var(--surface);color:var(--fg);
        border:1px solid var(--line);border-radius:6px;padding:5px 8px}
  button{cursor:pointer}button:hover{border-color:var(--accent)}
  a.icobtn{cursor:pointer;text-decoration:none;display:inline-flex}
  a.icobtn:hover{border-color:var(--accent)}
  input[type=number]{width:64px}
  /* themed range sliders (capture/poll/mincnt/band/... every input[type=range]
     on the page) -- browsers give these no theme-able default, so track +
     thumb are drawn from scratch per vendor prefix, keyed off the same
     --accent/--line/--surface vars as everything else. */
  input[type=range]{-webkit-appearance:none;appearance:none;background:transparent;
        border:none;padding:0;height:14px;cursor:pointer}
  input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:var(--line)}
  input[type=range]::-moz-range-track{height:4px;border-radius:2px;background:var(--line)}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
        width:14px;height:14px;border-radius:50%;background:var(--accent);
        border:2px solid var(--surface);margin-top:-5px;cursor:pointer}
  input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;
        background:var(--accent);border:2px solid var(--surface);cursor:pointer}
  input[type=range]:focus{outline:none}
  input[type=range]:focus::-webkit-slider-runnable-track{background:var(--muted)}
  input[type=range]:focus::-moz-range-track{background:var(--muted)}
  .controls label{display:flex;gap:5px;align-items:center;color:var(--muted);font-size:12px}
  .iconbtn{display:flex;gap:5px;align-items:center;color:var(--muted);font-size:13px;padding:6px 12px;border-radius:7px}
  .iconbtn.on{color:var(--accent);border-color:var(--accent);background:var(--onbg)}
  .iconbtn.off{opacity:.5}
  /* header mode segment (WiFi) */
  .seg{display:inline-flex;background:var(--surface);border:1px solid var(--line);
       border-radius:8px;padding:2px;gap:2px}
  .segbtn{border:none;background:transparent;color:var(--muted);
          padding:5px 15px;border-radius:6px;font-size:13px;letter-spacing:.3px;
          transition:color .15s,background .15s}
  .segbtn:hover{color:var(--fg);border:none}
  .segbtn.on{background:var(--onbg);color:var(--accent);
             box-shadow:inset 0 0 0 1px var(--accent)}
  .caret{font-size:9px;opacity:.8;transition:transform .15s}
  #modeWifi.popopen .caret{transform:rotate(180deg)}
  /* capture popover under the WiFi segment */
  .segwrap{position:relative}
  /* max-height+overflow-y so a tall pane (e.g. Scan's channel chips growing to a 5GHz grid on a
     WIFI_BAND_DUAL board) scrolls internally instead of pushing Start-capture/Standalone off the
     bottom of the viewport. */
  .cappop{position:absolute;top:calc(100% + 8px);right:0;z-index:40;display:none;
          width:260px;max-height:82vh;overflow-y:auto;background:var(--panel);border:1px solid var(--accent);
          border-radius:10px;padding:11px;box-shadow:0 12px 34px #000b}
  .cappop.on{display:block}
  .cappop-hd{font-size:10px;letter-spacing:.09em;text-transform:uppercase;
             color:var(--accent);margin-bottom:9px}
  .cappop .cappre{padding:0 0 8px}
  .cappop .caprow{padding:0}
  .cappop .caphint{padding:8px 0 2px}
  .cappop-go{width:100%;justify-content:center;margin-top:9px}
  /* T-Dongle / Sentinel header popover: sections with a label column that scales with the panel
     instead of a fixed px width -- a long label (e.g. "New SSID flash") no longer overflows its
     column into the value column next to it. */
  .dongpop{width:320px;max-height:74vh;overflow-y:auto;padding:13px 14px}
  .dhead{display:flex;align-items:center;gap:7px;font-size:11px;font-weight:700;letter-spacing:.08em;
         text-transform:uppercase;color:var(--fg);padding-bottom:9px;border-bottom:1px solid var(--line);
         margin-bottom:5px}
  .dhead svg{flex:none;color:var(--accent)}
  /* Underline tab strip: one continuous bottom rule + an accent underline on the active tab,
     rather than separate bordered chips -- reads as one control switching a single panel instead
     of a row of standalone buttons. Used by the dongle popover's top-level tabs (Display/Device/
     Sentinel) and the capture popover's Scan/Intelliscan sub-tabs. Deliberately NOT used for the
     capture popover's own Capture/Scout top-level tabs (#capScoutTabs) -- those use the bordered
     .captab chip style instead, so the two stacked tab rows read as distinct levels (outer board
     vs. inner sub-view) when a scout is linked and both rows show at once. */
  .utabs{display:flex;border-bottom:1px solid var(--line)}
  .utab{flex:1;background:none;border:none;border-bottom:2px solid transparent;border-radius:0;
        color:var(--muted);padding:6px 4px 8px;font-size:11.5px;letter-spacing:.02em}
  .utab:hover{color:var(--fg)}
  .utab.on{color:var(--accent);border-bottom-color:var(--accent)}
  /* Dongle-popover variant: bleeds edge-to-edge under the panel's own padding. */
  .dongtabs{margin:0 -14px 10px;padding:0 14px}
  .dsec{padding:10px 0 5px;border-bottom:1px solid var(--line)}
  .dsec:last-child{border-bottom:none}
  .dsec-hd{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--accent);margin-bottom:8px}
  .drow{display:grid;grid-template-columns:minmax(76px,38%) minmax(0,1fr);align-items:center;
        gap:8px;padding:5px 6px;margin:0 -6px;border-radius:6px;font-size:12px;
        transition:background .12s}
  .drow:hover{background:var(--onbg)}
  .drow .k{color:var(--muted);line-height:1.3}
  .drow .v{display:flex;flex-wrap:wrap;align-items:center;gap:4px;min-width:0}
  .drow .v select{width:100%;min-width:0;font-size:12px;padding:4px 6px}
  .drow .v .tgl{padding:3px 8px;font-size:11px}
  /* Idle-view row pairs its select with a lock icon (pin BOOT-button cycling to this view) --
     the select gives up width:100% so the lock button fits beside it on the same line. */
  .drow .v:has(#idleLockBtn) select{width:0;flex:1}
  .drow .v .iconbtn{flex:none;padding:4px 6px}
  /* Single-letter watch toggles (D/K/R) -- a fixed-width square badge reads faster than three
     full words crammed into one row; the full name still lives in the title/aria-label. */
  .drow .v .tgl.letter{width:24px;padding:3px 0;text-align:center;font-weight:600}
  .drow .v input[type=range]{flex:1;min-width:40px}
  .dimval{flex:none;font-size:11px;color:var(--muted);min-width:32px;text-align:right}
  /* Tab bar + panes splitting the popover into Display/Power/Device/Sentinel, each
     getting the panel's full width instead of one long scrolling list. */
  .dongpane{animation:dongfade .12s ease-out}
  @keyframes dongfade{from{opacity:0}to{opacity:1}}
  /* Expandable multi-channel picker (Sentinel's Channel row) -- collapsed by default so the
     25-entry 5GHz chip set doesn't dominate the panel; the summary button names what's active. */
  .sentexp{padding:2px 0 8px;margin-top:-2px}
  .sentexp .captabs{margin-bottom:7px}
  /* Pill switch: a single on/off control reads faster as a track+knob than a text "On"/"Off"
     chip, and needs no label of its own -- the row's .k already names it. Used only for genuine
     binary toggles (chip groups like Watches/Rogue set stay .tgl, since those are multi-select). */
  .swpill{flex:none;position:relative;width:34px;height:19px;padding:0;border-radius:10px;
          border:1px solid var(--line);background:var(--surface);cursor:pointer;
          transition:background .15s,border-color .15s}
  .swpill::after{content:'';position:absolute;top:2px;left:2px;width:13px;height:13px;
                 border-radius:50%;background:var(--muted);
                 transition:transform .18s cubic-bezier(.4,0,.2,1),background .15s}
  .swpill:hover{border-color:var(--muted)}
  .swpill.on{background:var(--onbg);border-color:var(--accent)}
  .swpill.on::after{transform:translateX(15px);background:var(--accent)}
  .swpill:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .dong-go{width:100%;justify-content:center;margin:8px 0 4px}
  .dhint{font-size:11px;line-height:1.5;color:var(--muted);padding:2px 0 6px}
  #dongleBtn.popopen{border-color:var(--accent);color:var(--accent)}
  /* Start capture / Start Intelliscan: same subtle look as every other
     .iconbtn.on chip (incl. Send to Scout) -- no gradient fill */
  /* capture popover: Capture / Scout tabs + channel-set chips */
  .captabs{display:flex;gap:4px;margin-bottom:11px}
  .captab{flex:1;background:var(--surface);border:1px solid var(--line);color:var(--muted);
          border-radius:7px;padding:6px 0;font-size:12px;font-weight:600}
  .captab.on{color:var(--accent);border-color:var(--accent);background:var(--onbg)}
  .chanchips{display:flex;flex-wrap:wrap;gap:5px;margin:2px 0 4px}
  .chanchips button{width:30px;height:28px;padding:0;font-size:12px;background:var(--surface);
          border:1px solid var(--line);color:var(--muted);border-radius:6px}
  .chanchips button.on{color:var(--accent);border-color:var(--accent);
          background:var(--onbg);font-weight:700}
  .chanchips button.auto{width:auto;padding:0 12px;letter-spacing:.03em}
  /* 5GHz channel numbers run to 3 digits (up to 165) -- the 2.4GHz chips'
     fixed 30px width (sized for 1-13) clips them, so widen just this row. */
  #scout5Chips button:not(.auto),#cap5Chips button:not(.auto){width:36px;font-size:10.5px}
  /* deauth flood row highlight */
  #det tr.deauth-flood td{background:rgba(255,80,80,.12)}
  #det tr.deauth-flood td b{color:#ff6b6b}
  /* Authorisations tab body: consistent horizontal padding + spacing between
     the deauth/handshake/SD/RAM subsections (was flush-left, ad hoc margins) */
  .authbody{padding:10px 12px 12px;display:flex;flex-direction:column;gap:16px}
  .authsub{display:flex;align-items:center;justify-content:space-between;gap:10px;
           font-size:12px;letter-spacing:.03em;color:var(--muted);margin-bottom:6px}
  .authsub .c{color:var(--accent)}
  #deauthSec .authsub .c{color:#ff6b6b}   /* deauth/disassoc count -- danger red, not the neutral accent */
  .authsub-actions{display:flex;align-items:center;gap:8px}
  .hsrarm{display:flex;align-items:center;gap:6px;padding-right:8px;border-right:1px solid var(--line)}
  .authempty{font-size:12px;padding:2px 0}
  /* Stat bar: full handshakes / PMKID captures / networks -- three tiles,
     divider between (not a card each -- one strip reads as one unit) */
  .authsum{display:flex;background:var(--surface);border:1px solid var(--line);
           border-radius:8px;overflow:hidden}
  .stattile{flex:1;min-width:0;padding:8px 14px;display:flex;flex-direction:column;
            gap:2px;border-right:1px solid var(--line)}
  .stattile:last-child{border-right:none}
  .stattile .v{font-size:19px;font-weight:600;color:var(--fg);line-height:1.15}
  .stattile .l{font-size:10px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
  #hst tr.hs-full td{background:rgba(80,220,140,.10)}
  #hst tr.hs-full td b{color:#4ade80}
  .hsdots{display:inline-flex;gap:3px}
  .hsdots span{width:8px;height:8px;border-radius:50%;background:#2a3350;display:inline-block}
  .hsdots span.on{background:var(--accent)}
  .pmk{font-family:monospace;font-size:11px;cursor:pointer}
  .pmk.none{color:var(--muted);cursor:default;font-family:inherit}
  #pmkOnlyBtn.on{color:var(--accent);border-color:var(--accent)}
  /* Authorisations tab on phones: DET/HST have 7-8 columns -- rather than
     stacking each row into a tall multi-line card (was several screens per
     row), keep it a real compact table: smaller type/padding, no wrap, and
     let the existing .scroll wrapper carry the overflow horizontally so a
     row stays scannable in one line. */
  @media(max-width:560px){
    #det,#hst{white-space:nowrap;font-size:11px}
    #det th,#hst th,#det td,#hst td{padding:5px 7px}
    .stattile{padding:7px 8px}
    .stattile .v{font-size:16px}
    .stattile .l{font-size:9px;letter-spacing:.04em}
  }
  /* WiFi station (client) rows nested under their AP's beacon row */
  #dt tbody tr.trCli{background:rgba(122,162,247,.06)}
  #dt tbody tr.trCli td{border-top:1px dashed rgba(122,162,247,.25)}
  #dt tbody tr.trCli td.ssid{padding-left:26px;color:var(--muted)}
  #dt tbody tr.trCli td.ssid::before{content:'\21b3';margin-right:6px;color:var(--pub)}
  .expBtn{background:none;border:none;color:var(--muted);cursor:pointer;font-size:11px;
          padding:2px 6px;line-height:1}
  .expBtn:hover{color:var(--fg)}
  .expBtn.on{color:var(--pub)}
  .maclink{color:var(--accent);cursor:pointer;border-bottom:1px dotted var(--accent)}
  .maclink:hover{color:var(--fg);border-bottom-color:var(--fg)}
  #macModalBody .sethint{color:var(--muted);font-size:12px;margin-top:6px;line-height:1.6;
    font-variant-ligatures:none}
  #macModalBody .clientlist{margin-top:8px;max-height:200px;overflow-y:auto}
  #macModalBody .clientrow{display:flex;justify-content:space-between;gap:10px;
    align-items:baseline;padding:3px 0;border-bottom:1px solid var(--line);
    font-size:12px;font-variant-ligatures:none}
  #macModalBody .clientrow:last-child{border-bottom:none}
  #macModalBody .clientrow .muted{white-space:nowrap;font-variant-numeric:tabular-nums}
  /* Associated-stations table: mirror the DEVICES table look inside the modal. */
  #macModalBody .clitbl-wrap{margin-top:8px;max-height:230px;overflow:auto;
    border:1px solid var(--line);border-radius:8px}
  #macModalBody .clitbl{font-size:12px}
  #macModalBody .clitbl th{cursor:default;font-size:11px}
  #macModalBody .clitbl td,#macModalBody .clitbl th{padding:5px 9px}
  #macModalBody .clitbl td.rssi{font-variant-numeric:tabular-nums}
  /* MAC card identity strip -- role + name/SSID + MAC (copyable) + type/sec
     tags up front, so the two things a user actually scans for (what is
     this, how strong/secure is it) don't wait behind a wall of k/v rows. */
  .macid{display:flex;align-items:center;gap:11px;padding:14px 16px;
         border-bottom:1px solid var(--line)}
  .macid-badge{flex:none;width:34px;height:34px;border-radius:50%;
         display:flex;align-items:center;justify-content:center;
         font-size:15px;border:1px solid var(--line);color:var(--muted);
         background:var(--surface)}
  .macid.ap .macid-badge{color:var(--pub);border-color:var(--pub)}
  .macid.cli .macid-badge{color:var(--cli);border-color:var(--cli)}
  .macid-main{min-width:0;flex:1}
  .macid-name{font-size:15px;font-weight:700;overflow:hidden;
         text-overflow:ellipsis;white-space:nowrap}
  .macid-sub{font-size:11px;color:var(--muted);margin-top:1px;
         overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .macid-mac{font-size:11px;color:var(--muted);margin-top:3px;cursor:pointer;
         font-variant-ligatures:none;display:inline-flex;align-items:center;gap:5px}
  .macid-mac:hover{color:var(--fg)}
  .macid-mac .copyhint{font-size:11px;opacity:.6}
  .macid-mac.copied{color:var(--pub)}
  .macid-tags{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:4px}
  .macsignal .statgrid{margin-bottom:0}
  .sigbar-wrap{height:6px;border-radius:5px;background:var(--surface);
         border:1px solid var(--line);overflow:hidden;margin-top:11px}
  .sigbar{height:100%;background:var(--accent);transition:width .3s ease}
  .sigbar.good{background:#4ade80}
  .sigbar.ok{background:#eab308}
  .sigbar.weak{background:#e5484d}
  .actrow{display:flex;flex-wrap:wrap;gap:6px}
  .scoutTgtBtn.primary{background:var(--accent-grad,var(--accent));color:var(--onaccent);
         border-color:var(--accent);font-weight:700}
  .scoutTgtBtn.primary.on{background:var(--onbg);color:var(--accent)}
  .venlbl{color:var(--muted);font-size:11px}   /* vendor label, no border */
  #scoutSend{margin-top:11px;transition:color .12s,border-color .12s,background .12s}
  #scoutSend.dirty{color:var(--accent);border-color:var(--accent);background:var(--onbg)}
  #scoutSend.busy{opacity:.65}         /* in-flight */
  #scoutSend.ok{color:#38d977;border-color:#38d977;background:#0d2418}   /* ack flash */
  #scoutSend.err{color:#ff6b6b;border-color:#ff6b6b;background:#2a1010}   /* send failed */
  #scoutSend:not(.dirty):not(.ok):not(.err):not(.busy){opacity:.65}   /* in sync -> muted */
  /* live auto-refresh dot toggle */
  .livedot{width:8px;height:8px;border-radius:50%;background:var(--pub);
           box-shadow:0 0 6px var(--pub)}
  .iconbtn.off .livedot{background:var(--muted);box-shadow:none}
  /* settings gear button (opens modal) */
  #gearBtn{position:relative;padding:6px 10px}
  #gearBtn .gear{font-size:15px;line-height:1;display:block;transition:transform .3s}
  #gearBtn:hover .gear{transform:rotate(60deg)}
  /* --- settings modal ---------------------------------------------------- */
  .modal{position:fixed;inset:0;z-index:80;display:none;align-items:flex-start;
         justify-content:center;background:var(--scrim);backdrop-filter:blur(2px);
         padding:64px 14px 14px;overflow-y:auto}
  .modal.on{display:flex}
  /* Shared confirm modal always stacks above every other modal it can be opened on top of
     (e.g. rename/delete confirm from inside the File Manager modal) -- relying on DOM order
     alone breaks the moment a later-declared modal happens to follow it in the markup. */
  #confirmModal{z-index:85}
  .modal-card{width:100%;max-width:420px;background:var(--panel);
              border:1px solid var(--line);border-radius:14px;
              box-shadow:0 20px 60px #000c;overflow:hidden}
  /* Settings modal specifically: use most of the screen on desktop instead of
     the 420px mobile-sized default every other modal keeps. min-width alone
     also matches a phone turned sideways (landscape width easily clears
     720px) -- min-height excludes that case (landscape phones are short,
     ~360-430px) so it stays on the mobile-sized card instead of squeezing
     into a 40%-wide strip against a barely-taller-than-the-header viewport. */
  @media(min-width:720px) and (min-height:500px){
    #setModal{padding-top:32px}
    #setModal .modal-card{width:40%;max-width:min(96vw,1400px);
      max-height:calc(100vh - 64px);display:flex;flex-direction:column}
    #setModal .setsec{max-height:calc(100vh - 160px);overflow-y:auto}
  }
  .modal-hd{display:flex;align-items:center;gap:8px;padding:14px 16px;
            border-bottom:1px solid var(--line)}
  .modal-hd h2{margin:0;font-size:15px;letter-spacing:.4px}
  .modal-hd .gear{font-size:16px;color:var(--accent)}
  .modal-x{margin-left:auto;background:transparent;border:none;color:var(--muted);
           font-size:20px;line-height:1;padding:2px 6px;cursor:pointer}
  .modal-x:hover{color:var(--fg)}
  /* MAC-info card sizes to its content on desktop (not the mobile 420px cap).
     Same landscape-phone exclusion as #setModal above. */
  @media(min-width:720px) and (min-height:500px){
    #macModal .modal-card{width:100%;max-width:min(94vw,900px)}
  }
  #macModalBody .clitbl{width:100%}
  /* File Manager modal: near-fullscreen on mobile (a file table with three
     action buttons per row needs real width, unlike the 420px default card),
     wide-but-not-huge on desktop. Row list instead of a <table> so long
     filenames/many buttons WRAP instead of forcing horizontal scroll. */
  @media(min-width:720px) and (min-height:500px){
    #fileMgrModal .modal-card{width:100%;max-width:min(94vw,820px);
      max-height:calc(100vh - 64px);display:flex;flex-direction:column}
    #fileMgrModal .setsec{flex:1;overflow-y:auto}
  }
  @media(max-width:719px),(max-height:499px){
    #fileMgrModal{padding:10px}
    #fileMgrModal .modal-card{max-width:100%;height:calc(100vh - 20px);
      display:flex;flex-direction:column}
    #fileMgrModal .setsec{flex:1;overflow-y:auto}
  }
  .fmrow{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;
         padding:8px 0;border-bottom:1px solid var(--line)}
  .fmrow:last-child{border-bottom:none}
  .fmname{flex:1 1 140px;min-width:0;overflow-wrap:break-word;word-break:break-all;font-size:12px}
  .fmsize{color:var(--muted);font-size:11px;white-space:nowrap}
  .fmbtns{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}
  /* File Manager sections: one horizontal strip of pills, scrolls sideways on a phone */
  .fmtabs{display:flex;gap:6px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none}
  .fmtabs::-webkit-scrollbar{display:none}
  .fmtab{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;padding:6px 12px;
         border-radius:20px;border:1px solid var(--line);background:var(--surface);
         color:var(--muted);font-size:12px;white-space:nowrap}
  .fmtab b{font-weight:600;font-size:11px;color:var(--fg);background:var(--onbg);
           border-radius:10px;padding:0 7px;min-width:18px;text-align:center}
  .fmtab.on{border-color:var(--accent);color:var(--accent);background:var(--onbg)}
  .fmtab.on b{color:var(--accent)}
  .fmhead{display:flex;justify-content:space-between;align-items:baseline;gap:8px;
          padding:4px 0 6px;border-bottom:1px solid var(--accent);margin-bottom:2px}
  .fmhead span:first-child{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--accent)}
  .fmhead span:last-child{font-size:11px;color:var(--muted)}
  .setsec{padding:14px 16px;border-bottom:1px solid var(--line)}
  .setsec:last-child{border-bottom:none}
  .stab-pane{border-bottom:none}
  .settabs-wrap{position:relative;padding:12px 16px 0}
  .settabs{display:flex;gap:4px}
  .settab{flex:1;background:var(--surface);border:1px solid var(--line);color:var(--muted);
          padding:7px 6px;border-radius:7px 7px 0 0;font-size:11px;font-weight:700;
          letter-spacing:.03em;cursor:pointer;text-transform:uppercase}
  .settab.on{color:var(--accent);border-color:var(--accent);background:var(--onbg)}
  .settabmore{display:none}
  /* Mobile: too many settings tabs to fit a row -- collapse into a single
     trigger + dropdown, same pattern as the WiFi-views overflow menu (>>).
     Mirrors the "not desktop-sized card" condition from #setModal's own
     min-width:720px/min-height:500px breakpoint above (De Morgan's: NOT(A
     AND B) = NOT A OR NOT B, comma = OR in a media query) -- a landscape
     phone clears 720px wide but stays short, so it's still on the mobile
     420px-wide card and needs the dropdown just as much as a narrow portrait
     screen does; matching only on width missed that case. */
  @media(max-width:719px),(max-height:499px){
    .settabs-wrap{padding:10px 12px 0}
    .settabmore{display:flex;align-items:center;justify-content:space-between;
         width:100%;background:var(--surface);border:1px solid var(--line);color:var(--accent);
         padding:8px 12px;border-radius:8px;font-size:11px;font-weight:700;
         letter-spacing:.03em;cursor:pointer;text-transform:uppercase}
    .settabmore .care{color:var(--muted);font-size:10px}
    .settabs{display:none;flex-direction:column;gap:0;position:absolute;
         top:100%;left:12px;right:12px;z-index:90;margin-top:4px;
         background:var(--panel);border:1px solid var(--accent);border-radius:8px;
         max-height:min(60vh,360px);overflow-y:auto;-webkit-overflow-scrolling:touch;
         box-shadow:0 8px 24px #0009}
    .settabs.open{display:flex}
    .settabs .settab{flex:none;border:none;border-bottom:1px solid var(--line);
         border-radius:0;text-align:left;padding:10px 12px}
    .settabs .settab:last-child{border-bottom:none}
  }
  .membar-wrap{margin-top:11px}
  .membar-wrap .lbl{display:flex;justify-content:space-between;font-size:11px;
                    color:var(--muted);margin-bottom:3px;font-variant-numeric:tabular-nums}
  .membar{height:8px;border-radius:5px;background:var(--surface);border:1px solid var(--line);overflow:hidden}
  .membar>span{display:block;height:100%;width:0;background:var(--accent);
               transition:width .35s ease}
  .membar.warn>span{background:#eab308}
  .membar.hot>span{background:#e5484d}
  .setsec-hd{font-size:10px;letter-spacing:.1em;text-transform:uppercase;
             color:var(--muted);margin-bottom:10px}
  .setsec-hd .cnt{color:var(--accent);font-weight:700;letter-spacing:normal;
             text-transform:none;font-variant-numeric:tabular-nums}
  .setrow{display:flex;align-items:center;gap:10px;font-size:13px}
  .setrow+.setrow{margin-top:8px}
  .setrow .k{color:var(--muted)}
  .setrow .v{margin-left:auto;font-weight:600;font-variant-numeric:tabular-nums;display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:6px}
  .statgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;font-size:13px}
  .subhd{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:16px 0 8px}
  .subhd:first-of-type{margin-top:0}
  .fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px 12px}
  .field{display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--muted);min-width:0}
  .field select{width:100%;font:inherit;font-size:13px;font-weight:600;color:var(--fg);background:var(--surface);
    border:1px solid var(--line);border-radius:8px;padding:7px 8px}
  .field select:hover{border-color:var(--muted)}
  .field select:focus{outline:none;border-color:var(--accent)}
  details.subdet{margin-top:16px;border:1px solid var(--line);border-radius:10px;padding:0 12px}
  details.subdet>summary{cursor:pointer;padding:10px 0;font-size:12px;font-weight:600;color:var(--muted);list-style:none}
  details.subdet>summary::-webkit-details-marker{display:none}
  details.subdet>summary::after{content:"+";float:right;color:var(--accent)}
  details.subdet[open]>summary::after{content:"\2212"}
  details.subdet[open]{padding-bottom:12px}
  .statgrid>div{display:flex;justify-content:space-between;gap:10px}
  .statgrid .k{color:var(--muted)}
  .statgrid .v{font-weight:600;font-variant-numeric:tabular-nums}
  @media(max-width:380px){.statgrid{grid-template-columns:1fr}}
  .runbtn{padding:4px 9px;font-size:12px;line-height:1;font-weight:700}
  .statuspill{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;
              border-radius:20px;font-size:12px;font-weight:700;letter-spacing:.03em}
  .statuspill.up{background:#123d1e;color:#4ade80;border:1px solid #256b38}
  .statuspill.down{background:#1a1f2b;color:var(--muted);border:1px solid var(--line)}
  .statuspill .dot{width:8px;height:8px;border-radius:50%;background:currentColor;
                   box-shadow:0 0 6px currentColor}
  .navdot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#f87171;
          margin-left:6px;vertical-align:middle;animation:navpulse 1.1s ease-in-out infinite}
  @keyframes navpulse{0%,100%{opacity:1}50%{opacity:.25}}
  .hsToast{position:fixed;left:50%;bottom:18px;transform:translate(-50%,12px);
           background:var(--surface);border:1px solid #256b38;color:#4ade80;
           padding:9px 16px;border-radius:10px;font-size:13px;font-weight:600;
           box-shadow:0 6px 24px rgba(0,0,0,.4);opacity:0;pointer-events:none;
           transition:opacity .25s ease,transform .25s ease;z-index:9000;max-width:88vw}
  .hsToast.on{opacity:1;transform:translate(-50%,0)}
  #sentinelPanel{position:fixed;right:14px;bottom:14px;z-index:850;display:none;
                 max-width:340px;max-height:60vh;overflow-y:auto;
                 background:var(--surface);border:1px solid var(--line);border-radius:10px;
                 padding:10px 12px;box-shadow:0 6px 24px rgba(0,0,0,.4);font-size:12px}
  #sentinelPanel.show{display:block}
  #sentinelPanel.alerting{border-color:#f87171;box-shadow:0 0 0 1px #f87171,0 6px 24px rgba(0,0,0,.4)}
  #sentinelPanel .sp-hd{display:flex;align-items:center;gap:6px;font-weight:700;
                        letter-spacing:.04em;text-transform:uppercase;font-size:10px;
                        color:var(--accent);margin-bottom:8px}
  #sentinelPanel.alerting .sp-hd{color:#f87171}
  #sentinelPanel .sp-close{margin-left:auto;background:none;border:none;color:inherit;
                           font-size:16px;line-height:1;cursor:pointer;padding:0 0 0 8px;
                           opacity:.7;text-transform:none;letter-spacing:normal}
  #sentinelPanel .sp-close:hover{opacity:1}
  #sentinelPanel .sp-dot{width:8px;height:8px;border-radius:50%;background:currentColor;
                         box-shadow:0 0 6px currentColor}
  #sentinelPanel.alerting .sp-dot{animation:navpulse 1.1s ease-in-out infinite}
  #sentinelPanel .sp-msg{padding:6px 0 6px 8px;border-top:1px solid var(--line);
                         border-left:3px solid transparent;line-height:1.5}
  #sentinelPanel .sp-msg:first-of-type{border-top:none}
  #sentinelPanel .sp-msg.wt-deauth{border-left-color:#4da3ff}
  #sentinelPanel .sp-msg.wt-karma{border-left-color:#c084fc}
  #sentinelPanel .sp-msg.wt-rogue{border-left-color:#f59e0b}
  #sentinelPanel .sp-msg.alert{color:#f87171}
  #sentinelPanel .sp-why{color:var(--muted);font-size:11px}
  #sentinelPanel .sp-empty{color:var(--muted)}
  /* Sentinel tab: summary tiles + one combined table, all watch types as
     rows (TYPE column) -- .scroll lets it fit narrow screens via horizontal
     scroll, same convention as the Authorisations/Handshakes tables. */
  #sentinelViewMsgs{display:flex;flex-direction:column;gap:14px;padding:12px}
  .sv-sum{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}
  .sv-tile{background:var(--surface);border:1px solid var(--line);border-radius:12px;
           padding:10px 12px;display:flex;flex-direction:column;gap:2px;min-width:0}
  .sv-tile .sv-v{font-size:20px;font-weight:700;line-height:1.2}
  .sv-tile .sv-l{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .sv-tile.alert{border-color:#f87171;color:#f87171}
  .sv-tile.ok .sv-v{color:#4ade80}
  /* Configured-watch status bar -- one pill per armed watch, live status text.
     Replaces the old placeholder Clear/Waiting/Quiet table rows. */
  .sv-watchbar{display:flex;flex-wrap:wrap;gap:8px}
  .sv-watch{display:flex;align-items:center;gap:7px;background:var(--surface);
            border:1px solid var(--line);border-radius:999px;padding:6px 12px 6px 10px;
            font-size:12px;min-width:0}
  .sv-wdot{width:8px;height:8px;border-radius:50%;background:currentColor;flex:none}
  .sv-watch.wt-deauth{color:#4da3ff}
  .sv-watch.wt-karma{color:#c084fc}
  .sv-watch.wt-rogue{color:#f59e0b}
  .sv-wlabel{font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:10px;
             color:inherit;flex:none}
  .sv-wstat{color:var(--fg);overflow-wrap:anywhere}
  .sv-watch.alert{border-color:#f87171;box-shadow:0 0 0 1px #f87171}
  .sv-watch.alert .sv-wdot{color:#f87171;box-shadow:0 0 6px #f87171;animation:navpulse 1.1s ease-in-out infinite}
  .sv-watch.alert .sv-wstat{color:#f87171}
  .sv-table td,.sv-table th{padding:7px 10px}
  .sv-table tr.wt-deauth td:first-child{border-left:3px solid #4da3ff}
  .sv-table tr.wt-karma td:first-child{border-left:3px solid #c084fc}
  .sv-table tr.wt-rogue td:first-child{border-left:3px solid #f59e0b}
  .sv-table tr.hot td{background:rgba(248,113,113,.08)}
  .sv-table tr.hot:hover td{background:rgba(248,113,113,.14)}
  .sv-tchip{font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;
            padding:2px 7px;border-radius:5px;white-space:nowrap}
  .sv-tchip.wt-deauth{color:#4da3ff;background:rgba(77,163,255,.12)}
  .sv-tchip.wt-karma{color:#c084fc;background:rgba(192,132,252,.12)}
  .sv-tchip.wt-rogue{color:#f59e0b;background:rgba(245,158,11,.12)}
  .sv-tdetail{overflow-wrap:anywhere;white-space:normal;min-width:180px}
  .sv-tnum{font-variant-numeric:tabular-nums;color:var(--muted)}
  .sv-tflags{white-space:normal}
  .sv-tflags .sv-chip,.sv-tact .icobtn{margin-right:4px}
  .sv-chip{font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;
           padding:2px 8px;border-radius:999px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
  .sv-chip.bad{border-color:#f87171;color:#f87171;background:rgba(248,113,113,.12)}
  .sv-chip.good{border-color:#256b38;color:#4ade80;background:rgba(74,222,128,.1)}
  .sv-empty{color:var(--muted);padding:18px;text-align:center;background:var(--surface);
            border:1px solid var(--line);border-radius:12px}
  @media(max-width:560px){
    #sentinelViewMsgs{padding:10px;gap:10px}
    .sv-sum{grid-template-columns:repeat(3,1fr);gap:8px}
    .sv-tile{padding:8px 10px}.sv-tile .sv-v{font-size:17px}
    .sv-table td,.sv-table th{padding:6px 8px;font-size:12px}
    .sv-tact{display:flex;flex-direction:column;gap:4px}
    .sv-tact .icobtn{min-height:32px;margin-right:0}
  }
  .sethint{margin-top:10px;font-size:11px;line-height:1.6;color:var(--muted)}
  .sethint a{color:var(--accent);text-decoration:none;border-bottom:1px dotted color-mix(in srgb,var(--accent) 50%,transparent)}
  .sethint a:hover{border-bottom-style:solid}
  .netcard{background:var(--surface);border:1px solid var(--line);border-radius:10px;
           padding:14px 16px;margin-bottom:12px}
  .netcard:last-child{margin-bottom:0}
  .netcard-hd{font-size:10px;letter-spacing:.1em;text-transform:uppercase;
              color:var(--accent);font-weight:700;margin-bottom:12px;
              padding-bottom:10px;border-bottom:1px solid var(--line)}
  .setrow+.setrow.netdiv{margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
  /* Local AP tab: portal-HTML textarea + captured-submissions table use the
     full pane width (and, on the enlarged desktop modal, most of its height)
     instead of being squeezed into the k/v row layout every other setting uses. */
  .setrow.localap-html{flex-direction:column;align-items:stretch;gap:6px}
  .setrow.localap-html .v{margin-left:0;width:100%;display:block}
  #localApPortalHtml{width:100%;height:min(42vh,520px);min-height:160px;resize:vertical;box-sizing:border-box}
  @media(min-width:720px) and (min-height:500px){ #view-localap #localApPortalHtml{height:min(50vh,640px)} }
  #localApFieldList table{font-size:12px}
  #localApFieldList td,#localApFieldList th{
    white-space:nowrap;max-width:260px;overflow:hidden;text-overflow:ellipsis}
  /* Send Frame modal (#sendFrameModal, WITH_SECURITYTOOLS only). */
  #sfBody select,#sfBody input[type=text]{max-width:170px}
  #sfStatus{margin-top:8px}
  /* Local AP wizard: Network / Captive Portal / Launch (+ Captured once any
     submissions exist), styled as a stack of index cards -- each tab a small
     card with a folded top-left corner; the active card sits flush against
     the pane below it, the rest recede (smaller, dimmer, pushed back). */
  .localaptabs{display:flex;flex-wrap:wrap;align-items:flex-end;gap:0;margin-bottom:0;
             position:relative;z-index:1}
  .localaptab{position:relative;flex:0 1 auto;background:#0a0e18;border:1px solid var(--line);
            border-bottom:none;color:var(--muted);padding:8px 14px 7px;
            border-radius:8px 8px 0 0;font-size:11px;font-weight:700;
            letter-spacing:.03em;cursor:pointer;text-transform:uppercase;white-space:nowrap;
            margin-right:-1px;transform:translateY(3px) scale(.97);transform-origin:bottom;
            box-shadow:0 1px 0 #0006;transition:transform .12s ease,background .12s ease,color .12s ease;
            z-index:1}
  .localaptab:hover{color:var(--fg)}
  .localaptab.on{color:var(--accent);border-color:var(--accent);background:var(--panel);
            transform:translateY(0) scale(1);box-shadow:0 -2px 6px #0007;z-index:3}
  .localaptab.on::before{border-color:var(--accent)}
  .localaptab .badge{color:var(--muted);font-weight:400;margin-left:3px}
  .localaptab.on .badge{color:var(--accent)}
  /* Local AP is a genuine tab switcher, at every screen size: one pane
     visible at a time (Setup / Captive Portal / Captured / Connections),
     full-width -- Setup reads like a search bar (SSID + security side by
     side, Duration + Customise sharing the row below) instead of a narrow
     stack of label/value lines, so the pane earns the width it's given. */
  #localApSetupWrap .localapsub-pane,#framesTabWrap .localapsub-pane{background:var(--panel);border:1px solid var(--line);
            border-left:3px solid var(--accent);border-radius:0 6px 6px 6px;
            padding:22px 24px 20px;position:relative}
  #localApSetupWrap .localapsub-pane[data-rtab="portal"]{border-left-color:var(--muted)}
  #localApSetupWrap .localapsub-pane[data-rtab="captured"]{border-left-color:var(--warn,#e8b13a)}
  #localApSetupWrap .localapsub-pane[data-rtab="connections"]{border-left-color:var(--rnd)}
  #framesTabWrap .localapsub-pane[data-rtab="craft"]{border-left-color:var(--muted);padding:16px 18px 4px;
            display:flex;flex-direction:column;overflow:hidden}
  /* Capture pane keeps the Frames dump's own layout (filters bar + flexed
     scrolling feed) rather than the index-card padding above. */
  #framesTabWrap .localapsub-pane[data-rtab="capture"]{padding:14px 16px;display:flex;
            flex-direction:column;overflow:hidden}
  #framesTabWrap .localapsub-pane[data-rtab="capture"]>.scoutfeed{flex:1 1 auto;min-height:0;max-height:100%;overflow:auto}
  /* SSID input + security switch share one bar, like a search field with a
     filter chip glued to its right edge -- the two things set first, side
     by side, instead of each getting a stacked row to itself. */
  .lap-bar{display:flex;align-items:center;gap:10px;background:var(--surface);
          border:1px solid var(--line);border-radius:10px;padding:5px 6px 5px 14px}
  .lap-bar-ic{flex:none;color:var(--muted)}
  .lap-bar input[type="text"]{flex:1;min-width:0;background:transparent;border:none;
          outline:none;color:var(--fg);font-size:14px;padding:9px 4px}
  .lap-bar input[type="text"]::placeholder{color:var(--muted)}
  .lap-bar .lap-seg{flex:none}
  .lap-pass-row{margin-top:14px}
  .lap-pass-row .v{flex:1}
  .lap-pass-row input[type="text"]{width:100%}
  /* Duration + the portal-customise switch: the two remaining settings share
     one row instead of each claiming a full-width line of their own. */
  .lap-row2{display:flex;flex-wrap:wrap;align-items:center;gap:28px;margin-top:16px}
  .lap-duration{flex:1 1 260px;min-width:220px}
  .lap-duration .v{flex:1;margin-left:0}
  .lap-duration input[type="range"]{flex:1;min-width:0}
  .lap-toggle-row{flex:none}
  /* Tab present but visually inert until there's something to show -- always
     reachable (still shows its own empty state), just doesn't compete for
     attention until it has real content. */
  .localaptab.lap-tab-empty{opacity:.5}
  .localaptab.lap-tab-empty.on{opacity:.85}
  /* In-pane header: a real element so it can carry an icon, not just text --
     the tab bar above already names the pane, so this repeats it as a
     visual anchor at the top of the card (same pattern as a settings page's
     own section heading). Setup/Portal reuse the app's existing
     legend-swatch dot (.dot, same one the radar legend and status pills
     already use) as a plain colour tag; Captured/Connections get the
     pulsing variant since they're a live result, not a static category. */
  .lap-hd{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;
          letter-spacing:.03em;text-transform:uppercase;margin-bottom:16px;
          color:var(--accent)}
  .lap-hd .dot{width:9px;height:9px}
  .lap-ic.lap-dot{flex:none;width:20px;height:20px;border-radius:50%;position:relative}
  .lap-ic.lap-dot::before{content:'';position:absolute;inset:6px;border-radius:50%;background:currentColor}
  .lap-ic.lap-dot.live{animation:lapPulse 1.6s ease-in-out infinite}
  @keyframes lapPulse{0%,100%{box-shadow:0 0 0 0 currentColor}50%{box-shadow:0 0 0 4px transparent}}
  [data-rtab="portal"] .lap-hd{color:var(--muted)}
  [data-rtab="captured"] .lap-hd{color:var(--warn,#e8b13a)}
  [data-rtab="connections"] .lap-hd{color:var(--rnd)}
  /* Security on/off segmented switch: a little sliding bezel behind
     whichever option is selected, rather than plain radio buttons. */
  .lap-seg{position:relative;display:inline-flex;background:var(--surface);
          border:1px solid var(--line);border-radius:8px;padding:2px;gap:2px}
  .lap-seg-opt{position:relative;z-index:1;border:none;background:transparent;
          padding:5px 14px;font-size:12px;font-weight:600;color:var(--muted);
          border-radius:6px;cursor:pointer;transition:color .15s ease}
  .lap-seg-opt.on{color:var(--fg)}
  .lap-seg-bezel{position:absolute;top:2px;bottom:2px;left:2px;width:calc(50% - 2px);
          background:var(--panel);border:1px solid var(--accent);border-radius:6px;
          box-shadow:0 1px 3px #0006,inset 0 1px 0 rgba(255,255,255,.08);
          transition:transform .18s cubic-bezier(.3,.7,.4,1);z-index:0;pointer-events:none}
  .lap-seg-opt[data-sec="wpa2"].on ~ .lap-seg-bezel{transform:translateX(100%)}
  /* Plain on/off switch (the portal-customise toggle): same sliding-bezel
     language as the security segment above, one knob instead of two labels. */
  .lap-toggle{position:relative;display:inline-block;width:38px;height:22px;
          flex:none;cursor:pointer}
  .lap-toggle input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
  .lap-toggle-bezel{position:absolute;inset:0;
          background:color-mix(in srgb,var(--muted) 22%,var(--surface));
          border:1px solid var(--muted);border-radius:11px;transition:background .15s ease}
  .lap-toggle-bezel::before{content:'';position:absolute;top:1px;left:1px;width:18px;height:18px;
          border-radius:50%;background:var(--muted);border:1px solid var(--muted);
          box-shadow:0 1px 3px #0006;transition:transform .18s cubic-bezier(.3,.7,.4,1)}
  .lap-toggle input:checked ~ .lap-toggle-bezel{background:var(--accent);border-color:var(--accent)}
  .lap-toggle input:checked ~ .lap-toggle-bezel::before{transform:translateX(16px);
          background:var(--onaccent,#fff);border-color:var(--accent)}
  /* Log-only row in the Capture popover: same sliding switch as above,
     plus a warning chip that only appears once the switch is actually on --
     the whole point is to make an otherwise-silent "results aren't landing
     in this table" mode impossible to miss. */
  .wdrow{display:flex;align-items:center;gap:9px;margin-bottom:11px;flex-wrap:wrap}
  .wdlabel{font-size:12px;font-weight:600;color:var(--fg)}
  .wdwarn{font-size:11px;color:#ffb020;background:color-mix(in srgb,#ffb020 14%,var(--surface));
          border:1px solid color-mix(in srgb,#ffb020 45%,var(--line));border-radius:6px;
          padding:3px 8px;white-space:nowrap}
  /* Single Play/Stop toggle glued to the end of the SSID bar (localApGoBtn)
     instead of a full-width Start button below + a separate Stop row --
     localApSyncActiveUi flips its class/icon/title in place. Only
     #localApConfigFields locks while running -- the toggle itself always
     stays clickable so Stop is reachable. */
  .lap-go-icon{flex:none;display:flex;align-items:center;justify-content:center;
          width:34px;height:34px;border-radius:50%;border:1px solid var(--pub);
          color:var(--pub);background:transparent;cursor:pointer;
          transition:background .15s,border-color .15s,color .15s}
  .lap-go-icon:hover{background:rgba(55,214,122,.12)}
  .lap-go-icon.on{border-color:#ff6b6b;color:#ff6b6b}
  .lap-go-icon.on:hover{background:rgba(255,107,107,.12)}
  .lap-go-icon:disabled{opacity:.5;cursor:default;pointer-events:none}
  #localApConfigFields{margin-bottom:20px}
  /* Locks the config fields (and the whole Portal editor pane) while a run
     is up, on every screen size -- editing them wouldn't do anything until
     the next Start anyway. */
  #view-localap.running #localApConfigFields{opacity:.45;pointer-events:none}
  #view-localap.running #localApPortalPane{opacity:.45;pointer-events:none}
  /* Frame Crafting -- reuses .lap-hd/.lap-bar/.lap-go-icon/.tgl/.authsum
     rather than inventing new chrome; only the chip-grid wrapping is new. */
  .fc-setsec{padding-bottom:28px}
  /* The frame-anatomy strip is this view's one bold element: a live, proportional map of the
     bytes buildRawFrame would actually assemble right now (fcRenderAnatomy in app.js), so the
     operator watches the wire layout change as they edit instead of trusting invisible header
     math. Segment widths are driven by inline flex-grow (set in JS, sized to each field's byte
     count) -- the CSS just supplies the frame it grows inside. */
  .fc-anatomy-wrap{max-width:640px}
  .fc-anatomy{display:flex;height:40px;border:1px solid var(--line);border-radius:8px;overflow:hidden;
       background:var(--surface)}
  .fc-anatomy-seg{display:flex;align-items:center;justify-content:center;font-size:10px;
       font-weight:700;letter-spacing:.02em;color:var(--muted);border-right:1px solid var(--line);
       white-space:nowrap;overflow:hidden;min-width:0;transition:flex-grow .18s ease}
  .fc-anatomy-seg:last-child{border-right:none}
  .fc-anatomy-seg.body{color:var(--accent);background:var(--onbg)}
  .fc-anatomy-meta{margin-top:7px;font-size:11px;color:var(--muted)}
  /* Section headings get a divider + generous top gap so Frame type/Addressing/Flags/etc read as
     distinct blocks rather than one long unbroken list -- the first heading (Frame type) skips it,
     it's already the top of the card. */
  .fc-setsec .lap-hd.fc-sec{margin-top:28px;padding-top:20px;border-top:1px solid var(--line)}
  .fc-chips{display:flex;flex-wrap:wrap;gap:8px}
  .fc-addr-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 16px;margin-top:2px}
  @media(max-width:640px){ .fc-addr-grid{grid-template-columns:1fr} }
  .fc-addr-field label{display:block;font-size:11px;color:var(--muted);margin-bottom:4px}
  .fc-addr-field input[type="text"],.fc-addr-field select{width:100%}
  .fc-addr-field .fc-cap{font-size:10px;color:var(--muted);margin-top:3px}
  #fcIeRows{max-width:640px}
  .fc-ie-row{padding:5px 0}
  .fc-ie-row .v{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-left:0}
  .fc-ie-row .k{min-width:80px}
  .fc-ie-row .k label{display:flex;align-items:center;gap:5px;font-weight:400}
  .fc-run-bar{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:2px;max-width:640px}
  .fc-run-bar .setrow{flex:1 1 160px;margin:0}
  .fc-run-bar .setrow .v{margin-left:0;justify-content:flex-start}
  /* The Settings modal's .setrow (label left, value flush right) reads as huge dead space once
     stretched across this view's much wider panel -- keep each row's label and control adjacent
     and cap its width instead of letting it span the full panel. */
  .fc-setsec>.setrow{max-width:480px;margin-top:12px}
  .fc-setsec>.setrow .v{margin-left:0;justify-content:flex-start}
  .fc-setsec>.setrow .k{min-width:150px}
  .fc-setsec #fcBodyRow{max-width:640px;flex-direction:column;align-items:stretch;gap:8px}
  .fc-setsec #fcBodyRow .v{width:100%;display:block;margin-left:0}
  #fcBody{min-height:64px;resize:vertical}
  /* Flags rendered as an actual Frame Control byte (octet 2), MSB-first like a datasheet register
     diagram, instead of a flat row of toggle chips -- the bit order/labels match RF_FLAG_LABELS in
     RawFrameBuilder.cpp exactly, and the live hex readout next to the heading is the real byte
     buildRawFrame will write. */
  .fc-byteval{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;font-weight:400;
       text-transform:none;letter-spacing:0;color:var(--muted);margin-left:2px}
  .fc-bits{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;width:fit-content}
  .fc-bit{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
       width:50px;padding:9px 0;border:none;border-right:1px solid var(--line);border-radius:0;
       background:var(--surface);color:var(--muted);font-size:11px;font-weight:700}
  .fc-bit:last-child{border-right:none}
  .fc-bit b{font-size:9px;font-weight:400;color:var(--muted);opacity:.65}
  .fc-bit.on{background:var(--onbg);color:var(--accent)}
  .fc-bit.on b{color:var(--accent);opacity:1}
  .fc-bit:hover{color:var(--fg)}
  /* Wire preview: a live hex+ASCII dump of the exact bytes buildRawFrame() would send, in the same
     dark terminal register the Scout Feed/Frame Dump viewers already use (--feed-* tokens) -- one
     visual vocabulary for "raw bytes off the air" everywhere in the dashboard, not a one-off style. */
  .fc-hexdump{max-width:640px;max-height:230px;overflow-y:auto;background:var(--feed-bg,#07100a);
       border:1px solid var(--feed-border,#1c2b20);border-radius:8px;padding:10px 14px;
       font:12px/1.7 ui-monospace,Menlo,Consolas,monospace}
  .fc-hexdump .hdrow{white-space:pre}
  .fc-hexdump .hdoff{color:var(--feed-age,#3f6b4e);margin-right:12px}
  .fc-hexdump .hdhex{color:var(--feed-fg,#8fb59b)}
  .fc-hexdump .hdasc{color:var(--feed-ssid,#4ade80);margin-left:16px}
  .fc-hexdump .hdempty{color:var(--muted);font-style:italic}
  /* full-screen capture countdown overlay */
  .capruns{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;
           align-items:center;justify-content:center;
           background:radial-gradient(circle at 50% 38%,var(--onbg),var(--surface2) 72%)}
  .capruns.on{display:flex}
  /* Send Frame's overlay must sit ABOVE .modal (z-index 80) -- unlike a
     capture (popover only), the Send Frame modal itself stays open behind it
     for the run's duration, so this is what actually makes its buttons
     unclickable rather than just visually covered. */
  #sfruns{z-index:90}
  /* Local AP's local-run overlay: the Local AP view stays open behind it
     for the run, so this is what actually blocks interaction. */
  #localapruns{z-index:90}
  .cr-ring{position:relative;width:190px;height:190px}
  .cr-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
  .cr-track{fill:none;stroke:var(--line);stroke-width:6}
  .cr-arc{fill:none;stroke:var(--accent);stroke-width:6;stroke-linecap:round;
          stroke-dasharray:326.7;stroke-dashoffset:0;
          transition:stroke-dashoffset .25s linear;
          filter:drop-shadow(0 0 6px var(--accent))}
  .cr-num{position:absolute;inset:0;display:flex;flex-direction:column;
          align-items:center;justify-content:center}
  .cr-num b{font-size:54px;color:var(--fg);line-height:1;font-variant-numeric:tabular-nums}
  .cr-num span{font-size:12px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;margin-top:4px}
  .cr-title{margin-top:28px;font-size:18px;letter-spacing:.5px;color:var(--accent);text-align:center}
  .cr-params{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;
             max-width:320px;margin-top:14px}
  .cr-tile{padding:4px 10px;border:1px solid var(--line);border-radius:6px;
           font-size:11px;letter-spacing:.4px;color:var(--muted);background:var(--panel)}
  .cr-tile.on{color:var(--accent);border-color:var(--accent)}
  .cr-sub{margin-top:12px;max-width:340px;text-align:center;color:var(--muted);
          font-size:12px;line-height:1.7;padding:0 16px}
  /* #aplost-only close button -- lets you dismiss the AP-lost overlay to see
     cached results while still off the AP, without waiting to rejoin. The
     capture/send-frame/local-AP run overlays (#capruns etc) have no such
     button: those block for a real reason (the radio is genuinely busy), so
     there is nothing useful to see behind them. */
  .cr-close{position:absolute;top:18px;right:18px;width:32px;height:32px;
             border-radius:50%;border:1px solid var(--line);background:var(--panel);
             color:var(--muted);font-size:18px;line-height:1;cursor:pointer;
             display:flex;align-items:center;justify-content:center}
  .cr-close:hover{color:var(--fg);border-color:var(--accent)}
  /* Reconnect QR -- shown in the capture overlay (AP is about to drop) and,
     on demand, in Settings > Network. Plain <img> of the server-rendered SVG
     (see /api/network/apqr); white padding keeps the quiet zone even in the
     dark theme, since most phone camera QR readers need real contrast. */
  .cr-qr-wrap{margin-top:16px;display:flex;flex-direction:column;align-items:center;gap:8px}
  .cr-qr{width:132px;height:132px;background:#fff;border-radius:8px;padding:8px;
         box-shadow:0 8px 24px #0008;display:block}
  .cr-qr-hint{font-size:11px;color:var(--muted);letter-spacing:.02em}
  .apqrbox{margin-top:10px;display:flex;flex-direction:column;align-items:flex-start;gap:8px}
  .apqrbox img{width:150px;height:150px;background:#fff;border-radius:8px;padding:8px;display:block}
  /* Blur-by-shoulder-surfer-default -- a QR embeds the live WPA2 password in
     the clear, so a passerby who can see the screen can already read it if
     it's rendered sharp. Starts blurred; a tap/click (frame's onclick) or the
     keyboard-accessible reveal button un-blurs it. Shared by every QR
     display site (capture-finish overlay, #aplost, Settings > Network). */
  .qr-frame{position:relative;display:inline-block;cursor:pointer;border:none;padding:0;background:none}
  .qr-frame img{filter:blur(16px);transition:filter .2s}
  .qr-frame.revealed img{filter:none}
  .qr-reveal{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
             text-align:center;padding:6px;font-size:11px;line-height:1.4;color:#fff;
             background:#000a;border-radius:8px;pointer-events:none}
  .qr-frame.revealed .qr-reveal{display:none}
  /* Desktop has no camera -- a plain copy-to-clipboard is the equivalent
     escape hatch for the same live password the QR carries (see
     /api/network/appass). */
  .cr-copy-btn{font-size:11px;padding:5px 12px;border-radius:6px;border:1px solid var(--line);
               background:var(--panel);color:var(--fg);cursor:pointer;letter-spacing:.02em}
  .cr-copy-btn:hover{border-color:var(--accent);color:var(--accent)}
  /* ---- tab bar ---- */
  .tabs{display:flex;gap:4px;padding:10px 12px 0}
  .tab{background:var(--panel);border:1px solid var(--line);border-bottom:none;
       border-radius:8px 8px 0 0;padding:7px 14px;color:var(--muted);font-size:13px;
       display:flex;gap:6px;align-items:center}
  .tab span{color:var(--accent);font-weight:600}
  .tab.on{color:var(--fg);border-color:var(--accent);background:var(--hl)}
  /* overflow menu (mobile): extra WiFi views behind a >> button */
  .tabmore-wrap{position:relative;display:flex;margin-left:auto}
  .tabmore{background:var(--panel);border:1px solid var(--line);border-bottom:none;
       border-radius:8px 8px 0 0;padding:7px 14px;color:var(--muted);font-size:14px;
       font-weight:700;cursor:pointer;line-height:1}
  .tabmore.on{color:var(--fg);border-color:var(--accent);background:var(--hl)}
  .tabmenu{display:none;position:absolute;top:100%;right:0;z-index:30;margin-top:3px;
       background:var(--panel);border:1px solid var(--accent);border-radius:8px;
       min-width:150px;overflow:hidden;box-shadow:0 8px 24px #0009}
  .tabmenu.open{display:flex;flex-direction:column}
  .tabmenu .tab{border:none;border-bottom:1px solid var(--line);border-radius:0;
       width:100%;justify-content:flex-start}
  .tabmenu .tab:last-child{border-bottom:none}
  /* ---- desktop sidebar nav (hidden on mobile; tabs used there) ---- */
  /* #navBurger + #sidenav share one card (#sidenavCard): a single bordered/rounded
     panel with the burger as its own row up top (divider below it), then the view
     list -- reads as one joined shape since they're literally the same box. */
  /* align-self:flex-start opts out of main's align-items:stretch -- without it the card's
     height gets forced to match the (much taller) active view panel, which is why the
     card looked like it filled the whole page and why collapsing it (hiding #sidenav)
     didn't visibly shrink anything: its height was never driven by its own content. */
  /* plain static flow (no position:sticky/top) -- main never scrolls (page is locked to the
     viewport), so sticky bought nothing here except an extra "top" offset that could throw
     off its alignment with the view panel beside it; align-self:flex-start alone is enough
     to top-anchor it at the same cross-start edge as the panel. */
  #sidenavCard{display:none;flex-direction:column;width:172px;flex:none;align-self:flex-start;
           background:var(--panel);border:1px solid var(--line);
           border-radius:10px;box-shadow:var(--sidenav-shadow,none);overflow:hidden}
  #navBurger{border:none;border-bottom:1px solid var(--line);border-radius:0;
           background:transparent;color:var(--muted);padding:11px 14px;
           display:flex;align-items:center;justify-content:flex-start;
           transition:color .15s ease,background .15s ease}
  #navBurger:hover{color:var(--accent);background:var(--onbg-hover,var(--hl))}
  #sidenav{display:flex;flex-direction:column;gap:1px;padding:8px}
  /* active item reads as a left accent bar + tinted fill (same accent language as the
     content tables' row markers) rather than a boxed chip -- quieter, still unambiguous */
  #sidenav button{text-align:left;padding:8px 10px 8px 9px;color:var(--muted);font-size:13px;
           border:none;border-left:3px solid transparent;border-radius:6px;background:transparent;
           display:flex;justify-content:space-between;gap:8px;align-items:center;
           transition:background .15s ease,color .15s ease,border-color .15s ease}
  #sidenav button:hover{color:var(--fg);background:var(--onbg-hover,var(--hl))}
  #sidenav button.on{color:var(--fg);border-left-color:var(--accent);background:var(--hl);
           font-weight:600}
  #sidenav button.on:hover{background:var(--hl)}
  #sidenav button b{color:var(--accent);font-weight:600}
  #sidenav .navl{display:flex;align-items:center;gap:9px;min-width:0}
  #sidenav .navic{flex:none;opacity:.75;transition:opacity .15s ease}
  #sidenav button:hover .navic{opacity:1}
  #sidenav button.on .navic{opacity:1;color:var(--accent)}
  #sidenav .navt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  /* collapsed: icon-only rail, flush against the viewport's left edge (cancels main's own
     left padding via negative margin) -- labels/badges hidden, icons + click targets stay */
  #sidenavCard.collapsed{width:52px;margin-left:-12px;border-left:none;border-radius:0 10px 10px 0}
  #sidenavCard.collapsed #navBurger{justify-content:center;padding:10px}
  #sidenavCard.collapsed #sidenav button{justify-content:center;padding:10px}
  #sidenavCard.collapsed .navt,#sidenavCard.collapsed button b,#sidenavCard.collapsed .navdot{display:none}
  /* ---- layout ---- */
  main{padding:0 12px 14px;display:grid;grid-template-columns:minmax(0,1fr);gap:14px}
  .view{display:none;background:var(--panel);border:1px solid var(--line);
        border-radius:0 10px 10px 10px;overflow:hidden}
  .view.active{display:flex;flex-direction:column}
  .vh{margin:0;padding:9px 12px;font-size:13px;letter-spacing:.5px;
      background:var(--vh-bg,var(--hl));border-bottom:1px solid var(--line);
      display:flex;justify-content:space-between}
  .vh .c{color:var(--accent)}
  .vh>span:first-child{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .cbtn{background:var(--surface);border:1px solid var(--line);border-radius:6px;
        color:var(--muted);cursor:pointer;padding:2px 9px;font-size:13px;line-height:1}
  .cbtn:hover{color:var(--accent);border-color:var(--accent)}
  .view.collapsed .scroll,.view.collapsed #dfbar,.view.collapsed .cards{display:none!important}
  .scroll{overflow-x:auto}
  /* ---- device card view (Table/Cards toggle) ---- */
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
         gap:8px;padding:10px;overflow:auto;align-content:start}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:8px;
        padding:8px 10px;display:flex;flex-direction:column;gap:5px;font-size:12px;min-width:0}
  #dcards .card[data-mac]{cursor:pointer}
  .card .ch{display:flex;justify-content:space-between;align-items:baseline;gap:6px}
  .card .cm{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .card .crssi{font-size:20px;font-weight:700;color:var(--fg);font-variant-numeric:tabular-nums}
  .card .crssi small{font-size:11px;font-weight:400;color:var(--muted)}
  .card .cname{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .card .cbadges{display:flex;flex-wrap:wrap;gap:4px}
  .card .cg{display:grid;grid-template-columns:auto 1fr;gap:2px 8px;align-items:baseline}
  .card .cg span{color:var(--muted)}
  .card .cg b{color:var(--fg);font-weight:600;font-variant-numeric:tabular-nums;
              overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .card.cli{background:rgba(122,162,247,.06);border-style:dashed;border-color:rgba(122,162,247,.35)}
  .card .expBtn{align-self:flex-start}
  table{width:100%;border-collapse:collapse;white-space:nowrap}
  th,td{padding:6px 10px;text-align:left;border-bottom:1px solid var(--line)}
  th{color:var(--muted);font-weight:600;cursor:pointer;user-select:none;
     position:sticky;top:0;background:var(--th-bg,var(--panel));z-index:1}
  tr:hover td{background:var(--hl)}
  #dt tbody tr[data-mac]{cursor:pointer}
  #dt tbody tr[data-mac] td{user-select:none}
  td.mac,td.hex{font-variant-ligatures:none}
  .tag{font-size:11px;padding:1px 6px;border-radius:4px;border:1px solid}
  .PUB,.PID{color:var(--pub);border-color:var(--pub)}
  .RND,.RID{color:var(--rnd);border-color:var(--rnd)}
  .coord{color:var(--muted);border-color:var(--line)}
  .maplink{color:var(--muted);display:inline-flex;align-items:center;opacity:.75}
  .maplink:hover{color:var(--accent);opacity:1}
  .wbcn{color:#c78cff;border-color:#c78cff}
  .wprb{color:var(--accent);border-color:var(--accent)}
  .wcli{color:var(--pub);border-color:var(--pub);margin-left:6px;cursor:pointer}
  .wdea{color:#ff6b6b;border-color:#ff6b6b}   /* deauth/disassoc -- danger red, matches #det's own flood-row red */
  .hotspot{color:#ff8a3d;border-color:#ff8a3d}
  .newmac{color:#4dff9e;border-color:#4dff9e;font-weight:600}
  /* ---- capture-duration modal (WiFi) ---- */
  .caprow{display:flex;gap:10px;align-items:center;padding:8px 16px 4px}
  .caprow input[type=range]{flex:1}
  .caprow b{color:var(--accent);font-size:16px;min-width:64px;text-align:right}
  .cappre{display:flex;gap:6px;padding:4px 16px 8px;flex-wrap:wrap}
  .cappre button{flex:1;background:var(--surface);border:1px solid var(--line);color:var(--muted);
                 border-radius:6px;padding:6px 0;font-size:12px}
  .cappre button:hover{color:var(--accent);border-color:var(--accent)}
  .caphint{padding:2px 16px 8px;font-size:11px;line-height:1.4}
  /* ---- WiFi security badges (basic sec/hidden classification, every build) ---- */
  .seco{color:var(--sec-open,#ffcf6b);border-color:var(--sec-open,#ffcf6b)}      /* OPEN (unencrypted) */
  .secw{color:var(--sec-weak,#ff9b6b);border-color:var(--sec-weak,#ff9b6b)}      /* WEP / WPA1 (legacy) */
  .sec2{color:var(--sec-wpa2,#7cffb2);border-color:var(--sec-wpa2,#7cffb2)}      /* WPA2 / OWE */
  .sec2e{color:var(--sec-wpa2e,#4da3ff);border-color:var(--sec-wpa2e,#4da3ff)}   /* WPA2-Enterprise */
  .sec3{color:var(--sec-wpa3,#9d7cff);border-color:var(--sec-wpa3,#9d7cff)}      /* WPA3 */
  .sec3e{color:var(--sec-wpa3e,#c78cff);border-color:var(--sec-wpa3e,#c78cff)}   /* WPA3-Enterprise */
  .secmix{color:var(--sec-mix,#35c2b0);border-color:var(--sec-mix,#35c2b0)}     /* WPA2/WPA3 transition mode: downgrade-able, not full WPA3 */
  .secu{color:var(--muted);border-color:var(--muted)}  /* unknown */
  .secweak{text-decoration:underline dotted;font-weight:600}
  .hidn{color:var(--warn,#e8b13a);font-weight:600;font-style:italic}
  .unprint{color:var(--warn,#e8b13a);font-style:italic;cursor:help;border-bottom:1px dotted var(--warn,#e8b13a)}
  .hexdump{font-family:monospace;font-size:11px;word-break:break-all;color:var(--muted)}
  .dfbar{display:flex;align-items:center;gap:10px;padding:6px 12px;font-size:12px;
         color:var(--accent);background:var(--onbg);border-bottom:1px solid var(--accent)}
  .dfbar button{padding:2px 8px;font-size:12px}
  /* devices search popunder: revealed under the header by the magnifier button */
  .dsearch{display:flex;align-items:center;gap:8px;padding:7px 12px;
           background:var(--surface);border-bottom:1px solid var(--line);color:var(--muted)}
  .dsearch input{flex:1;min-width:0;background:var(--surface2);border:1px solid var(--line);
           border-radius:6px;color:var(--fg);font-size:16px;padding:5px 9px;font-family:inherit}
  .dsearch input:focus{outline:none;border-color:var(--accent)}
  .dsearch button{background:none;border:none;color:var(--muted);font-size:18px;
           line-height:1;cursor:pointer;padding:0 4px}
  .dsearch button:hover{color:var(--fg)}
  #devSearchBtn.on{color:var(--accent);border-color:var(--accent)}
  /* WiFi kind-filter popunder: BEACON/STA/PROBE chips, revealed by the funnel button */
  .wfilter{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:7px 12px;
           background:var(--surface);border-bottom:1px solid var(--line)}
  #wifiFilterBtn.on{color:var(--accent);border-color:var(--accent)}
  .wfilter-sep{width:1px;align-self:stretch;background:var(--line)}
  .muted{color:var(--muted)}
  .rssi{font-weight:600}
  .hex{color:var(--fg);max-width:520px;line-height:1.5}
  .adk{display:inline-block;min-width:96px;color:var(--muted);font-size:11px}
  .flash{animation:fl 1s ease-out}@keyframes fl{from{background:#1c3a2a}to{background:transparent}}
  #dt tbody tr.krow,#dcards .card.krow{outline:2px solid var(--accent);outline-offset:-2px}
  /* ---- radar ---- */
  #radarWrap{padding:10px 12px;position:relative;flex:1;
             min-height:min(58vh,440px);display:flex}
  #radar{width:100%;height:100%;display:block;
         background:
           repeating-linear-gradient(0deg,rgba(255,255,255,.02) 0px,rgba(255,255,255,.02) 1px,transparent 1px,transparent 4px),
           radial-gradient(circle at 50% 45%,var(--onbg),var(--surface2) 72%);
         background-size:100% 4px,100% 100%;
         border-radius:8px;cursor:crosshair;touch-action:none}
  #rctl{position:absolute;top:16px;right:18px;z-index:5;display:flex;gap:4px;
        align-items:center;background:var(--surface-a1);border:1px solid var(--line);
        border-radius:8px;padding:3px 5px}
  #rctl button{width:26px;height:26px;padding:0;font-size:15px;line-height:1;
        border-radius:6px;color:var(--muted)}
  #rctl button:hover{color:var(--accent)}
  #rctl button.on{color:var(--accent);border:1px solid var(--accent)}
  #rctl #zlvl{color:var(--accent);font-size:12px;min-width:38px;text-align:center}
  /* radar fullscreen: view-map fills the viewport, header + sidenav hidden.
     rband (slider) + vh (top menu) live inside #view-map already, so they
     come along for free -- only chrome outside the view needs hiding. */
  body.radar-fs header,body.radar-fs #sidenavCard{display:none}
  body.radar-fs main{padding:0}
  body.radar-fs .view.active{position:fixed;inset:0;z-index:50;border-radius:0;border:none}
  /* ring-colour legend popover, anchored under #rctl (toggleRingLegend) */
  #ringLegend{position:absolute;top:52px;right:18px;z-index:6;width:230px;
        background:var(--surface-a2);border:1px solid var(--line);border-radius:8px;
        padding:8px 10px;box-shadow:0 6px 20px #000a;font-size:11px;color:var(--muted)}
  #ringLegend.hidden{display:none}
  #ringLegend .rlhd{display:flex;justify-content:space-between;align-items:center;
        color:var(--accent);font-size:10px;letter-spacing:.06em;margin-bottom:6px}
  #ringLegend .rlhd button{width:18px;height:18px;padding:0;font-size:13px;line-height:1;
        color:var(--muted);border-radius:5px;cursor:pointer}
  #ringLegend .rlhd button:hover{color:var(--accent)}
  #ringLegend .rlrow{display:flex;align-items:center;gap:8px;padding:3px 0}
  #ringLegend .rlring{flex:none;width:13px;height:13px;border-radius:50%;box-sizing:border-box;
        border:1.5px solid;background:transparent}
  #ringLegend .rlstar{flex:none;width:13px;text-align:center;font-size:13px;line-height:1}
  #ringLegend .rlring3{display:inline-flex;width:auto;border:none;gap:1px}
  #ringLegend .rlring3 b{width:9px;height:13px;border-radius:0;border:1.5px solid;
        border-left:none;box-sizing:border-box}
  #ringLegend .rlring3 b:first-child{border-left:1.5px solid;border-radius:7px 0 0 7px}
  #ringLegend .rlring3 b:last-child{border-radius:0 7px 7px 0}
  #rkey{color:var(--muted);font-size:11px;padding:8px 12px 2px;
        display:flex;gap:16px;align-items:center;justify-content:center}
  #rkey span[data-rk]{cursor:pointer;user-select:none}
  #rkey span[data-rk]:hover{color:var(--fg)}
  #rkey span.off{opacity:.35;text-decoration:line-through}
  #rkey .dot.ghostdot{background:transparent!important;border:1.5px dashed var(--whid);opacity:.75}
  #rband{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);z-index:6;
         display:flex;gap:8px;align-items:center;color:var(--muted);font-size:12px;
         background:var(--surface-a1);border:1px solid var(--line);border-radius:8px;padding:5px 12px}
  #rband input[type=range]{width:140px}
  #rband b{color:var(--accent);min-width:20px;text-align:right}
  #bandModes{display:flex;gap:2px;margin-right:2px}
  #bandModes button{width:30px;height:20px;padding:0;font-size:10px;font-weight:600;
    background:transparent;border:1px solid var(--line);color:var(--muted);
    border-radius:4px;cursor:pointer;letter-spacing:.3px}
  #bandModes button.on{color:var(--accent);border-color:var(--accent)}
  #bandModes button:hover{color:var(--accent)}
  #bandModeBtn{display:none}                     /* mobile-only trigger, see max-width:560px */
  /* absorbed-probes log: docked panel, off by default (toggleAbsorbLog) */
  #alog{position:absolute;left:12px;bottom:14px;z-index:6;width:260px;height:200px;
        min-width:200px;min-height:120px;max-width:calc(100% - 4px);max-height:calc(100% - 4px);
        resize:both;overflow:hidden;
        display:flex;flex-direction:column;background:var(--surface-a2);border:1px solid var(--line);
        border-radius:8px;box-shadow:0 6px 20px #000a}
  #alog.hidden{display:none}
  #alog.maxed{resize:none}                        /* full-fill state: dragging the corner makes no sense */
  #alog.dragging{cursor:grabbing;user-select:none}
  #alog .alhd{display:flex;justify-content:space-between;align-items:center;gap:8px;
        padding:6px 10px;border-bottom:1px solid var(--line);color:var(--accent);
        font-size:11px;letter-spacing:.05em;flex:none;cursor:grab}
  #alog.dragging .alhd,#alog.maxed .alhd{cursor:default}
  #alog .alhdBtns{display:flex;gap:4px}
  #alog .alhd button{width:20px;height:20px;padding:0;font-size:14px;line-height:1;
        color:var(--muted);border-radius:5px;cursor:pointer}
  #alog .alhd button:hover{color:var(--accent)}
  #alist{flex:1;overflow-y:auto;padding:4px 10px;font-size:11px;color:var(--muted);line-height:1.6}
  #alist .ale{padding:3px 0;border-bottom:1px dashed var(--line)}
  #alist .ale:last-child{border-bottom:none}
  #alist .ale .alt{color:var(--muted);float:right;font-size:10px;margin-left:6px}
  /* radar controls modal: overlays the radar, shown on load, zoom locked while up */
  #rmodal{position:absolute;inset:10px 12px;z-index:20;display:flex;
          align-items:center;justify-content:center;background:var(--scrim);
          border-radius:8px;backdrop-filter:blur(2px)}
  #rmodal.hidden{display:none}
  #rmodal .rmbox{background:var(--surface);border:1px solid var(--line);border-radius:10px;
          max-width:min(94%,720px);max-height:94%;overflow:auto;box-shadow:0 10px 40px #000a}
  .rmhd{display:flex;justify-content:space-between;align-items:center;
        padding:8px 12px;border-bottom:1px solid var(--line);color:var(--accent);
        font-size:12px;letter-spacing:.05em;position:sticky;top:0;background:var(--surface)}
  .rmhd button{width:26px;height:26px;padding:0;font-size:18px;line-height:1;
        color:var(--muted);border-radius:6px}
  .rmhd button:hover{color:var(--accent)}
  .rmsec{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--accent);
         padding:14px 14px 3px;border-top:1px solid var(--line);margin-top:8px}
  .rmsec.first{border-top:none;margin-top:0}
  .rlegend{display:flex;gap:18px;align-items:center;padding:10px 14px 14px;
           color:var(--muted);font-size:12px;flex-wrap:wrap}
  .rlegend input{width:60px}
  .rlegend input[type=range]{width:96px}
  .tgl{cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--muted);
       border-radius:6px;padding:4px 11px;font-size:12px;letter-spacing:.02em}
  .tgl:hover{color:var(--fg);border-color:var(--muted)}
  .tgl.on{color:var(--accent);border-color:var(--accent);background:var(--onbg)}
  .icobtn{display:inline-flex;align-items:center;justify-content:center;padding:4px 10px;gap:5px;white-space:nowrap}
  .icobtn svg{display:block}
  .icobtn.confirm{color:#f66;border-color:#f66}
  .dot{display:inline-block;width:9px;height:9px;border-radius:50%;vertical-align:middle}
  .refbtn{cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--muted);
          border-radius:4px;padding:0 6px;font-size:13px}
  .refbtn.on{color:var(--accent);border-color:var(--accent)}
  .scoutTgtBtn{cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--muted);
          border-radius:6px;padding:5px 11px;font-size:12px;
          display:inline-flex;align-items:center;gap:6px;transition:color .12s,border-color .12s,background .12s}
  .scoutTgtBtn:hover{color:var(--fg);border-color:#2a3550}
  .scoutTgtBtn.on{color:var(--accent);border-color:var(--accent)}
  .scoutTgtBtn[data-busy]{opacity:.6;cursor:default}
  #refinfo b{color:var(--accent)}
  /* MAC-card Actions dropdown -- collapses what used to be a whole row of
     buttons (target/scout-scan/local-capture/send-frame, several always
     visible whether relevant or not) into one menu, so the card body doesn't
     read as a wall of buttons. */
  .actmenu-wrap{position:relative;display:inline-block}
  .actmenu-btn .car{font-size:9px;opacity:.8;transition:transform .15s}
  .actmenu-btn.on .car{transform:rotate(180deg)}
  /* position:fixed (not absolute) + JS-computed left/top (see toggleMacActions)
     -- .modal-card clips overflow to its own auto-height, and an absolutely
     positioned dropdown doesn't contribute to that height (it's out of flow),
     so on a short mobile viewport the menu got clipped/hidden behind the card
     instead of floating on top of it. Fixed positioning escapes that clip
     entirely and is clamped to the viewport, flipping upward if there's no
     room below the button. */
  .actmenu{position:fixed;z-index:90;display:none;
           min-width:230px;background:var(--panel);border:1px solid var(--accent);
           border-radius:10px;padding:6px;box-shadow:0 12px 34px #000b;
           flex-direction:column;gap:2px}
  .actmenu.on{display:flex}
  .actmenu-item{cursor:pointer;border:1px solid transparent;background:none;
           color:var(--fg);border-radius:7px;padding:8px 9px;font-size:13px;
           display:flex;align-items:center;gap:9px;text-align:left;width:100%}
  .actmenu-item:hover{background:var(--onbg)}
  .actmenu-item.on{color:var(--accent)}
  .actmenu-item.on svg{color:var(--accent)}
  .actmenu-item[disabled]{opacity:.5;cursor:default}
  .actmenu-item[disabled]:hover{background:none}
  .actmenu-item svg{flex:none}
  #tip{position:fixed;pointer-events:none;z-index:30;display:none;max-width:280px;
       max-height:72vh;overflow-y:auto;
       background:var(--surface);border:1px solid var(--accent);border-radius:8px;
       padding:8px 10px;font-size:12px;line-height:1.5;box-shadow:0 6px 20px #000a}
  #tip.pinned{cursor:grab;padding-top:28px;padding-right:34px}
  #tip.pinned.dragging{cursor:grabbing;user-select:none}
  #tip b{color:var(--fg)}
  /* Pinned card only (the interactive one, opened by tapping a radar node) --
     replaces the old full-width "Close" text button with a small circle X
     in the corner, matching the mac-info modal's close affordance. */
  #tip .tipx{position:absolute;top:6px;right:6px;width:22px;height:22px;
       border-radius:50%;background:var(--surface);border:1px solid var(--line);
       color:var(--muted);font-size:14px;line-height:1;padding:0;
       display:flex;align-items:center;justify-content:center;cursor:pointer}
  #tip .tipx:hover{color:var(--fg);background:var(--line)}
  #tip .tipbtns{display:flex;gap:6px;margin-top:8px}
  #tip .tipbtns button{font-size:12px;padding:4px 10px;border-radius:6px;flex:1}
  #tip .tipbtns .tgt.on{color:var(--accent);border-color:var(--accent)}
  #tip .tipbtns button.icobtn{flex:0 0 auto;padding:4px 7px;border:1px solid var(--line);
       background:var(--surface);color:var(--muted)}
  #tip .tipbtns button.icobtn.on{color:var(--accent);border-color:var(--accent)}
  #nodeMenu{z-index:31;display:none;opacity:1;transition:opacity .18s ease}
  /* Not actively hovered (node or the buttons) -> dim so it doesn't sit as two
     solid discs over nearby node labels; still fully clickable, just translucent.
     Moving back over the node (JS, see mousemove) or straight onto a button
     (this :hover, which fires via DOM ancestry even though .nmc is position:fixed
     and visually outside #nodeMenu's own box) restores full opacity. */
  #nodeMenu.faded{opacity:.1}
  #nodeMenu:hover{opacity:1}
  /* .nmc is position:fixed (not relative to #nodeMenu) -- each button's left/top
     is set inline in page coords (positionNodeMenu), clamped to the viewport, so
     the pair never clips off-screen near a canvas edge (small mobile screens). */
  #nodeMenu .nmc{position:fixed;width:38px;height:38px;padding:0;border-radius:50%;
        font-size:16px;line-height:1;color:var(--muted);background:var(--surface-a3);
        border:1px solid var(--accent);box-shadow:0 4px 14px #000a;
        transform:translate(-50%,-50%);touch-action:manipulation}
  #nodeMenu .nmc:hover{color:var(--accent);background:var(--onbg-hover)}
  #nodeMenu .nmc:active{color:var(--accent);background:var(--onbg-active);transform:translate(-50%,-50%) scale(.92)}
  #nodeMenu #nmExpand.on{color:var(--accent);border-color:var(--accent)}
  footer{color:var(--muted);text-align:center;padding:10px;font-size:12px}
  /* ---- desktop: sidebar nav, one panel at a time (radar / devices / adverts) ---- */
  @media(min-width:1000px){
    .tabs{display:none}
    /* Lock the page to the viewport: header is fixed height, main takes the rest,
       nothing overflows the body -> no page scroll. Panels scroll internally. */
    html,body{height:100vh;overflow:hidden}
    main{padding:26px;display:flex;align-items:stretch;gap:14px;
         flex:1;min-height:0;overflow:hidden}
    #navBurger{display:flex}
    #sidenavCard{display:flex}
    .view{flex:1;min-width:0;min-height:0;border-radius:10px}   /* active panel fills remaining space */
    /* the active panel's scrollable body flexes to fill + scrolls internally */
    .view.active>.scroll,.view.active>.cards{flex:1;overflow:auto}
    #view-localap.active>.setsec,.fc-setsec,#view-sentinel.active>#sentinelViewMsgs{flex:1;overflow-y:auto}
    #radarWrap{min-height:0}                        /* let flex:1 shrink within the bounded view */
    .view.active>.scoutfeed{flex:1}
    /* Frames view: the active sub-pane (Capture/Craft) itself flexes to fill, so its own
       scrollable content (the live feed, or .fc-setsec's overflow) can flex in turn. */
    #view-frames.active>#framesTabWrap{flex:1;min-height:0;display:flex;flex-direction:column;overflow:hidden}
    #view-frames.active>#framesTabWrap>.localapsub-pane{flex:1;min-height:0}
  }
  /* --- Scout live UART feed (terminal) ------------------------------------ */
  .scoutfeed{overflow-y:auto;background:var(--feed-bg,#07100a);border-top:1px solid var(--feed-border,#1c2b20);
    font:12px/1.5 ui-monospace,Menlo,Consolas,monospace;padding:8px 10px;
    color:var(--feed-fg,#8fb59b);height:60vh;scroll-behavior:smooth}
  .sfl{white-space:nowrap;padding:1px 0;border-bottom:1px solid var(--feed-line,#0d1a12)}
  .sfl .sfa{color:var(--feed-age,#3f6b4e);margin-right:6px}          /* arrival age */
  .sfl .sfm{color:var(--feed-mac,#5ec8f0)}                            /* mac */
  .sfl .sfr{color:var(--feed-rssi,#e0b64a)}                           /* rssi */
  .sfl .sfc{color:var(--feed-ch,#8a8f98)}                             /* channel */
  .sfl .sfk{font-weight:700;padding:0 5px;border-radius:6px;margin:0 3px;font-size:11px}
  .sfl .k-beacon{background:var(--feed-beacon-bg,#123d1e);color:var(--feed-beacon-fg,#4ade80)}
  .sfl .k-probe{background:var(--feed-probe-bg,#3a2417);color:var(--feed-probe-fg,#f0a35e)}
  .sfl .k-presp{background:var(--feed-presp-bg,#1c2b45);color:var(--feed-presp-fg,#7ab6ff)}
  .sfl .sfs{color:var(--feed-ssid,#4ade80)}                            /* ssid */
  .sfl .sfs.empty{color:var(--feed-ssid-empty,#3f4a42);font-style:italic}
  .sfl .sfsec{color:var(--feed-sec,#6b7280);font-size:10px}          /* sec-scout sec/cip/pmf tail */
  .scoutfeed.paused{outline:2px solid var(--feed-paused,#e0b64a55)}
  /* --- Scout view: header pill + inline segmented sub-tabs + management cards ----- */
  .view.active>#scoutSubFeedPane{flex:1;display:flex;flex-direction:column;min-height:0}
  #scoutSubFeedPane>.scoutfeed{flex:1}
  .scout-hd{display:flex;align-items:center;gap:14px}
  .scout-subtabs{display:flex;gap:2px;background:var(--surface);border:1px solid var(--line);
    border-radius:999px;padding:2px;flex:none}
  .scout-subtabs button{border:none;background:transparent;color:var(--muted);font-size:11px;
    font-weight:700;letter-spacing:.02em;padding:5px 14px;border-radius:999px;cursor:pointer;
    transition:background .15s ease,color .15s ease}
  .scout-subtabs button:hover{color:var(--fg)}
  .scout-subtabs button.on{background:var(--accent-grad);color:var(--cta-fg);
    box-shadow:0 2px 10px -3px color-mix(in srgb,var(--accent) 60%,transparent)}
  .scout-feedbar{display:flex;align-items:center;gap:10px;padding:7px 12px;
    border-bottom:1px solid var(--line);font-size:12px}
  .scout-feedbar #scoutStat{margin-left:auto}
  .scout-mgmt{padding:14px 12px;display:flex;flex-direction:column;gap:10px;overflow-y:auto}
  .scout-mcard{background:var(--surface);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;display:flex;align-items:center;gap:14px;transition:border-color .15s ease}
  .scout-mcard:hover{border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}
  .scout-mcard .scm-ic{flex:none;width:38px;height:38px;border-radius:10px;background:var(--onbg);
    display:flex;align-items:center;justify-content:center;color:var(--accent)}
  .scout-mcard .scm-body{flex:1;min-width:0}
  .scout-mcard .scm-title{font-size:13px;font-weight:700}
  .scout-mcard .scm-sub{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.55}
  .scout-mcard .scm-act{flex:none;margin-left:10px}
  .scout-mcard .scm-act button{padding:7px 16px}
  .scout-vh-pill{margin-left:auto}
  /* --- Frames dump (raw 802.11 packet view) -------------------------------- */
  .frameFilters{display:flex;gap:6px;align-items:center;padding:6px 10px;
    flex-wrap:wrap;border-bottom:1px solid var(--line)}
  .ffl{white-space:nowrap;padding:1px 0;border-bottom:1px solid var(--feed-line,#0d1a12);
    display:flex;gap:6px;align-items:baseline}
  .ffl .sfk{flex:0 0 auto}
  .ffl .ffd{color:var(--feed-data,#9fd0ff);white-space:pre-wrap;word-break:break-all}   /* open-DATA ascii dump */
  .ffl .feap{color:var(--feed-eapol,#facc15);font-weight:600}          /* EAPOL tag on a data row */
  .ffsearch{background:var(--surface2);border:1px solid var(--line);border-radius:6px;
    color:var(--fg);font-size:13px;padding:4px 8px;font-family:inherit;width:140px}
  .ffsearch:focus{outline:none;border-color:var(--accent)}
  #framesSearchClr{background:none;border:none;color:var(--muted);font-size:16px;
    line-height:1;cursor:pointer;padding:0 2px}
  #framesSearchClr:hover{color:var(--fg)}
  /* --- Channel Density (WiFi radial graph) --------------------------------- */
  #chanWrap{padding:10px 12px;position:relative;flex:1;min-height:min(52vh,420px);
            display:flex;flex-direction:column;gap:10px}
  #chanCanvas{width:100%;flex:1;min-height:0;display:block;background:var(--surface2);
              border-radius:8px;cursor:pointer;touch-action:manipulation}
  #chanDetail{background:var(--surface);border:1px solid var(--line);border-radius:8px;
              padding:10px 12px;max-height:min(34vh,220px);overflow-y:auto;font-size:12px}
  #chanDetail .cd-hd{display:flex;align-items:baseline;gap:8px;margin-bottom:6px}
  #chanDetail .cd-hd b{font-size:15px;color:var(--accent)}
  #chanDetail .cd-hint{color:var(--muted)}
  #chanDetail .cd-row{display:flex;align-items:center;gap:8px;padding:3px 0;
                      border-bottom:1px solid var(--line)}
  #chanDetail .cd-row:last-child{border-bottom:none}
  #chanDetail .cd-click{cursor:pointer}
  #chanDetail .cd-click:hover{background:var(--hover,rgba(255,255,255,.05))}
  #chanDetail .cd-ssid{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #chanDetail .cd-r{color:var(--fg);font-weight:600;font-variant-numeric:tabular-nums}
  #chanDetail .cd-n{color:var(--muted);font-variant-numeric:tabular-nums}
  @media(min-width:1000px){ .view.active>#chanWrap{flex:1} }
  /* --- GPS Trail (GPS-tagged sightings, as a time-ordered table) ------------ */
  #trailWrap{padding:10px 12px;position:relative;flex:1;min-height:min(52vh,420px);
            display:flex;flex-direction:column;gap:10px}
  #trailEmpty{color:var(--muted);font-size:12px;text-align:center;padding:30px 10px}
  @media(min-width:1000px){ .view.active>#trailWrap{flex:1} }
  /* --- Mobile header declutter: keep the top bar to one tidy row ----------- */
  @media(max-width:560px){
    header{padding:7px 10px;gap:6px}
    h1{font-size:13px;letter-spacing:.2px}
    .controls{gap:6px}
    .seg{padding:2px}
    .segbtn{padding:5px 12px;letter-spacing:0}
    #liveBtn{padding:6px 8px}
    #liveBtn .btxt{display:none}                 /* dot-only live indicator */
    #gearBtn{padding:6px 9px}
    .cbtn{display:none}                           /* collapse pointless on mobile (one view fills screen) */
    #devSearchBtn{display:inline-flex}            /* ...but keep the search magnifier */
  }
  @media(max-width:380px){
    h1 .brandlong{display:none}                  /* narrow phones: shorten to "Scan" */
  }
  /* --- Mobile radar band bar: SIG/SEEN/AGE/CNT/CH row doesn't fit -> collapse
     into one trigger button + popup list, same setBandMode() wiring. --------- */
  @media(max-width:560px){
    #rband{gap:6px;padding:5px 9px}
    #rband input[type=range]{width:96px}
    #bandModeBtn{display:inline-flex;align-items:center;gap:3px;height:20px;
      padding:0 7px;font-size:10px;font-weight:600;background:transparent;
      border:1px solid var(--line);color:var(--accent);border-radius:4px;
      cursor:pointer;letter-spacing:.3px}
    #bandModes{display:none;position:absolute;bottom:100%;left:9px;margin-bottom:6px;
      flex-direction:column;gap:2px;background:var(--surface);border:1px solid var(--line);
      border-radius:8px;padding:4px;min-width:64px;box-shadow:0 6px 20px #000a}
    #bandModes.open{display:flex}
    #bandModes button{width:auto}
  }
</style><script>(function(){try{var t=localStorage.getItem('websTheme');
  if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<!-- Sentinel live alert panel: shown whenever a Sentinel watch session is
     running, listing WHY each armed watch is (or isn't) currently flagging
     something -- see RadarServer::appendSentinelPayload_ for the "sentinel"
     JSON this renders (renderSentinelPanel() in the JS below). -->
<div id="sentinelPanel">
  <div class="sp-hd"><span class="sp-dot"></span><span>Sentinel</span>
    <button class="sp-close" onclick="dismissSentinelPanel()" title="dismiss (reopens on a new alert, or from the Sentinel tab)">&times;</button>
  </div>
  <div id="sentinelMsgs"></div>
</div>
<!-- settings modal (gear button) -->
<div id="setModal" class="modal" onclick="if(event.target===this)closeSetModal()">
  <div class="modal-card">
    <div class="modal-hd">
      <span class="gear">&#9881;</span><h2>Settings</h2>
      <button class="modal-x" onclick="closeSetModal()" title="close">&times;</button>
    </div>
    <div class="settabs-wrap">
    <button class="settabmore" id="setTabMoreBtn" onclick="toggleSetTabMenu(event)">
      <span id="setTabCur">Settings</span><span class="care">&#9662;</span>
    </button>
    <div class="settabs" id="setTabMenu">
      <button class="settab" data-stab="general" onclick="setSettingsTab('general')">General</button>
      <button class="settab" data-stab="mem"  onclick="setSettingsTab('mem')">Memory</button>
      <button class="settab" data-stab="data" onclick="setSettingsTab('data')">Data</button>
      <button class="settab" data-stab="network" onclick="setSettingsTab('network')">Network</button>
      <button class="settab" data-stab="scout" onclick="setSettingsTab('scout')">Scout</button>
    </div>
    </div>
    <div class="setsec stab-pane" data-stab="general">
      <div class="netcard">
      <div class="netcard-hd">Display</div>
      <div class="setrow">
        <span class="k">Theme</span>
        <span class="v"><select id="webTheme" onchange="setWebTheme(this.value)">
          <option value="">Default</option>
          <option value="granite">Granite</option>
          <option value="ocean">Ocean</option>
          <option value="forest">Forest</option>
          <option value="sunset">Sunset</option>
          <option value="slate">Slate</option>
          <option value="neon">Neon</option>
          <option value="steampunk">Steampunk</option>
          <option value="synthwave">Synthwave</option>
          <option value="terminal">Terminal</option>
          <option value="cyberpunk">Cyberpunk</option>
          <option value="aurora">Aurora</option>
        </select></span>
      </div>
      <div class="sethint">Dashboard colour palette. Saved to this browser only (localStorage) &mdash; other devices/browsers keep their own choice.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Client performance</div>
      <div class="setrow">
        <span class="k">Poll rate</span>
        <span class="v"><input type="range" id="pollms" min="250" max="10000" value="1000" step="250"
               oninput="setPollMs(this.value)" onchange="savePollMs(this.value)"> <b id="pollmsL">1000</b> ms</span>
      </div>
      <div class="sethint">Browser poll interval for <b>/api/data</b>. Default 1000 ms, saved to NVS.</div>
      <div class="setrow" style="margin-top:14px">
        <span class="k">Retention</span>
        <span class="v" title="All data is kept for the whole session by default â€” nothing expires and named networks are never dropped. Set a lifespan (minutes) to age out stale probes/APs if you want a rolling window. 0 = keep everything.">
          <input type="number" id="ttlMin" min="0" max="1440" step="1" value="0" style="width:60px" onchange="setTtl()"> min &middot; 0 = keep all
        </span>
      </div>
      <div class="sethint">Lifespan for WiFi probes/APs. 0 = keep everything for the session.</div>
      <div class="setrow" style="margin-top:14px">
        <span class="k">Heap relief</span>
        <span class="v"><button id="clientAggBtn" class="tgl" onclick="toggleDataOpt('clientAggBtn','clientagg')" title="Primary stops folding scout WiFi traffic into its own per-MAC store â€” the browser builds the table instead from the same raw feed already streamed here. Trades the on-device store for heap headroom; useful on any board with a big/heavy scout roster, not just this on-device table.">Client-side WiFi aggregation</button></span>
      </div>
      <div class="sethint">Saves device heap when a scout with a heavy roster is linked.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Vendors</div>
      <div class="setrow"><span class="k">Imported entries</span><span class="v" id="ouiCount">&mdash;</span></div>
      <div class="setrow">
        <span class="k">Import file</span>
        <span class="v"><button class="icobtn" onclick="document.getElementById('ouiFile').click()" title="Choose OUI file to import">&uarr; Import</button>
          <button class="icobtn confirm" onclick="clearOui()" title="Clear imported entries">&times; Clear</button>
          <input type="file" id="ouiFile" onchange="importOui(this)" hidden></span>
      </div>
      <div id="ouiStatus" class="sethint" style="min-height:1em"></div>
      <div class="sethint">Import the full IEEE registry or a Wireshark manuf file to vendor-tag more MACs. Stored in this browser.<br>
      Download:
      <a href="https://standards-oui.ieee.org/oui/oui.csv" target="_blank" rel="noopener">standards-oui.ieee.org/oui/oui.csv</a>
      &middot;
      <a href="https://www.wireshark.org/download/automated/data/manuf" target="_blank" rel="noopener">wireshark.org &hellip; /data/manuf</a></div>
      </div>
    </div>
    <div class="setsec stab-pane" data-stab="mem">
      <div class="setsec-hd">Device memory &amp; flash</div>
      <div class="membar-wrap">
        <div class="lbl"><span>Heap load</span><span id="memHeapPct">&mdash;</span></div>
        <div class="membar" id="memHeapBar"><span></span></div>
      </div>
      <div class="membar-wrap">
        <div class="lbl"><span>Flash (app partition)</span><span id="memFlashPct">&mdash;</span></div>
        <div class="membar" id="memFlashBar"><span></span></div>
      </div>
      <div class="statgrid" style="margin-top:12px">
        <div><span class="k">Free heap</span><span class="v" id="memHeap">&mdash;</span></div>
        <div><span class="k">Min free heap</span><span class="v" id="memHeapMin">&mdash;</span></div>
        <div><span class="k">PSRAM free</span><span class="v" id="memPsram">&mdash;</span></div>
        <div><span class="k">Sketch (flash)</span><span class="v" id="memSketch">&mdash;</span></div>
        <div><span class="k">Records held</span><span class="v" id="memRecords">&mdash;</span></div>
        <div id="hidDbRow" style="display:none"><span class="k">Hidden network DB</span><span class="v" id="hidDbCount">&mdash;</span></div>
      </div>
      <div class="setrow" style="margin-top:14px">
        <span class="k">Flush</span>
        <span class="v"><select id="flushTarget">
            <option value="all">All records</option>
          </select> <button class="icobtn" onclick="requestFlush()" title="Flush selected data">&#9654; Flush</button></span>
      </div>
      <div class="setrow">
        <span class="k">Session</span>
        <span class="v"><button class="icobtn confirm" onclick="requestNewSession()" title="Start a new session (archives current data, clears the board)">&#8635; New session</button></span>
      </div>
      <div id="memStatus" class="sethint" style="min-height:1em"></div>
      <div class="sethint"><b>Flush</b> wipes the selected data; <b>New session</b> also clears the SD snapshot + pinned target &mdash; neither can be undone.<span id="hidDbHint" style="display:none"> Recovered cloaked-AP names persist in flash across reboots.</span></div>
    </div>
    <div class="setsec stab-pane" data-stab="data">
      <div class="netcard">
      <div class="netcard-hd">Import / export</div>
      <div class="setrow">
        <span class="k">Snapshot file</span>
        <span class="v"><select id="expFormat" title="What Export downloads">
            <option value="json">JSON (current data)</option>
          </select>
          <button class="icobtn" onclick="exportData()" title="Export snapshot">&darr; Export</button>
          <button class="icobtn" onclick="document.getElementById('ioFile').click()" title="Import snapshot (JSON file)">&uarr; Import</button>
          <input type="file" id="ioFile" accept=".json,application/json" onchange="importData(this)" hidden></span>
      </div>
      <div id="ioStatus" class="sethint" style="min-height:1em"></div>
      <div class="sethint">Export/import the WiFi table as JSON. Import pauses Live.</div>
      <div class="setrow netdiv">
        <span class="k">SD WiFi capture</span>
        <span class="v"><button class="icobtn" onclick="loadSdWifiCapture()" title="Load a standalone SD WiFi capture into this session">&darr; Load</button>
          <button class="icobtn" onclick="wifiAggPushNow()" title="Sync back: write this tab's WiFi aggregate to the same SD file">&#8646; Sync back</button></span>
      </div>
      <div class="sethint">Loads a standalone WiFi capture from SD. Pauses Live. "Sync back" writes this tab's current WiFi aggregate (loaded + anything captured since) back to the same SD file, so the device has the merged result too.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Saved sessions (SD)</div>
      <div id="sessSelRow" class="setrow" style="display:none">
        <span class="k">Session</span>
        <span class="v"><select id="sessSel" style="max-width:220px"></select>
          <button class="icobtn" onclick="loadSelectedSession()" title="Load selected session">&darr; Load</button>
          <button class="icobtn confirm" onclick="requestDeleteSession()" title="Delete selected session">&times; Delete</button>
          <button class="icobtn confirm" onclick="requestDeleteAllSessions()" title="Delete all sessions">&times;&times; Delete all</button></span>
      </div>
      <div id="sessList" class="sethint">&mdash;</div>
      <div class="sethint">Load reviews one offline (pauses Live). Delete/Delete all remove from the card &mdash; can't be undone.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Evicted-record log (SD)</div>
      <div class="setrow">
        <span class="k">802eleven_wifi_log.csv</span>
        <span class="v"><button class="icobtn" onclick="loadWifiLog()" title="Load the evicted-record log">&darr; Load</button>
          <button class="icobtn confirm" onclick="clearWifiLog()" title="Clear the log">&times; Clear</button></span>
      </div>
      <div id="wlogStatus" class="sethint" style="min-height:1em"></div>
      <div class="sethint">Records the in-RAM WiFi cap evicted over a long capture (see Retention above) land here instead of vanishing. Load reviews them offline, same as a saved session &mdash; RSSI avg/age aren't meaningful for replayed rows (see hint on load). Clear truncates the log once you're done with it.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">File Manager (SD)</div>
      <div class="setrow">
        <span class="k">All files on the card</span>
        <span class="v"><button class="icobtn" onclick="closeSetModal();openFileMgr()" title="Open the full File Manager">&#9638; Open</button></span>
      </div>
      </div>
    </div>
    <div class="setsec stab-pane" data-stab="network">
      <div class="netcard">
      <div class="netcard-hd">Dashboard WiFi network</div>
      <div class="setrow">
        <span class="k">Network name</span>
        <span class="v"><input type="text" id="apSsid" maxlength="32" placeholder="802Eleven"></span>
      </div>
      <div class="setrow">
        <span class="k">Security</span>
        <span class="v">
          <label style="margin-right:14px;cursor:pointer"><input type="radio" name="apSec" value="wpa2" checked onchange="apSecChanged()"> WPA2</label>
          <label style="cursor:pointer"><input type="radio" name="apSec" value="open" onchange="apSecChanged()"> Open</label>
        </span>
      </div>
      <div class="setrow" id="apPassRow">
        <span class="k">Password</span>
        <span class="v"><input type="text" id="apPass" maxlength="63" placeholder="leave blank to keep current"></span>
      </div>
      <div class="setrow">
        <span class="k">Visibility</span>
        <span class="v">
          <label style="margin-right:14px;cursor:pointer"><input type="radio" name="apVis" value="hidden" checked> Hidden</label>
          <label style="cursor:pointer"><input type="radio" name="apVis" value="visible"> Visible</label>
        </span>
      </div>
      <div class="setrow">
        <span class="k">Apply</span>
        <span class="v"><button class="icobtn" onclick="saveApSettings()" title="Save &amp; restart AP">&#10003; Save</button>
          <button class="icobtn confirm" id="apResetBtn" onclick="resetApSettings()" title="Revert to default">&#8634; Reset</button></span>
      </div>
      <div id="apStatusMsg" class="sethint" style="min-height:1em"></div>
      <div class="sethint">The AP clients join to reach this dashboard. Changing it <b>restarts the AP</b> &mdash; every device must rejoin.</div>
      <div class="setrow netdiv">
        <span class="k">Reconnect</span>
        <span class="v"><button class="icobtn" id="apQrBtn" onclick="toggleApQr()" title="Scan to join (WiFi QR code)">QR</button></span>
      </div>
      <div id="apQrBox" class="apqrbox" style="display:none">
        <button type="button" id="apQrFrame" class="qr-frame" onclick="toggleQrBlur('apQrFrame')">
          <img id="apQrImg" alt="WiFi join QR code">
          <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
        </button>
        <button type="button" class="cr-copy-btn" id="apCopyBtn" onclick="copyApPass('apCopyBtn')">Copy password</button>
        <div class="sethint">Scan with your phone's camera app to join &mdash; works for a hidden network too, since the code carries the SSID itself.</div>
      </div>
      <div class="setrow netdiv">
        <span class="k">Captive portal</span>
        <span class="v"><button id="captiveBtn" class="tgl" onclick="toggleCaptivePortal()" title="Auto-pop the OS's captive-portal browser with an 'Open Web Portal' landing page on join. Off = clients must manually browse to the AP IP; DNS/normal browsing is unaffected either way.">Auto-open on join</button></span>
      </div>
      <div class="sethint">Pops a one-button "Open Web Portal" landing page when a device joins the AP -- it self-disables (this toggle flips off) the moment it's shown once, since the OS's mini-browser can't remember devices across rejoins. Flip back on here anytime. Also turn off if it's interfering with a client's normal internet DNS (e.g. while also joined to Uplink WiFi).</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Device MAC</div>
      <div class="setrow">
        <span class="k">AP MAC</span>
        <span class="v"><input type="text" id="apMac" maxlength="17" placeholder="aa:bb:cc:dd:ee:ff (blank = factory)"></span>
      </div>
      <div class="setrow">
        <span class="k">STA MAC</span>
        <span class="v"><input type="text" id="staMac" maxlength="17" placeholder="aa:bb:cc:dd:ee:ff (blank = factory)"></span>
      </div>
      <div class="setrow">
        <span class="k">Link STA to AP</span>
        <span class="v"><button id="staMacLinkBtn" class="tgl" onclick="toggleStaMacLink()" title="STA-interface MAC mirrors the AP MAC above instead of its own field">STA mirrors AP MAC</button></span>
      </div>
      <div class="setrow">
        <span class="k">Similar-MAC rand</span>
        <span class="v"><button id="macRandBtn" class="tgl" onclick="toggleMacRand()" title="When cloning a seen device's MAC (the mac-card Actions menu, or an on-device picker), re-randomise the last 2 octets instead of reusing it verbatim">Randomise last 2 octets</button></span>
      </div>
      <div class="setrow">
        <span class="k">Apply</span>
        <span class="v"><button class="icobtn" onclick="saveApMac()" title="Save AP MAC">&#10003; AP</button>
          <button class="icobtn" onclick="saveStaMac()" title="Save STA MAC">&#10003; STA</button></span>
      </div>
      <div id="macStatusMsg" class="sethint" style="min-height:1em"></div>
      <div class="sethint">AP MAC applies immediately (AP restarts). STA MAC takes effect on next reboot. Clone a specific seen device's MAC from its mac-card &rarr; Actions menu instead of typing one here.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Access password</div>
      <div class="setrow"><span class="k">Gate status</span><span class="v" id="secStatus">&mdash;</span></div>
      <div class="setrow" id="secOldRow">
        <span class="k">Current password</span>
        <span class="v"><input type="password" id="secOld" autocomplete="current-password" placeholder="current password"></span>
      </div>
      <div class="setrow">
        <span class="k">New password</span>
        <span class="v"><input type="password" id="secPass1" autocomplete="new-password" placeholder="new password"></span>
      </div>
      <div class="setrow">
        <span class="k">Confirm</span>
        <span class="v"><input type="password" id="secPass2" autocomplete="new-password" placeholder="repeat"></span>
      </div>
      <div class="setrow">
        <span class="k">Apply</span>
        <span class="v"><button class="icobtn" onclick="savePass()" title="Save password">&#10003; Save</button>
          <button class="icobtn confirm" id="secDisableBtn" onclick="savePass('')" title="Disable gate">&#8856; Disable</button>
          <button class="icobtn confirm" id="secReset" onclick="resetPass()" title="Revert to default">&#8634; Reset</button></span>
      </div>
      <div id="secStatusMsg" class="sethint" style="min-height:1em"></div>
      <div class="sethint">Password gate for the dashboard + API. <b>Empty = off.</b> Signs out other browsers.</div>
      </div>
      <div class="netcard">
      <div class="netcard-hd">Uplink WiFi</div>
      <div class="setrow"><span class="k">Status</span><span class="v" id="staStatus">&mdash;</span></div>
      <div class="setrow">
        <span class="k">Network name</span>
        <span class="v"><input type="text" id="staSsid" maxlength="32" placeholder="Home network"></span>
      </div>
      <div class="setrow">
        <span class="k">Password</span>
        <span class="v"><input type="text" id="staPass" maxlength="63" placeholder="leave blank if open, or to keep current"></span>
      </div>
      <div class="setrow">
        <span class="k">Apply</span>
        <span class="v"><button class="icobtn" onclick="saveStaSettings()" title="Connect">&#10003; Connect</button>
          <button id="staEnBtn" class="tgl" onclick="toggleStaEnabled()">Disable</button>
          <button class="icobtn confirm" id="staForgetBtn" onclick="forgetStaSettings()" title="Forget saved network">&#8854; Forget</button></span>
      </div>
      <div id="staStatusMsg" class="sethint" style="min-height:1em"></div>
      <div class="sethint">Join an existing WiFi network alongside this board's own dashboard AP (e.g. for internet access while debugging). Independent of the AP above &mdash; both run at once.</div>
      </div>
    </div>
    <div class="setsec stab-pane" data-stab="scout">
      <div class="setsec-hd">Scout companion</div>
      <div class="setrow">
        <span class="k">Link status</span>
        <span class="v" id="setScoutPill"><span class="statuspill down"><span class="dot"></span>Not detected</span></span>
      </div>
      <div class="setrow"><span class="k">Frames received</span><span class="v" id="setScoutFrames">&mdash;</span></div>
      <div class="sethint">Optional 2nd board (<b>[env:scout]</b>) for continuous WiFi capture over UART, freeing this board's radio.</div>
    </div>
  </div>
</div>
<!-- Shared destructive-action confirm modal (Flush, New session, Delete
     session, Delete all sessions) -- one popup reused for all of them,
     matching hsDelModal's styling, instead of each having its own inline
     two-click-confirm row. openConfirm(bodyHtml, yesLabel, onYes, extraHtml). -->
<div id="confirmModal" class="modal" onclick="if(event.target===this)closeConfirm()">
  <div class="modal-card">
    <div class="modal-hd">
      <h2>Confirm</h2>
      <button class="modal-x" onclick="closeConfirm()" title="close">&times;</button>
    </div>
    <div class="setsec" style="padding:16px">
      <div class="sethint" id="confirmModalBody" style="margin-top:0"></div>
      <div id="confirmModalExtra" style="display:none;margin-top:10px"></div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
        <button class="iconbtn" onclick="closeConfirm()">Cancel</button>
        <button class="iconbtn on" id="confirmModalBtn" style="background:#f66;border-color:#f66;color:#fff" onclick="doConfirm()">Confirm</button>
      </div>
    </div>
  </div>
</div>
<!-- MAC info modal (click a MAC in the Deauths table) -->
<div id="macModal" class="modal" onclick="if(event.target===this)closeMacInfo()">
  <div class="modal-card">
    <div class="modal-hd">
      <h2 id="macModalMac" style="display:none">MAC</h2>
      <button class="modal-x" style="margin-left:auto" onclick="closeMacInfo()" title="close">&times;</button>
    </div>
    <div id="macModalBody"></div>
  </div>
</div>
<!-- Frame Craft safety warning (accepted once per session before entering craft/frames) -->
<div id="fcWarnModal" class="modal" onclick="if(event.target===this)closeFcWarn()">
  <div class="modal-card" style="border-top:3px solid #e8a020">
    <div class="modal-hd">
      <h2 style="color:#e8a020">&#9888; Authorised Use Only</h2>
      <button class="modal-x" onclick="closeFcWarn()" title="close">&times;</button>
    </div>
    <div class="setsec" style="padding:16px">
      <p style="margin:0 0 10px">Transmitting custom 802.11 frames can:</p>
      <ul style="margin:0 0 10px;padding-left:18px">
        <li>Cause interference to nearby WiFi devices and networks</li>
        <li>Violate RF / radio-communications regulations (FCC, Ofcom, etc.)</li>
        <li>Constitute unauthorised access under computer-misuse law</li>
      </ul>
      <p style="margin:0 0 14px">Only target devices you <strong>own</strong> or have <strong>explicit written permission</strong> to test. RF shielding is advised to prevent frames reaching unintended devices.</p>
      <div style="display:flex;justify-content:flex-end;gap:8px">
        <button class="iconbtn" onclick="closeFcWarn()">Cancel</button>
        <button class="iconbtn" style="background:#e8a020;color:#000;font-weight:600;border-color:#e8a020" onclick="acceptFcWarn()">Accept &mdash; I understand the risks</button>
      </div>
    </div>
  </div>
</div>
<!-- Send Frame modal (Actions -> Send frame, from a beacon's mac-info panel) -->
<div id="sendFrameModal" class="modal" onclick="if(event.target===this)closeSendFrame()">
  <div class="modal-card">
    <div class="modal-hd">
      <h2>Send frame</h2>
      <button class="modal-x" onclick="closeSendFrame()" title="close">&times;</button>
    </div>
    <div id="sfBody" class="setsec"></div>
  </div>
</div>
<!-- Use similar MAC modal (Actions -> Use similar MAC, AP/STA picker) -->
<div id="similarMacModal" class="modal" onclick="if(event.target===this)closeSimilarMac()">
  <div class="modal-card">
    <div class="modal-hd">
      <h2>Use similar MAC</h2>
      <button class="modal-x" onclick="closeSimilarMac()" title="close">&times;</button>
    </div>
    <div id="smBody" class="setsec"></div>
  </div>
</div>
<!-- Full-screen lock while a LOCAL (no-scout) send runs: the dashboard AP is
     offline for the whole window (see openSendFrame's warning text), so this
     is the same "own the screen, nothing clickable underneath" treatment as
     #capruns above -- reuses its cr-* ring/label styling, own ids so the two
     can't collide if somehow both were ever open. -->
<div id="sfruns" class="capruns">
  <div class="cr-ring">
    <svg viewBox="0 0 120 120">
      <circle class="cr-track" cx="60" cy="60" r="52"/>
      <circle id="sfCrArc" class="cr-arc" cx="60" cy="60" r="52"/>
    </svg>
    <div class="cr-num"><b id="sfCrLeft">0</b><span>seconds</span></div>
  </div>
  <div class="cr-title" id="sfCrTitle">Send Frame in progress</div>
  <div id="sfCrParams" class="cr-params"></div>
  <div id="sfCrSub" class="cr-sub" style="display:none"></div>
  <div id="sfQrWrap" class="cr-qr-wrap" style="display:none">
    <button type="button" id="sfQrFrame" class="qr-frame" onclick="toggleQrBlur('sfQrFrame')">
      <img id="sfQrImg" class="cr-qr" alt="Scan to rejoin this network">
      <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
    </button>
    <button type="button" class="cr-copy-btn" id="sfCopyBtn" onclick="copyApPass('sfCopyBtn')">Copy password</button>
  </div>
</div>
<!-- Full-screen lock while a LOCAL (no-scout) Local AP run is up: same
     "own the screen, nothing clickable underneath" treatment as #sfruns
     above (reuses its cr-* ring/label styling, own ids so the two can't
     collide) -- this board's own AP is a different SSID for the run's
     Duration, so the dashboard itself is unreachable until it ends. -->
<div id="localapruns" class="capruns">
  <div class="cr-ring">
    <svg viewBox="0 0 120 120">
      <circle class="cr-track" cx="60" cy="60" r="52"/>
      <circle id="laCrArc" class="cr-arc" cx="60" cy="60" r="52"/>
    </svg>
    <div class="cr-num"><b id="laCrLeft">0</b><span>seconds</span></div>
  </div>
  <div class="cr-title" id="laCrTitle">Local AP in progress</div>
  <div id="laCrParams" class="cr-params"></div>
  <div id="laCrSub" class="cr-sub" style="display:none"></div>
  <div id="laQrWrap" class="cr-qr-wrap" style="display:none">
    <button type="button" id="laQrFrame" class="qr-frame" onclick="toggleQrBlur('laQrFrame')">
      <img id="laQrImg" class="cr-qr" alt="Scan to rejoin this network">
      <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
    </button>
    <button type="button" class="cr-copy-btn" id="laCopyBtn" onclick="copyApPass('laCopyBtn')">Copy password</button>
  </div>
</div>
<!-- Full-screen lock while a LOCAL (no-scout) Frame Crafting run is up --
     same "own the screen, nothing clickable underneath" treatment as
     #sfruns above (reuses its cr-* ring/label styling, own ids so the two
     can't collide). -->
<div id="craftruns" class="capruns">
  <div class="cr-ring">
    <svg viewBox="0 0 120 120">
      <circle class="cr-track" cx="60" cy="60" r="52"/>
      <circle id="fcCrArc" class="cr-arc" cx="60" cy="60" r="52"/>
    </svg>
    <div class="cr-num"><b id="fcCrLeft">0</b><span>seconds</span></div>
  </div>
  <div class="cr-title" id="fcCrTitle">Frame Crafting in progress</div>
  <div id="fcCrParams" class="cr-params"></div>
  <div id="fcCrSub" class="cr-sub" style="display:none"></div>
  <div id="fcQrWrap" class="cr-qr-wrap" style="display:none">
    <button type="button" id="fcQrFrame" class="qr-frame" onclick="toggleQrBlur('fcQrFrame')">
      <img id="fcQrImg" class="cr-qr" alt="Scan to rejoin this network">
      <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
    </button>
    <button type="button" class="cr-copy-btn" id="fcCopyBtn" onclick="copyApPass('fcCopyBtn')">Copy password</button>
  </div>
</div>
<!-- Full-screen lock while a LOCAL (no-scout) Frames dump run is up -- same
     "own the screen, nothing clickable underneath" treatment as #sfruns
     above (reuses its cr-* ring/label styling, own ids so the two can't
     collide). The Frames Start button falls back to this when no scout is
     linked: the primary's own radio has to leave AP mode for the window, so
     the dashboard goes down for its duration same as a plain Capture. -->
<div id="fdruns" class="capruns">
  <div class="cr-ring">
    <svg viewBox="0 0 120 120">
      <circle class="cr-track" cx="60" cy="60" r="52"/>
      <circle id="fdCrArc" class="cr-arc" cx="60" cy="60" r="52"/>
    </svg>
    <div class="cr-num"><b id="fdCrLeft">0</b><span>seconds</span></div>
  </div>
  <div class="cr-title" id="fdCrTitle">Frame dump in progress</div>
  <div id="fdCrParams" class="cr-params"></div>
  <div id="fdCrSub" class="cr-sub" style="display:none"></div>
  <div id="fdQrWrap" class="cr-qr-wrap" style="display:none">
    <button type="button" id="fdQrFrame" class="qr-frame" onclick="toggleQrBlur('fdQrFrame')">
      <img id="fdQrImg" class="cr-qr" alt="Scan to rejoin this network">
      <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
    </button>
    <button type="button" class="cr-copy-btn" id="fdCopyBtn" onclick="copyApPass('fdCopyBtn')">Copy password</button>
  </div>
</div>
<!-- Delete-confirm modal (Authorisations tab, Handshake Captures list) --
     replaces the old inline two-click-confirm delete button with a real
     popup, matching macModal's card styling. -->
<div id="hsDelModal" class="modal" onclick="if(event.target===this)closeHsDelModal()">
  <div class="modal-card">
    <div class="modal-hd">
      <h2>Delete capture</h2>
      <button class="modal-x" onclick="closeHsDelModal()" title="close">&times;</button>
    </div>
    <div class="setsec" style="padding:16px">
      <div class="sethint" id="hsDelModalBody" style="margin-top:0"></div>
      <div id="hsDelModalErr" class="sethint" style="display:none;color:#f66"></div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
        <button class="iconbtn" onclick="closeHsDelModal()">Cancel</button>
        <button class="iconbtn on" id="hsDelModalBtn" style="background:#f66;border-color:#f66;color:#fff" onclick="confirmHsDelete()">Delete</button>
      </div>
    </div>
  </div>
</div>
<!-- File Manager: dedicated near-fullscreen modal (header "Files" button + the
     Settings > Data entry point), not folded into the Settings modal -- a file table with
     download/rename/delete needs real width/height on a phone, which the 420px settings card
     doesn't have. -->
<div id="fileMgrModal" class="modal" onclick="if(event.target===this)closeFileMgr()">
  <div class="modal-card">
    <div class="modal-hd">
      <h2>File Manager (SD)</h2>
      <button class="modal-x" onclick="closeFileMgr()" title="close">&times;</button>
    </div>
    <div class="setsec">
      <div class="setrow">
        <span class="k">Upload</span>
        <span class="v"><button class="icobtn" onclick="document.getElementById('fmFile').click()" title="Upload a file into the card's /802eleven root">&uarr; Upload</button>
          <input type="file" id="fmFile" onchange="fmUpload(this)" hidden></span>
      </div>
      <div id="fmTabs" class="fmtabs" role="tablist"></div>
      <div id="fmList" class="sethint">&mdash;</div>
      <div id="fmStatus" class="sethint" style="min-height:1em"></div>
    </div>
  </div>
</div>
<div class="tabs">
  <button class="tab" data-v="map"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="7"/><circle cx="10" cy="10" r="1.6" fill="currentColor" stroke="none"/></svg>MAP</button>
  <button class="tab" data-v="devices"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="3" y="4" width="14" height="3" rx="1"/><rect x="3" y="9" width="14" height="3" rx="1"/><rect x="3" y="14" width="14" height="3" rx="1"/></svg>DEVICES <span id="hd">0</span></button>
  <div class="tabmore-wrap wifi-only" style="display:none">
    <button class="tabmore" id="tabMoreBtn" onclick="toggleTabMenu(event)" title="more views">&raquo;</button>
    <div class="tabmenu" id="tabMenu">
      <button class="tab" data-v="chan"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 10 L10 3 A7 7 0 0 1 16.5 13 Z"/><path d="M10 10 L4 6.5 A7 7 0 0 0 10 17 A7 7 0 0 0 16.5 13 Z"/></svg>CHANNELS</button>
      <button class="tab gps-only" style="display:none" data-v="trail"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15 C6 15 6 9 9 9 S12 5 17 5"/><circle cx="3" cy="15" r="1.3" fill="currentColor" stroke="none"/><circle cx="17" cy="5" r="1.3" fill="currentColor" stroke="none"/></svg>GPS TRAIL</button>
      <button class="tab" data-v="deauth"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 L16 5.5 V10 C16 14 13.4 16.6 10 17.5 C6.6 16.6 4 14 4 10 V5.5 Z"/></svg>AUTHORISATIONS <span id="hde">0</span></button>
      <button class="tab" data-v="localap"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10" cy="14" r="1.6" fill="currentColor" stroke="none"/><path d="M6.5 11 a5 5 0 0 1 7 0"/><path d="M3.5 8 a9.2 9.2 0 0 1 13 0"/></svg>LOCAL AP</button>
      <button class="tab" data-v="frames"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 3 v3 M4 3 h3 M16 3 v3 M16 3 h-3 M4 17 v-3 M4 17 h3 M16 17 v-3 M16 17 h-3"/></svg>FRAMES</button>
      <button class="tab scout-only" data-v="scout" style="display:none"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 17 V9"/><circle cx="10" cy="6" r="2.4"/><path d="M6.5 4 a5 5 0 0 0 0 4"/><path d="M13.5 4 a5 5 0 0 1 0 4"/></svg>SCOUT</button>
      <button class="tab sentinel-only" data-v="sentinel" style="display:none"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10 C5.5 5.5 14.5 5.5 17 10 C14.5 14.5 5.5 14.5 3 10 Z"/><circle cx="10" cy="10" r="2"/></svg>SENTINEL</button>
      <button class="tab" onclick="document.getElementById('tabMenu').classList.remove('open');openFileMgr()"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6 a1 1 0 0 1 1-1 h4 l1.5 2 H16 a1 1 0 0 1 1 1 v7 a1 1 0 0 1-1 1 H4 a1 1 0 0 1-1-1 Z"/></svg>FILE MANAGER</button>
    </div>
  </div>
</div>
<main>
<div id="sidenavCard">
  <button id="navBurger" onclick="toggleSidenav()" title="collapse / expand sidebar"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 5 H17 M3 10 H17 M3 15 H17"/></svg></button>
  <nav id="sidenav">
    <button data-v="map" title="radar view"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="7"/><circle cx="10" cy="10" r="1.6" fill="currentColor" stroke="none"/></svg><span class="navt">Radar</span></span></button>
    <button data-v="devices" title="unique devices table in place of the radar"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="3" y="4" width="14" height="3" rx="1"/><rect x="3" y="9" width="14" height="3" rx="1"/><rect x="3" y="14" width="14" height="3" rx="1"/></svg><span class="navt">Devices</span></span> <b id="hd2">0</b></button>
    <button class="wifi-only" data-v="chan" style="display:none" title="radial graph of WiFi channels in use and device counts; click a channel for its SSIDs"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 10 L10 3 A7 7 0 0 1 16.5 13 Z"/><path d="M10 10 L4 6.5 A7 7 0 0 0 10 17 A7 7 0 0 0 16.5 13 Z"/></svg><span class="navt">Channel Density</span></span></button>
    <button class="wifi-only gps-only" data-v="trail" style="display:none" title="walked path connecting GPS-tagged sightings in time order (load a GPS session log via Settings &rarr; Data)"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15 C6 15 6 9 9 9 S12 5 17 5"/><circle cx="3" cy="15" r="1.3" fill="currentColor" stroke="none"/><circle cx="17" cy="5" r="1.3" fill="currentColor" stroke="none"/></svg><span class="navt">GPS Trail</span></span></button>
    <button class="wifi-only" data-v="deauth" style="display:none" title="authorisation activity across the air â€” deauth/disassoc events, plus captured 4-way handshakes &amp; PMKID"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 L16 5.5 V10 C16 14 13.4 16.6 10 17.5 C6.6 16.6 4 14 4 10 V5.5 Z"/></svg><span class="navt">Authorisations</span></span> <b id="hde2">0</b><span id="navSfDot" class="navdot" style="display:none" title="Send Frame running"></span></button>
    <button class="wifi-only" data-v="localap" style="display:none" title="spawn a local soft-AP + captive portal"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10" cy="14" r="1.6" fill="currentColor" stroke="none"/><path d="M6.5 11 a5 5 0 0 1 7 0"/><path d="M3.5 8 a9.2 9.2 0 0 1 13 0"/></svg><span class="navt">Local AP</span></span></button>
    <button class="wifi-only" data-v="frames" style="display:none" title="live 802.11 frame dump (Scout board) + build and send a from-scratch 802.11 frame, every header field editable"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 3 v3 M4 3 h3 M16 3 v3 M16 3 h-3 M4 17 v-3 M4 17 h3 M16 17 v-3 M16 17 h-3"/></svg><span class="navt">Frames</span></span></button>
    <button class="wifi-only scout-only" data-v="scout" style="display:none" title="live raw UART feed from the Scout board, plus scout link management (pause / flush)"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 17 V9"/><circle cx="10" cy="6" r="2.4"/><path d="M6.5 4 a5 5 0 0 0 0 4"/><path d="M13.5 4 a5 5 0 0 1 0 4"/></svg><span class="navt">Scout</span></span></button>
    <button class="sentinel-only" data-v="sentinel" style="display:none" title="Deauth/Karma/Rogue watch alerts from the last (or current) Sentinel session"><span class="navl"><svg class="navic" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10 C5.5 5.5 14.5 5.5 17 10 C14.5 14.5 5.5 14.5 3 10 Z"/><circle cx="10" cy="10" r="2"/></svg><span class="navt">Sentinel</span></span></button>
  </nav>
</div>
  <section id="view-map" class="view">
    <div class="vh"><span>PROXIMITY MAP <span class="c" id="hm">0</span></span>
      <button id="syncBtn" class="tgl icobtn" onclick="toggleSync()" title="sync search: mirror the DEVICES-list search filter onto the radar. Off = radar shows all, table filtered independently."><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 7 H5 M8 4 L5 7 L8 10"/><path d="M5 13 H15 M12 10 L15 13 L12 16"/></svg></button></div>
    <div id="radarWrap"><canvas id="radar"></canvas><div id="tip"></div>
      <div id="nodeMenu">
        <button id="nmInfo" class="nmc" onclick="nodeMenuInfo()" title="show info card">&#9432;</button>
        <button id="nmExpand" class="nmc" onclick="nodeMenuExpand()" title="expand stations on radar">&#8862;</button>
      </div>
      <div id="rctl">
        <button onclick="resetView()" title="reset / fit">&#9678;</button>
        <button id="spreadBtn" onclick="toggleSpread()" title="spread nodes so none overlap and all labels are readable">&#10021;</button>
        <button id="ghostBtn" onclick="toggleGhosts()" title="hide ghosts: drop devices no longer present (idle/inactive) from the radar">&#9676;</button>
        <button id="alogBtn" onclick="toggleAbsorbLog()" title="log of probes absorbed into an AP (confirmed associations). Off by default.">&#9776;</button>
        <button id="ringLegendBtn" onclick="toggleRingLegend()" title="ring colour legend">&#9432;</button>
        <button id="setBtn" onclick="toggleSettings()" title="radar controls">&#9881;</button>
        <button id="fsBtn" onclick="toggleFullscreen()" title="fullscreen radar"><svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M7 3H4a1 1 0 0 0-1 1v3M13 3h3a1 1 0 0 1 1 1v3M7 17H4a1 1 0 0 1-1-1v-3M13 17h3a1 1 0 0 0 1-1v-3"/></svg></button>
      </div>
      <div id="ringLegend" class="hidden">
        <div class="rlhd">RING COLOURS<button onclick="toggleRingLegend()" title="close">&times;</button></div>
        <div class="rlrow"><span class="rlstar" style="color:#4da3ff">&#9733;</span> radar focus / target marker</div>
        <div class="rlrow"><span class="rlring" style="border-color:#4da3ff"></span> box-selected (table filter)</div>
        <div class="rlrow wifi-only"><span class="rlring rlring3">
            <b style="border-color:#4dd6ff"></b><b style="border-color:#ffe14d"></b><b style="border-color:#ff9f40"></b>
          </span> AP client-count rank (low &rarr; high)</div>
        <div class="rlrow wifi-only"><span class="rlring" style="border-color:var(--whid);border-style:dashed"></span> cloaked network, name unknown</div>
        <div class="rlrow wifi-only"><span class="rlring" style="border-color:var(--whid)"></span> cloaked network, name recovered</div>
      </div>
      <div id="rband" title="Radar filter. Pick what the slider filters on (SIG / AGE / CNT / CH); default SIG = signal strength. Mouse-wheel over this bar adjusts the slider. Radar only.">
        <button id="bandModeBtn" onclick="toggleBandModes()" title="choose what to filter on"><span id="bandModeCur">SIG</span> &#9662;</button>
        <span id="bandModes">
          <button data-bm="sig" class="on" onclick="setBandMode('sig')" title="filter by SIGNAL: with a target, RSSI band (+/- dB) around it; with none, keep devices at or above -N dBm">SIG</button>
          <button data-bm="seen" onclick="setBandMode('seen')" title="filter by SEEN: hide devices last seen more than N seconds ago (recency). Ceiling = oldest sighting.">SEEN</button>
          <button data-bm="age" onclick="setBandMode('age')" title="filter by AGE: keep devices alive at least N seconds (accumulative lifetime = last seen âˆ’ first seen). Ceiling = longest-lived record.">AGE</button>
          <button data-bm="cnt" onclick="setBandMode('cnt')" title="filter by COUNT: hide devices with fewer than N received frames/adverts">CNT</button>
          <button data-bm="ch" class="wifi-only" onclick="setBandMode('ch')" title="filter by CHANNEL: show only devices heard on channel N (0 = all)">CH</button>
          <button data-bm="gps" class="gps-only" style="display:none" onclick="setBandMode('gps')" title="filter by GPS DISTANCE: keep devices within N metres of the GPS focus point (set one via a device's Actions menu). Only appears when the loaded data carries GPS coordinates (GPS session log replay).">GPS</button>
        </span>
        <span id="bandLbl">signal range &plusmn;</span>
        <input type="range" id="band" min="0" max="100" value="100" step="1"
               oninput="onBandInput()">
        <b id="bandL">100</b><span id="bandUnit">dB</span>
      </div>
      <div id="alog" class="hidden">
        <div class="alhd">
          <span class="alhdTitle">ASSOCIATED PROBES <span id="nalog">0</span></span>
          <span class="alhdBtns">
            <button id="alogMaxBtn" onclick="toggleAbsorbLogMax()" title="maximise">&#10530;</button>
            <button onclick="toggleAbsorbLog()" title="close">&times;</button>
          </span>
        </div>
        <div id="alist"></div>
      </div>
      <div id="rmodal" class="hidden">
       <div class="rmbox">
        <div class="rmhd">RADAR CONTROLS
          <button id="rmclose" onclick="closeSettings()" title="close (unlock zoom)">&times;</button></div>
      <div class="rmsec first">Display</div>
      <div class="rlegend">
        <button id="lname" class="tgl on" onclick="tgl('lname')" title="show device names on the radar">Show names</button>
        <button id="lmac" class="tgl on" onclick="tgl('lmac')" title="show MAC addresses on the radar">Show MACs</button>
        <button id="sweepBtn" class="tgl" onclick="toggleSweep()" title="rotating radar sweep -- nodes glow as the beam detects them, like a real radar (off by default)">Sweep</button>
      </div>
      <div class="rmsec">Filters</div>
      <div class="rlegend">
        <label title="only plot nodes whose frame/advert count (cnt) is at least this">Min count
          <input type="range" id="mincnt" min="1" max="50" value="1" step="1"
                 oninput="mincntL.textContent=this.value;drawRadar(lastDevs)">
          <b id="mincntL">1</b></label>
        <button onclick="resetFilters()" title="restore default filters: min count 1, expire idle 60 s">Reset</button>
      </div>
      <div class="rmsec wifi-only">Stations</div>
      <div class="rlegend wifi-only">
        <button id="autoExpandBtn" class="tgl" onclick="toggleAutoExpand()" title="auto-explode every AP that has associated clients into its long-press station view; grows live as new stations join. Turning this off collapses everything back">Auto-expand stations</button>
      </div>
      <div class="rlegend"><span class="muted">rings = RSSI (dBm), strong toward
        centre; 1 antenna &rarr; no real bearing, angle = stable per-MAC slot</span></div>
       </div>
      </div>
    </div>
    <div id="rkey" title="click a swatch to hide/show that class on the radar">
      <span class="wifi-only" style="display:none" data-rk="wbeacon" onclick="toggleKey('wbeacon',this)"><span class="dot" style="background:var(--pub)"></span> beacon (AP)</span>
      <span class="wifi-only" style="display:none" data-rk="wbcnCli" onclick="toggleKey('wbcnCli',this)"><span class="dot" style="background:var(--cli)"></span> beacon + clients</span>
      <span class="wifi-only" style="display:none" data-rk="wprobe" onclick="toggleKey('wprobe',this)"><span class="dot" style="background:var(--rnd)"></span> probe (client)</span>
      <span class="wifi-only" style="display:none" data-rk="whidden" onclick="toggleKey('whidden',this)" title="cloaked APs -- click to hide/show"><span class="dot ghostdot"></span> hidden network</span>
    </div>
  </section>
  <section id="view-devices" class="view">
    <div class="vh"><span id="devTitle">
      <button id="devSearchBtn" class="cbtn icobtn" onclick="toggleDevSearch()" title="search devices â€” plain text matches name/SSID; a value with colons (aa:bb:cc) matches MAC; field:value filters e.g. vendor:netgear  rssi:>-60  type:rnd  kind:beacon  ch:6  sta:>0 (space = AND)"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="9" r="6"/><line x1="13.5" y1="13.5" x2="18" y2="18"/></svg></button>
      <button id="syncDevBtn" class="tgl icobtn" onclick="toggleSyncDev()" title="sync from radar: show only the devices currently plotted on the proximity map (applies the radar's filters â€” min-count, signal band, kind, etc. â€” to this list)."><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 7 H5 M8 4 L5 7 L8 10"/><path d="M5 13 H15 M12 10 L15 13 L12 16"/></svg></button>
      <span id="wifiDevCtl">
        <button id="wifiFilterBtn" class="tgl icobtn" onclick="toggleWifiFilters()" title="filter by frame kind â€” BEACON / STA / PROBE"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h14l-5.5 6.5v5L9 17v-6.5z"/></svg></button>
        <button id="expandAllBtn" class="tgl icobtn" onclick="toggleExpandAllStations()" title="expand every AP's associated stations at once"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8 L10 12 L14 8"/></svg></button>
      </span>

      <span class="vstyle">
        <button id="vwToggle" class="tgl icobtn" onclick="toggleDevView()" title="card view - compact tiles that wrap to fit the screen, no horizontal scroll"><svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><rect x="3" y="3" width="14" height="6" rx="1.5"/><rect x="3" y="11" width="14" height="6" rx="1.5"/></svg></button>
      </span></span>
    </div>
    <div id="devSearchPop" class="dsearch" style="display:none">
      <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="9" r="6"/><line x1="13.5" y1="13.5" x2="18" y2="18"/></svg>
      <input id="devSearch" type="text" spellcheck="false" autocomplete="off" oninput="renderDevices();if(syncSearch)drawRadar(lastDevs);quickTick()"
             placeholder="name  Â·  aa:bb:cc  Â·  vendor:netgear  rssi:>-60  kind:beacon  sta:>0  ch:6">
      <button id="devSearchClr" onclick="clearDevSearch()" title="clear search">&times;</button>
    </div>
    <div id="wifiFilterPop" class="wfilter" style="display:none">
      <button data-wk="beacon" class="tgl on" onclick="toggleWifiKind('beacon')" title="show beacon frames from access points with NO associated stations">BEACON</button>
      <button data-wk="sta" class="tgl on" onclick="toggleWifiKind('sta')" title="show beacon frames from access points that HAVE associated stations (clients)">STA</button>
      <button data-wk="probe" class="tgl" onclick="toggleWifiKind('probe')" title="show probe-request frames (clients searching for a named network)">PROBE</button>
      <span class="wfilter-sep"></span>
      <button data-wk="hid" class="tgl" onclick="toggleWifiKind('hid')" title="show APs still cloaked (no name recovered yet)">HIDDEN</button>
      <button data-wk="unc" class="tgl on" onclick="toggleWifiKind('unc')" title="show APs that were cloaked and have since had their name recovered">UNCLOAKED</button>
      <span class="wfilter-sep"></span>
      <button id="wifiFilterClr" class="icobtn" onclick="resetWifiFilters()" title="reset filters â€” show everything">&times;</button>
    </div>
    <div id="dfbar" class="dfbar" style="display:none"></div>
    <div id="dtWrap" class="scroll"><table id="dt"><thead><tr>
      <th>REF</th><th data-k="mac">MAC</th><th data-k="type">TYPE</th><th data-k="rssi">RSSI</th>
      <th data-k="age">AGE</th>
      <th data-k="life">ALIVE</th><th data-k="vendor">VENDOR</th><th data-k="name">NAME</th>
    </tr></thead><tbody></tbody></table></div>
    <div id="dcards" class="cards" style="display:none"></div>
  </section>
  <section id="view-scout" class="view wifi-only">
    <div class="vh scout-hd"><span>SCOUT</span>
      <div class="scout-subtabs">
        <button id="scoutSubFeed" class="on" onclick="scoutSubTab('feed')">Feed</button>
        <button id="scoutSubMgmt" onclick="scoutSubTab('mgmt')">Management</button>
      </div>
      <span id="scoutViewPill" class="statuspill down scout-vh-pill"><span class="dot"></span>Not detected</span>
    </div>
    <div id="scoutSubFeedPane">
      <div class="scout-feedbar">
        <span id="scoutStat" class="muted">&mdash;</span>
        <button class="cbtn" id="scoutPause" title="pause / resume auto-scroll" onclick="toggleScoutScroll(this)">&#9208;</button>
      </div>
      <div id="scoutFeed" class="scoutfeed"></div>
    </div>
    <div id="scoutSubMgmtPane" class="scout-mgmt" style="display:none">
      <div class="scout-mcard">
        <span class="scm-ic"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10a6 6 0 0 1 12 0M7 10a3 3 0 0 1 6 0"/><circle cx="10" cy="10" r="1.2" fill="currentColor" stroke="none"/></svg></span>
        <span class="scm-body">
          <span class="scm-title">Link</span>
          <span class="scm-sub">Idle by default -- the scout stays out of promiscuous mode until armed. Stopped means it's a bare, cheap UART pipe, not sniffing.</span>
        </span>
        <span class="scm-act"><button id="scoutMgmtPauseBtn" class="tgl" onclick="toggleScoutPause('scoutMgmtPauseBtn')">Pause link</button></span>
      </div>
      <div class="scout-mcard">
        <span class="scm-ic"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h12M4 10h12M4 15h8"/></svg></span>
        <span class="scm-body">
          <span class="scm-title">Buffers</span>
          <span class="scm-sub">Drop whatever's still queued in the scout's TX buffer and this side's stale RX bytes, then resync on a clean line.</span>
        </span>
        <span class="scm-act"><button id="scoutMgmtFlushBtn" class="iconbtn" onclick="flushScout('scoutMgmtFlushBtn')">Flush</button></span>
      </div>
      <div class="sethint">Channel set, frame types, DATA-frame capture and band pausing stay in the WiFi capture popover's Scout tab.</div>
    </div>
  </section>
  <section id="view-chan" class="view wifi-only">
    <div class="vh"><span>CHANNEL&nbsp;DENSITY <span class="c" id="hcn">0</span></span>
      <span id="chanBandTabs" class="captabs" style="display:none;max-width:170px;margin:0 0 0 10px" title="Dual-band scout linked â€” pick which radio's channels to chart.">
        <button id="cbtab24" class="captab on" onclick="setChanBand('24')">2.4GHz</button>
        <button id="cbtab5"  class="captab"    onclick="setChanBand('5')">5GHz</button>
      </span>
      <span class="muted" style="font-size:12px">tap a channel for its SSIDs</span>
    </div>
    <div id="chanWrap">
      <canvas id="chanCanvas"></canvas>
      <div id="chanDetail"><span class="cd-hint">No channel selected &mdash; tap a wedge to list its networks.</span></div>
    </div>
  </section>
  <section id="view-trail" class="view wifi-only gps-only">
    <div class="vh"><span>GPS TRAIL <span class="c" id="htr" style="margin-left:10px">0</span></span>
      <span class="muted" style="font-size:12px;margin-left:14px">GPS-tagged sightings</span>
      <span class="muted" id="trailStart" style="font-size:12px;margin-left:auto"></span>
    </div>
    <div id="trailWrap">
      <div class="scroll" style="flex:1"><table id="trailTbl"><thead><tr>
        <th data-k="ssid">NAME / SSID</th><th data-k="kind">KIND</th><th data-k="rssi">RSSI</th>
        <th data-k="lat">LAT</th><th data-k="lon">LON</th><th>MAP</th>
        <th data-k="_dist" title="distance from the previous sighting">DIST</th>
        <th data-k="vendor">VENDOR</th>
      </tr></thead><tbody></tbody></table></div>
      <div class="muted" id="trailEnd" style="font-size:12px;text-align:right;padding:4px 2px 0"></div>
      <div id="trailEmpty" style="display:none">No GPS-tagged sightings loaded &mdash; load a GPS session log via Settings &rarr; Data.</div>
    </div>
  </section>
  <section id="view-deauth" class="view wifi-only">
    <div class="vh"><span>AUTHORISATIONS</span>
      <button id="wifiFilterBtn2" class="tgl icobtn" style="margin-left:auto" onclick="toggleWifiFilters('wifiFilterPop2','wifiFilterBtn2')" title="filter by target-AP kind â€” BEACON / STA / HIDDEN / UNCLOAKED (shared with the Devices filter)"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h14l-5.5 6.5v5L9 17v-6.5z"/></svg></button>
    </div>
    <div id="wifiFilterPop2" class="wfilter" style="display:none">
      <button data-wk="beacon" class="tgl on" onclick="toggleWifiKind('beacon')" title="show deauths targeting an AP with NO associated stations">BEACON</button>
      <button data-wk="sta" class="tgl on" onclick="toggleWifiKind('sta')" title="show deauths targeting an AP that HAS associated stations (clients)">STA</button>
      <span class="wfilter-sep"></span>
      <button data-wk="hid" class="tgl" onclick="toggleWifiKind('hid')" title="show deauths targeting an AP still cloaked (no name recovered yet)">HIDDEN</button>
      <button data-wk="unc" class="tgl on" onclick="toggleWifiKind('unc')" title="show deauths targeting an AP that was cloaked and has since had its name recovered">UNCLOAKED</button>
      <span class="wfilter-sep"></span>
      <button id="wifiFilterClr2" class="icobtn" onclick="resetWifiFilters()" title="reset filters â€” show everything">&times;</button>
    </div>
    <div class="authbody">
    <div id="authSum" class="authsum"></div>
    <div id="deauthSec">
    <div class="authsub"><span>DEAUTH&nbsp;/ DISASSOC <span class="c" id="hdc">0</span></span></div>
    <div class="scroll"><table id="det"><thead><tr>
      <th data-k="age">AGE</th><th data-k="type">TYPE</th><th data-k="src">SRC (tx)</th>
      <th data-k="dst">DST (target)</th><th data-k="bssid">TARGET AP</th>
      <th data-k="reason">REASON</th><th data-k="cnt">CNT</th><th data-k="rssi">RSSI</th>
    </tr></thead><tbody></tbody></table></div>
    </div>
    <div id="deauthEmpty" class="muted authempty" style="display:none">No deauth/disassoc frames seen.</div>
  </div>
  </section>
  <section id="view-sentinel" class="view sentinel-only">
    <div class="vh"><span>SENTINEL <span class="muted" style="font-size:12px;font-weight:400" id="sentinelViewStatus"></span></span>
      <button class="icobtn" onclick="requestSentinelClearAll()" title="Wipe every watch's accumulated alert state (deauth map, karma session, rogue hits) without stopping the session">Clear all</button>
    </div>
    <div id="sentinelViewMsgs"></div>
  </section>
  <section id="view-localap" class="view wifi-only">
    <div class="vh"><span>LOCAL AP &amp; CAPTIVE PORTAL</span>
    </div>
    <div class="setsec">
      <div class="authsum" id="localApStatusBar">
        <div class="stattile"><span class="v" id="localApScoutPill"><span class="statuspill down"><span class="dot"></span>Not detected</span></span><span class="l">Scout board</span></div>
        <div class="stattile"><span class="v" id="localApStatus">Idle</span><span class="l">Status</span></div>
      </div>

      <!-- Network/Portal are visually locked (not hidden) while a run is up
           -- see .running in the stylesheet -- since the combined layout
           keeps every pane on screen at once; Start/Stop is a single icon
           toggle in the SSID bar (#localApGoBtn) instead of a separate
           Start block + Stop row (see localApSyncActiveUi). -->
      <div id="localApSetupWrap" style="margin-top:16px">
        <div class="localaptabs" id="localApTabs">
          <button class="localaptab on" data-rtab="network" onclick="setLocalApTab('network')">Setup</button>
          <button class="localaptab" id="localApPortalTab" data-rtab="portal" style="display:none" onclick="setLocalApTab('portal')">Captive Portal</button>
          <button class="localaptab lap-tab-empty" id="localApCapturedTab" data-rtab="captured" onclick="setLocalApTab('captured')">Captured <span class="badge" id="localApFieldCount2">(0)</span></button>
          <button class="localaptab lap-tab-empty" id="localApConnTab" data-rtab="connections" onclick="setLocalApTab('connections')">Connections <span class="badge" id="localApStaCount2">(0)</span></button>
        </div>

        <!-- SSID + security + duration + the portal-customise switch all live
             in one box now (used to be split Network/Launch tabs) -- only
             #localApConfigFields locks while running (see .running below),
             never the Run/Stop control itself. -->
        <div class="localapsub-pane" data-rtab="network">
          <div class="lap-hd"><span class="dot" style="background:var(--accent)"></span>Setup</div>
          <div id="localApConfigFields">
            <div class="lap-bar">
              <svg class="lap-bar-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1" fill="currentColor" stroke="none"/></svg>
              <input type="text" id="localApSsid" maxlength="32" placeholder="Beacon SSID (e.g. Guest Network)">
              <div class="lap-seg" id="localApSecSeg">
                <button type="button" class="lap-seg-opt on" data-sec="open" onclick="localApSetSec('open')">Open</button>
                <button type="button" class="lap-seg-opt" data-sec="wpa2" onclick="localApSetSec('wpa2')">WPA2</button>
                <span class="lap-seg-bezel"></span>
              </div>
              <input type="hidden" id="localApSecValue" value="open">
              <button id="localApGoBtn" class="lap-go-icon" onclick="localApToggle()" title="Start Local AP" aria-label="Start Local AP">
                <svg id="localApGoIcon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="setrow lap-pass-row" id="localApSecPassRow" style="display:none">
              <span class="k">WPA2 password</span>
              <span class="v"><input type="text" id="localApSecPass" maxlength="63" placeholder="8-63 characters"></span>
            </div>
            <div class="lap-row2">
              <div class="setrow lap-duration">
                <span class="k">Duration</span>
                <span class="v"><input type="range" id="localApSecs" min="30" max="1800" value="120" step="30"
                      oninput="localApSecsInput()"> <b id="localApSecsL">2m</b></span>
              </div>
              <div class="setrow lap-toggle-row">
                <span class="k">Hidden network</span>
                <span class="v"><label class="lap-toggle"><input type="checkbox" id="localApHidden"><span class="lap-toggle-bezel"></span></label></span>
              </div>
              <div class="setrow lap-toggle-row">
                <span class="k">Customise portal page</span>
                <span class="v"><label class="lap-toggle"><input type="checkbox" id="localApPortalToggle" onchange="localApPortalToggleChanged()"><span class="lap-toggle-bezel"></span></label></span>
              </div>
            </div>
          </div>
          <div id="localApMsg" class="sethint" style="min-height:1em"></div>
        </div>

        <!-- Hidden until "Customise portal page" is switched on -- the AP
             always serves a portal page (LOCALAP_DEFAULT_HTML if never
             customised); this box is only for editing it, not a feature
             on/off switch. -->
        <div class="localapsub-pane" id="localApPortalPane" data-rtab="portal" style="display:none">
          <div class="lap-hd"><span class="dot" style="background:var(--muted)"></span>Captive Portal</div>
          <div class="setrow">
            <span class="k">Upload page</span>
            <span class="v"><button onclick="document.getElementById('localApHtmlFile').click()">&#8593;&nbsp;Choose file&hellip;</button>
              <input type="file" id="localApHtmlFile" accept=".html,.htm,text/html" onchange="localApImportHtml(this)" hidden></span>
          </div>
          <div id="localApImportStatus" class="sethint" style="min-height:1em"></div>
          <div class="setrow localap-html">
            <span class="k">Portal page</span>
            <span class="v"><textarea id="localApPortalHtml" spellcheck="false"
                  style="font-family:monospace;font-size:12px;background:var(--bg);color:var(--fg);border:1px solid var(--line)"></textarea></span>
          </div>
        </div>

        <div class="localapsub-pane" data-rtab="captured" style="display:none">
          <div class="lap-hd"><span class="lap-ic lap-dot" id="localApCapturedDot"></span>Captured submissions</div>
          <div class="setsec-hd">Captured events <span id="localApFieldCount">(0)</span></div>
          <div id="localApFieldList">Nothing captured yet â€” start the AP above to begin.</div>
        </div>

        <!-- A bare STA join (no form ever submitted) is logged separately
             from a real portal-form submission -- see localApIsConnectRow. -->
        <div class="localapsub-pane" data-rtab="connections" style="display:none">
          <div class="lap-hd"><span class="lap-ic lap-dot" id="localApConnDot"></span>Connections</div>
          <div class="setsec-hd">Stations joined <span id="localApStaCount">(0)</span></div>
          <div id="localApConnList">No connections yet â€” start the AP above to begin.</div>
        </div>
      </div>
    </div>
  </section>
  <section id="view-frames" class="view wifi-only">
    <div class="vh"><span>FRAMES</span>
      <span id="framesStat" class="muted" style="margin-left:auto;font-size:12px">&mdash;</span>
    </div>
    <div id="framesTabWrap">
      <div class="localaptabs" id="framesTabs">
        <button class="localaptab on" data-rtab="capture" onclick="setFramesTab('capture')">Capture</button>
        <button class="localaptab" data-rtab="craft" onclick="setFramesTab('craft')">Craft</button>
      </div>
      <div class="localapsub-pane" data-rtab="capture">
        <div class="vh" style="padding:0 0 8px">
          <button class="iconbtn" id="framesClearBtn" title="clear screen â€” drops the buffered rows shown here; the live stream keeps running" onclick="clearFramesFeed()">Clear</button>
          <button class="cbtn" id="framesPause" title="pause / resume auto-scroll" onclick="toggleFramesScroll(this)">&#9208;</button>
        </div>
        <div class="frameFilters">
          <button id="ffBeacon" class="tgl on" onclick="toggleFrameKind('ffBeacon')">Beacon</button>
          <button id="ffProbe"  class="tgl on" onclick="toggleFrameKind('ffProbe')">Probe</button>
          <button id="ffAssoc"  class="tgl on" onclick="toggleFrameKind('ffAssoc')">Assoc</button>
          <button id="ffDeauth" class="tgl on" onclick="toggleFrameKind('ffDeauth')">Deauth</button>
          <button id="ffData"   class="tgl on" onclick="toggleFrameKind('ffData')" title="unencrypted (open) DATA frames only â€” nothing readable in an encrypted one">Data <span class="muted">(open only)</span></button>
          <input id="framesSearch" class="ffsearch" type="text" spellcheck="false" autocomplete="off"
                 placeholder="searchâ€¦" oninput="onFrameSearch(this.value)"
                 title="matches mac/dst/bssid, SSID and the open-DATA ascii dump â€” plain substring, no server round trip">
          <button id="framesSearchClr" onclick="clearFrameSearch()" title="clear search">&times;</button>
          <span class="framesModeRow" style="margin-left:auto;display:flex;align-items:center;gap:4px">
            <button id="framesModeSimple" class="tgl on" onclick="setFramesMode('simple')" title="small live ring buffer, pushed continuously as frames arrive">Simple</button>
            <button id="framesModeDetail" class="tgl" onclick="setFramesMode('detail')" title="buffers every matching frame â€” full raw bytes included â€” in memory for the run, then delivers + frees it all in one drain when the run ends. Local radio only (no scout).">Detailed</button>
          </span>
          <span class="framesSecsRow" style="display:none;align-items:center;gap:6px">
            <span class="muted" style="font-size:12px">No scout â€” dumps on this board's own radio (AP offline for the window)</span>
            <input type="range" id="framesSecs" min="5" max="60" value="30" step="5"
                   oninput="document.getElementById('framesSecsLbl').textContent=fmtDur(+this.value)">
            <b id="framesSecsLbl">30s</b>
          </span>
          <button id="framesArmBtn" class="tgl" onclick="toggleFramesArm()" title="start/stop the raw frame dump â€” independent of the Scout link pause">Start</button>
        </div>
        <div id="framesFeed" class="scoutfeed"></div>
      </div>
      <div class="localapsub-pane" data-rtab="craft" style="display:none">
    <div class="setsec fc-setsec">
      <div class="authsum">
        <div class="stattile"><span class="v" id="fcStatusPill"><span class="statuspill down"><span class="dot"></span>Idle</span></span><span class="l">Status</span></div>
        <div class="stattile"><span class="v" id="fcTally">0 / 0</span><span class="l">Sent / OK</span></div>
      </div>

      <div class="fc-anatomy-wrap">
        <div class="fc-anatomy" id="fcAnatomy"></div>
        <div class="fc-anatomy-meta" id="fcAnatomyMeta"></div>
      </div>

      <div class="lap-hd" style="margin-top:22px"><span class="dot" style="background:var(--accent)"></span>Frame type</div>
      <div class="fc-chips" id="fcPresets"></div>
      <div class="fc-addr-grid" style="margin-top:14px;max-width:420px">
        <div class="fc-addr-field"><label for="fcCat">Category</label>
          <select id="fcCat" onchange="onFcCatChange()">
            <option value="0">Management (0)</option>
            <option value="1">Control (1)</option>
            <option value="2">Data (2)</option>
          </select></div>
        <div class="fc-addr-field"><label for="fcSub">Subtype</label>
          <select id="fcSub" onchange="onFcRawChange()"></select></div>
      </div>
      <div class="sethint" id="fcTypeHint" style="min-height:1em"></div>

      <div id="fcIePanel" style="display:none">
        <div class="lap-hd fc-sec"><span class="dot" style="background:var(--muted)"></span>SSID + information elements</div>
        <div class="sethint">Auto-built body for Beacon/Probe-Req/Probe-Resp -- toggle which IEs ride along, override a declared length for malformed-frame testing, or pick a preset/custom payload.</div>
        <div id="fcIeRows"></div>
      </div>

      <div class="lap-hd fc-sec"><span class="dot" style="background:var(--muted)"></span>Addressing</div>
      <div class="fc-addr-grid">
        <div class="fc-addr-field"><label for="fcA1">Addr1 -- destination</label>
          <input type="text" id="fcA1" placeholder="aa:bb:cc:dd:ee:ff" value="ff:ff:ff:ff:ff:ff"></div>
        <div class="fc-addr-field" id="fcA2Field"><label for="fcA2">Addr2 -- source</label>
          <input type="text" id="fcA2" placeholder="aa:bb:cc:dd:ee:ff" oninput="fcSyncAddr3Default();fcRenderAnatomy()">
          <div class="fc-cap">This board's own MAC if left blank on transmit.</div></div>
        <div class="fc-addr-field" id="fcA3Field"><label for="fcA3">Addr3 -- BSSID</label>
          <input type="text" id="fcA3" placeholder="aa:bb:cc:dd:ee:ff" oninput="fcAddr3Touched=true;fcRenderAnatomy()">
          <div class="fc-cap">Blank omits the field from the built frame.</div></div>
        <div class="fc-addr-field" id="fcA4Field"><label for="fcA4">Addr4</label>
          <input type="text" id="fcA4" placeholder="aa:bb:cc:dd:ee:ff" oninput="fcRenderAnatomy()">
          <div class="fc-cap">WDS only (toDS + fromDS). Blank omits it.</div></div>
      </div>

      <div class="lap-hd fc-sec"><span class="dot" style="background:var(--muted)"></span>Flags <span class="fc-byteval" id="fcFlagsByte">0x00</span></div>
      <div class="fc-bits" id="fcFlags">
        <button type="button" class="fc-bit" data-flag="fcOrder" data-bit="7" title="Strictly Ordered" onclick="toggleFcFlag(this)"><b>b7</b>OR</button>
        <button type="button" class="fc-bit" data-flag="fcProt" data-bit="6" title="Protected Frame" onclick="toggleFcFlag(this)"><b>b6</b>PR</button>
        <button type="button" class="fc-bit" data-flag="fcMData" data-bit="5" title="More Data" onclick="toggleFcFlag(this)"><b>b5</b>MD</button>
        <button type="button" class="fc-bit" data-flag="fcPwr" data-bit="4" title="Power Mgmt" onclick="toggleFcFlag(this)"><b>b4</b>PM</button>
        <button type="button" class="fc-bit" data-flag="fcRetry" data-bit="3" title="Retry" onclick="toggleFcFlag(this)"><b>b3</b>RT</button>
        <button type="button" class="fc-bit" data-flag="fcMFrag" data-bit="2" title="More Fragments" onclick="toggleFcFlag(this)"><b>b2</b>MF</button>
        <button type="button" class="fc-bit" data-flag="fcFromDs" data-bit="1" title="From DS" onclick="toggleFcFlag(this)"><b>b1</b>FD</button>
        <button type="button" class="fc-bit" data-flag="fcToDs" data-bit="0" title="To DS" onclick="toggleFcFlag(this)"><b>b0</b>TD</button>
      </div>
      <div class="sethint">Frame Control, octet 2, MSB to LSB -- click a bit to flip it.</div>

      <div class="lap-hd fc-sec"><span class="dot" style="background:var(--muted)"></span>Duration, sequence, QoS, raw payload</div>
      <div class="setrow"><span class="k">Duration/ID (802.11, &#181;s)</span><span class="v">
        <input type="number" id="fcDur" value="0" min="0" max="65535"></span></div>
      <div class="setrow" id="fcSeqRow"><span class="k">Sequence</span><span class="v">
        <input type="number" id="fcSeq" min="0" max="4095" placeholder="blank = omit" oninput="fcRenderAnatomy()"></span></div>
      <div class="setrow" id="fcQosRow"><span class="k">QoS control</span><span class="v">
        <input type="number" id="fcQos" min="0" max="65535" placeholder="blank = omit" oninput="fcRenderAnatomy()"></span></div>
      <div class="setrow" id="fcBodyRow"><span class="k">Payload (hex)</span><span class="v">
        <div id="fcBodyPresets" style="display:none;margin-bottom:6px">
          <select id="fcBodyPresetSel" onchange="fcApplyBodyPreset(this)" style="max-width:100%">
            <option value="">-- preset --</option>
          </select>
        </div>
        <textarea id="fcBody" rows="3" placeholder="hex bytes, e.g. 0201" style="width:100%;font-family:monospace" oninput="fcSanitizeBody(this);fcRenderAnatomy()"></textarea>
        <label class="fc-cap" style="display:inline-block;margin-top:4px;cursor:pointer">
          Upload file as payload...
          <input type="file" id="fcBodyFile" style="display:none" onchange="fcLoadBodyFile(this)">
        </label></span></div>

      <div class="lap-hd fc-sec"><span class="dot" style="background:var(--accent)"></span>Wire preview</div>
      <div class="sethint">Exact bytes buildRawFrame() assembles right now, updated live.</div>
      <div class="fc-hexdump" id="fcHexDump"></div>

      <div class="lap-hd fc-sec"><span class="dot" style="background:var(--accent)"></span>Run</div>
      <div class="fc-run-bar">
        <div class="setrow"><span class="k">Channel</span><span class="v">
          <input type="number" id="fcChannel" value="1" min="1" max="13"></span></div>
        <div class="setrow"><span class="k">Interval</span><span class="v">
          <input type="number" id="fcInterval" value="200" min="50" max="10000"> ms</span></div>
        <div class="setrow" id="fcSecsRow"><span class="k">Send duration</span><span class="v">
          <input type="range" id="fcSecs" min="5" max="60" value="15" step="5"
                 oninput="document.getElementById('fcSecsLbl').textContent=fmtDur(+this.value)">
          <b id="fcSecsLbl">15s</b></span></div>
        <button id="fcGoBtn" class="lap-go-icon" onclick="toggleFrameCraft()" title="Start Frame Crafting" aria-label="Start Frame Crafting">
          <svg id="fcGoIcon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </div>
      <div class="sethint" id="fcStatus" style="min-height:1em"></div>
    </div>
    </div>
    </div>
  </section>
</main>
<div id="capruns" class="capruns">
  <div class="cr-ring">
    <svg viewBox="0 0 120 120">
      <circle class="cr-track" cx="60" cy="60" r="52"/>
      <circle id="crArc" class="cr-arc" cx="60" cy="60" r="52"/>
    </svg>
    <div class="cr-num"><b id="crLeft">0</b><span>seconds</span></div>
  </div>
  <div class="cr-title" id="crTitle">WiFi&nbsp;capture in progress</div>
  <div id="crParams" class="cr-params"></div>
  <div id="crSub" class="cr-sub" style="display:none"></div>
  <div id="capQrWrap" class="cr-qr-wrap" style="display:none">
    <button type="button" id="capQrFrame" class="qr-frame" onclick="toggleQrBlur('capQrFrame')">
      <img id="capQrImg" class="cr-qr" alt="Scan to rejoin this network">
      <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
    </button>
    <button type="button" class="cr-copy-btn" id="capCopyBtn" onclick="copyApPass('capCopyBtn')">Copy password</button>
  </div>
</div>
<!-- Persistent "lost the AP" overlay -- distinct from #capruns above (which
     only covers the timed-capture WINDOW itself). Shown any time the socket
     fails to reconnect for a while, whatever the cause (this capture's hop
     ended but the phone's OS didn't auto-rejoin a hidden net, walked out of
     range, etc) -- see wsFailStreak/showApLost in the script below. Reuses
     the AP-join QR (/api/network/apqr) -- rejoining 802Eleven itself, never
     the Settings > Uplink STA network. -->
<div id="aplost" class="capruns">
  <button type="button" class="cr-close" onclick="dismissApLost()" title="Close (view cached results while disconnected)" aria-label="Close">&times;</button>
  <div class="cr-title" style="color:#e2b93b">Reconnecting to 802Eleven&hellip;</div>
  <div class="cr-sub">This device dropped off 802Eleven's own WiFi &mdash; scan or copy below to rejoin.<br>
    The dashboard resumes on its own the moment you're back on.</div>
  <div class="cr-qr-wrap">
    <button type="button" id="aplostQrFrame" class="qr-frame" onclick="toggleQrBlur('aplostQrFrame')">
      <img id="aplostQrImg" class="cr-qr" alt="Scan to rejoin 802Eleven">
      <span class="qr-reveal">Tap to reveal<br>(WPA2 password visible)</span>
    </button>
    <button type="button" class="cr-copy-btn" id="aplostCopyBtn" onclick="copyApPass('aplostCopyBtn')">Copy password</button>
  </div>
</div>
<script>
/*LITE0*/let LITE_MODE=false;/*LITE1*/
(function(){const _f=window.fetch;
  /* sscsrf is only refreshed by GET / (per-boot token). After a device reboot or
     login the open page holds a stale token -> 403 csrf. Refetch / to re-issue
     the cookie and retry the rejected request once (a 403 csrf never ran it). */
  const withCsrf=(u,o)=>{const h=new Headers(o.headers||{});
    const m=document.cookie.match(/(?:^|; )sscsrf=([^;]+)/);
    if(m)h.set('X-CSRF-Token',decodeURIComponent(m[1]));
    return Object.assign({},o,{headers:h});};
  /* Retry wrapper: a request with no response (network error / timeout) is retried
     up to REQ_MAX_RETRIES times. After that the AP-rejoin QR overlay (#aplost) is shown
     and further requests stop retrying (one attempt each) until one succeeds. HTTP
     status replies are never retried. Skipped entirely in offline/imported viewing. */
  let reqFailStreak=0, reqLostTripped=false;
  const REQ_MAX_RETRIES=5, REQ_RETRY_MS=400, REQ_TIMEOUT_MS=5000;
  const sendOnce=(u,o)=>{ if(o.signal)return _f(u,o);
    const c=new AbortController(); const t=setTimeout(()=>c.abort(),REQ_TIMEOUT_MS);
    return _f(u,Object.assign({},o,{signal:c.signal})).finally(()=>clearTimeout(t)); };
  const offlineView=()=>{try{return !liveOn||!!importedSnap;}catch(e){return false;}};
  const sendRetry=async(u,o)=>{
    if(offlineView())return _f(u,o);
    const max=reqLostTripped?1:REQ_MAX_RETRIES;
    let lastErr=null;
    for(let i=0;i<max;i++){
      if(i)await new Promise(res=>setTimeout(res,REQ_RETRY_MS*i));
      try{
        const r=await sendOnce(u,o);
        reqFailStreak=0;
        if(reqLostTripped){reqLostTripped=false; hideApLost();}
        return r;
      }catch(e){lastErr=e; reqFailStreak++;}
    }
    if(!reqLostTripped&&reqFailStreak>=REQ_MAX_RETRIES){reqLostTripped=true; showApLost();}
    throw lastErr;
  };
  window.fetch=async function(u,o){o=o||{};
    let r=await sendRetry(u,withCsrf(u,o));
    if(r.status===403&&!o._csrfRetry){
      try{await _f('/',{cache:'no-store'});}catch(e){return r;}
      const n=Object.assign({},o,{_csrfRetry:true});
      r=await sendRetry(u,withCsrf(u,n));
    }
    return r;};})();
let dSort={k:'rssi',dir:-1};
let seenD={};
let selMac=null, devRowOrder=[];
let devView='table';
let refMac=localStorage.getItem('refMac')||null, lastDevs=[];
let lastWifi=[], lastDeauth=[], lastHandshake=[], pmkOnly=false;
let rogueByMac=new Map();
let preCaptureMacs=null, newWifiMacs=new Set();
let preCaptureStationMacs=null, newStationMacs=new Set();
let importedSnap=null;
let onlyNear=!!refMac;
let gpsFocus=null, gpsCoordsAvailable=false;
/**
 * Great-circle distance between two lat/lon pairs (haversine formula),
 * mirroring the firmware's GnssModule::distanceM.
 * @returns Distance in metres.
 */
function haversineM(lat1,lon1,lat2,lon2){
  const R=6371000, toRad=d=>d*Math.PI/180;
  const dLat=toRad(lat2-lat1), dLon=toRad(lon2-lon1);
  const a=Math.sin(dLat/2)**2+Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)**2;
  return 2*R*Math.asin(Math.sqrt(a));
}
/**
 * Sets or clears the GPS focus point used by the 'gps' band-filter mode.
 * Only meaningful for data carrying GPS coordinates (GPS session log replay).
 * @param mac MAC of a device whose lat/lon becomes the focus point; toggling the
 * current focus MAC clears it.
 */
function setGpsFocus(mac){
  const w=(lastWifi||[]).find(x=>x.mac===mac);
  if(gpsFocus && gpsFocus.mac===mac){ gpsFocus=null; }
  else if(w && w.lat!==undefined){ gpsFocus={mac,lat:w.lat,lon:w.lon}; setBandMode('gps'); }
  else return;
  const mg=document.getElementById('macModalGps'); if(mg)mg.classList.toggle('on',!!gpsFocus&&gpsFocus.mac===macModalMac_);
  drawRadar(lastDevs);
}
/**
 * Recomputes whether the currently loaded wifi[] data carries any GPS
 * coordinates and shows/hides the GPS band-filter mode accordingly. Clears
 * a stale focus/mode when the new data has no coordinates.
 */
function syncGpsFocusUI(){
  gpsCoordsAvailable=(lastWifi||[]).some(x=>x.lat!=null&&x.lon!=null);
  document.querySelectorAll('.gps-only').forEach(e=>e.style.display=gpsCoordsAvailable?'':'none');
  if(!gpsCoordsAvailable){
    gpsFocus=null;
    if(bandMode==='gps')setBandMode('sig');
    if(curView==='trail')setView('map');
  } else if(curView==='trail'&&typeof drawTrail==='function')drawTrail();
}
/**
 * Sets or clears the reference MAC used to focus the radar/signal filter on one device.
 * Persists the choice to localStorage, switches the band slider to focus range when set,
 * resets the radar view transform, and syncs the MAC-info-modal reference toggle before refreshing data.
 * @param mac MAC address to set as reference; toggling the current reference MAC clears it.
 */
function setRef(mac){
  refMac=(mac&&mac!==refMac)?mac:null;
  if(refMac)localStorage.setItem('refMac',refMac);else localStorage.removeItem('refMac');
  onlyNear=!!refMac;
  const bi=document.getElementById('band'), bl=document.getElementById('bandL'),
        lbl=document.getElementById('bandLbl');
  if(bi){bi.value=refMac?12:100;
         if(bl)bl.textContent=bi.value;
         if(lbl)lbl.textContent=(refMac?'radar focus range':'signal range')+' Â±';}
  if(refMac)view={s:1,cx:null,cy:null};
  const mr=document.getElementById('macModalRef');
  if(mr)mr.classList.toggle('on',!!refMac&&refMac===macModalMac_);
  tick();
}
/**
 * Escapes HTML-special characters for safe interpolation into markup.
 * @param s Input string (falsy treated as empty).
 * @returns The escaped string.
 */
function esc(s){return (s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
let confirmPending=null;
/**
 * Opens the shared confirm modal (#confirmModal) with a body, confirm-button label,
 * optional extra HTML block, and the callback to run if the user confirms.
 * @param bodyHtml HTML for the modal body.
 * @param yesLabel Confirm-button label; defaults to 'Confirm' if falsy.
 * @param onYes Callback invoked by doConfirm() when the user confirms.
 * @param extraHtml Optional extra HTML shown below the body; the extra slot is hidden when omitted.
 */
function openConfirm(bodyHtml,yesLabel,onYes,extraHtml){
  confirmPending=onYes;
  const body=document.getElementById('confirmModalBody'); if(body)body.innerHTML=bodyHtml;
  const extra=document.getElementById('confirmModalExtra');
  if(extra){ if(extraHtml){extra.innerHTML=extraHtml;extra.style.display='';} else {extra.innerHTML='';extra.style.display='none';} }
  const btn=document.getElementById('confirmModalBtn'); if(btn)btn.textContent=yesLabel||'Confirm';
  const m=document.getElementById('confirmModal'); if(m)m.classList.add('on');
}
/**
 * Closes the shared confirm modal and discards any pending confirm callback.
 */
function closeConfirm(){
  confirmPending=null;
  const m=document.getElementById('confirmModal'); if(m)m.classList.remove('on');
}
/**
 * Runs the pending confirm-modal callback, if any, after closing the modal.
 */
async function doConfirm(){
  const fn=confirmPending; closeConfirm();
  if(fn)await fn();
}
/**
 * Converts a hex string into space-separated byte pairs.
 * @param h Hex string.
 * @returns Space-separated hex byte string.
 */
function hexSpaced(h){h=(h||'').trim();let out='';for(let i=0;i+1<h.length;i+=2)out+=(out?' ':'')+h.substr(i,2);return out;}
/**
 * Renders the SSID table-cell markup: an "unprintable" badge with the raw bytes as a
 * hex tooltip when the SSID failed to decode as text, else the escaped SSID or empty string.
 * @param ssid Decoded SSID text.
 * @param ssidbad Whether the SSID element failed to decode as valid text.
 * @param ssidhex Raw SSID bytes as hex, shown in the unprintable tooltip.
 * @returns HTML string for the cell.
 */
function ssidHtml(ssid,ssidbad,ssidhex){
  if(ssidbad) return `<span class="unprint" title="SSID is not valid text â€” raw bytes: ${esc(hexSpaced(ssidhex))}">&#8249;unprintable&#8250;</span>`;
  return ssid?esc(ssid):'';
}
/**
 * Formats a duration in seconds as a compact string (s, m[s], or h[m]).
 * @param s Duration in seconds.
 * @returns Formatted duration string.
 */
function fmtDur(s){s=s|0;if(s<60)return s+'s';const m=(s/60)|0,ss=s%60;
  if(m<60)return m+'m'+(ss?ss+'s':'');const h=(m/60)|0,mm=m%60;return h+'h'+(mm?mm+'m':'');}
/**
 * Comparator for sorting device rows by a given key and direction.
 * Aliases 'rssiMinMax' to the 'min' field, compares 'clients' by associated-station
 * count via beaconClients(), and does case-insensitive comparison for string fields.
 * @param a First row.
 * @param b Second row.
 * @param k Sort key.
 * @param dir Sort direction multiplier (1 or -1).
 * @returns Negative, zero, or positive per standard comparator contract.
 */
function cmp(a,b,k,dir){
  if(k==='rssiMinMax')k='min';
  let x,y;
  if(k==='clients'){x=beaconClients(a).length; y=beaconClients(b).length;}
  else{x=a[k]; y=b[k];}
  if(typeof x==='string'){x=x.toLowerCase();y=(y||'').toLowerCase();}
  return (x<y?-1:x>y?1:0)*dir;
}
/**
 * Renders the vendor table cell: the resolved vendor name, or an "(unknown OUI)" /
 * "(random addr)" placeholder when no vendor is known.
 * @param r Device/record with vendor/oui fields.
 * @returns HTML string for the cell.
 */
function vendorCell(r){
  if(r.vendor) return esc(r.vendor);
  return r.oui ? '<span class="muted">(unknown OUI)</span>'
               : '<span class="muted">(random addr)</span>';
}
let ouiMap={};
const OUI_DB='ssoui', OUI_STORE='kv', OUI_KEY='ouimap';
/**
 * Opens (creating on first use) the browser's IndexedDB database used to persist
 * the imported OUI vendor map.
 * @returns Promise resolving to the open IDBDatabase.
 */
function ouiDbOpen(){return new Promise((res,rej)=>{
  const r=indexedDB.open(OUI_DB,1);
  r.onupgradeneeded=()=>r.result.createObjectStore(OUI_STORE);
  r.onsuccess=()=>res(r.result); r.onerror=()=>rej(r.error);});}
/**
 * Loads the persisted OUI vendor map from IndexedDB into ouiMap and updates the
 * OUI-count display. Leaves ouiMap unchanged on error.
 */
async function ouiLoad(){try{
  const db=await ouiDbOpen();
  const m=await new Promise((res,rej)=>{const t=db.transaction(OUI_STORE).objectStore(OUI_STORE).get(OUI_KEY);
    t.onsuccess=()=>res(t.result); t.onerror=()=>rej(t.error);});
  if(m&&typeof m==='object')ouiMap=m;
}catch(e){} updateOuiCount();}
/**
 * Persists the in-memory ouiMap to IndexedDB.
 * @returns Promise resolving once the write transaction completes.
 */
async function ouiSave(){const db=await ouiDbOpen();
  return new Promise((res,rej)=>{const t=db.transaction(OUI_STORE,'readwrite');
    t.objectStore(OUI_STORE).put(ouiMap,OUI_KEY); t.oncomplete=()=>res(); t.onerror=()=>rej(t.error);});}
/**
 * Updates the #ouiCount element with the number of loaded OUI prefixes, or a
 * "firmware subset only" message when none are imported.
 */
function updateOuiCount(){const c=document.getElementById('ouiCount'); if(!c)return;
  const n=Object.keys(ouiMap).length;
  c.textContent=n?n.toLocaleString()+' prefixes':'none (firmware subset only)';}
/**
 * Looks up a vendor name for a MAC address in the imported ouiMap, trying /36, /28,
 * then /24 prefix lengths.
 * @param mac MAC address string.
 * @returns Vendor name, or null if mac is falsy, too short, or not found.
 */
function ouiVendor(mac){ if(!mac)return null;
  const h=mac.replace(/[^0-9a-fA-F]/g,'').toUpperCase(); if(h.length<6)return null;
  return ouiMap[h.slice(0,9)]||ouiMap[h.slice(0,7)]||ouiMap[h.slice(0,6)]||null;}
/**
 * Splits one CSV line into fields, honouring double-quoted fields and escaped ("")
 * quotes within them.
 * @param line CSV line text.
 * @returns Array of field strings.
 */
function csvSplit(line){const out=[];let cur='',q=false;
  for(let i=0;i<line.length;i++){const c=line[i];
    if(q){if(c==='"'){if(line[i+1]==='"'){cur+='"';i++;}else q=false;}else cur+=c;}
    else if(c==='"')q=true; else if(c===','){out.push(cur);cur='';} else cur+=c;}
  out.push(cur); return out;}
/**
 * Parses one line of an OUI source file into a [hexPrefix, vendorName] entry.
 * Handles the IEEE MA-L/MA-M/MA-S CSV format, its "registry," header line, and the
 * Wireshark manuf tab/space-delimited format (with optional "/bits" prefix length).
 * @param line Raw line from the imported OUI file.
 * @returns [hexPrefix, vendorName] tuple, or null if the line is unusable (comment,
 * header, malformed, too short a prefix, or no vendor name).
 */
function parseOuiLine(line){
  line=line.replace(/\r$/,''); if(!line||line[0]==='#')return null;
  if(/^MA-[LMS],/i.test(line)){
    const f=csvSplit(line); if(f.length<3)return null;
    const hx=f[1].replace(/[^0-9a-fA-F]/g,'').toUpperCase(), v=(f[2]||'').trim();
    return (hx.length>=6&&v)?[hx,v]:null;}
  if(/^registry\s*,/i.test(line))return null;
  let p=line.split('\t'); if(p.length<2)p=line.trim().split(/\s{2,}/);
  if(p.length<2)p=line.trim().split(/\s+/);
  const addr=(p[0]||'').trim(); if(!addr)return null;
  const mm=addr.split('/'), hxAll=mm[0].replace(/[^0-9a-fA-F]/g,'').toUpperCase();
  if(hxAll.length<6)return null;
  const nib=Math.max(6,Math.ceil((mm[1]?parseInt(mm[1],10):24)/4));
  const v=(p.length>=3?(p[2].trim()||p[1].trim()):p.slice(1).join(' ').trim());
  return v?[hxAll.slice(0,nib),v]:null;}
/**
 * Reads a user-selected OUI source file, parses it in chunks (yielding to the event
 * loop periodically to avoid blocking), replaces ouiMap with the parsed entries,
 * persists it to IndexedDB, and refreshes the OUI-count display and data view.
 * @param inp File input element holding the selected file.
 */
async function importOui(inp){
  const file=inp.files&&inp.files[0]; inp.value=''; if(!file)return;
  const st=document.getElementById('ouiStatus');
  if(st)st.textContent='Reading '+file.name+' â€¦';
  let text; try{text=await file.text();}catch(e){if(st)st.textContent='Read failed: '+e;return;}
  const lines=text.split('\n'), map={}; let added=0;
  for(let i=0;i<lines.length;i++){
    const r=parseOuiLine(lines[i]); if(r){map[r[0]]=r[1];added++;}
    if((i&8191)===0){ if(st)st.textContent='Parsingâ€¦ '+added.toLocaleString()+' entries';
      await new Promise(r=>setTimeout(r)); }
  }
  if(!added){if(st)st.textContent='No OUI rows found â€” expects an IEEE oui.csv or Wireshark manuf file.';return;}
  ouiMap=map; updateOuiCount();
  try{await ouiSave();}catch(e){if(st){st.textContent='Parsed '+added.toLocaleString()+' but save failed: '+e;return;}}
  if(st)st.textContent='Imported '+added.toLocaleString()+' vendor prefixes.';
  tick();}
/**
 * Clears the in-memory and IndexedDB-persisted OUI vendor map, then refreshes the
 * OUI-count display and data view.
 */
async function clearOui(){ouiMap={};updateOuiCount();
  const s=document.getElementById('ouiStatus'); if(s)s.textContent='Imported DB cleared.';
  try{const db=await ouiDbOpen();
    db.transaction(OUI_STORE,'readwrite').objectStore(OUI_STORE).delete(OUI_KEY);}catch(e){}
  tick();}
/**
 * Builds a compact local-time timestamp (YYYYMMDD-HHMMSS) for use in export filenames.
 * @returns Timestamp string.
 */
function ioStamp(){const d=new Date(),p=n=>String(n).padStart(2,'0');
  return d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'-'+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds());}
/**
 * Fetches the current /api/data snapshot and assembles it into an export/session
 * object, using the scout WiFi aggregate list when active, else the plain wifi[] array.
 * @param wifi Whether to include the WiFi section (wifi/assoc/deauth/handshake) in the output.
 * @returns The assembled export object, or null if the /api/data fetch/parse failed.
 */
async function buildExportBlob(wifi){
  let d; try{d=await(await fetch('/api/data')).json();}catch(e){return null;}
  const wifiRecs=(d.clientAgg&&d.scout&&typeof wifiAggAry==='function')?wifiAggAry():(d.wifi||[]);
  const out={app:'802Eleven',version:1,exported:new Date().toISOString()};
  if(wifi)out.wifi={wifi:wifiRecs,assoc:d.assoc||[],deauth:d.deauth||[],handshake:d.handshake||[]};
  return out;
}
/**
 * Builds an export blob per the #expWifi checkbox and triggers a browser download of
 * it as a timestamped JSON file, reporting the record count in #ioStatus. When
 * #expFormat (if present) is set to a non-'json' value, delegates to that
 * format's own exporter instead (currently just 'wigle', see exportGpsSessionWigle_) --
 * those pull from a different on-SD source, not the live snapshot this builds.
 */
async function exportData(){
  const st=document.getElementById('ioStatus');
  const fmt=document.getElementById('expFormat')?.value||'json';
  if(fmt==='wigle'){await exportGpsSessionWigle_(st);return;}
  const wifi=document.getElementById('expWifi')?.checked??true;

  if(!wifi){if(st)st.textContent='Tick WiFi to export.';return;}
  if(st)st.textContent='Fetching snapshot from deviceâ€¦';
  const out=await buildExportBlob(wifi);
  if(!out){if(st)st.textContent='Export failed.';return;}
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([JSON.stringify(out)],{type:'application/json'}));
  a.download='802eleven-'+ioStamp()+'.json'; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),4000);
  const bits=[]; if(out.wifi)bits.push(out.wifi.wifi.length+' WiFi');
  if(st)st.textContent='Exported '+bits.join(' + ')+' records.';
}
/**
 * Builds an export blob and POSTs it to /api/session/save to persist a session file
 * on the device's SD card.
 * @param label Optional label appended as a query parameter to the save request.
 * @returns True on success, false on failure/exception, or 401 if unauthenticated.
 */
async function archiveSession(label){
  try{
    const out=await buildExportBlob(true);
    if(!out)return false;
    let url='/api/session/save';
    if(label)url+='?label='+encodeURIComponent(label);
    const r=await fetch(url,{method:'POST',body:JSON.stringify(out)});
    if(r.status===401)return 401;
    const j=await r.json().catch(()=>({ok:false}));
    return !!j.ok;
  }catch(e){return false;}
}
const AUTOSAVE_MS=3*60*1000, AUTOSAVE_KEEP=3;
/**
 * Deletes the oldest "_auto.json" session files beyond AUTOSAVE_KEEP, based on the
 * current /api/session/list contents. No-op if there's no SD card or file list.
 */
async function pruneAutosaves(){
  try{
    const d=await(await fetch('/api/session/list')).json();
    if(!d.sd||!d.files)return;
    const autos=d.files.filter(f=>f.name.indexOf('_auto.json')>=0).sort((a,b)=>a.name<b.name?-1:1);
    while(autos.length>AUTOSAVE_KEEP){
      const f=autos.shift();
      await fetch('/api/session/delete',{method:'POST',
        headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:'name='+encodeURIComponent(f.name)});
    }
  }catch(e){}
}
/**
 * Periodic autosave tick (driven by setInterval). Skips while live polling is off or
 * a capture is running; otherwise archives an "auto" session and prunes old autosaves
 * on success.
 */
async function autosaveTick(){
  if(!liveOn||capturing)return;
  const ok=await archiveSession('auto');
  if(ok===true)pruneAutosaves();
}
setInterval(autosaveTick,AUTOSAVE_MS);
/**
 * Applies an imported or loaded session/export object as the current live view:
 * rebuilds the WiFi/assoc/deauth/handshake state, re-renders the deauth/handshake and
 * channel-density tabs if active, redraws the radar and devices table, and reports the
 * import result in #ioStatus.
 * @param o Session/export object shaped {wifi:{wifi,assoc,deauth,handshake}, exported}.
 */
function applyImport(o){
  const st=document.getElementById('ioStatus');
  const wifi = !!o.wifi;
  if(wifi){
    lastWifi=o.wifi.wifi||[]; buildAssoc(o.wifi.assoc||[]); lastDeauth=o.wifi.deauth||[];
    lastHandshake=o.wifi.handshake||[];
    lastDevs=wifiToDevs(lastWifi);
    syncGpsFocusUI();
    const hde=document.getElementById('hde'),hde2=document.getElementById('hde2');
    const authN=lastDeauth.length+lastHandshake.length;
    if(hde)hde.textContent=authN; if(hde2)hde2.textContent=authN;
    if(curView==='deauth'){renderDeauth();renderHandshakes();loadHsRam();} if(curView==='chan')drawChanDensity();
  }
  updateRefInfo(lastDevs);
  document.getElementById('hd').textContent=lastDevs.length;
  const hd2=document.getElementById('hd2'); if(hd2)hd2.textContent=lastDevs.length;
  drawRadar(lastDevs); renderDevices();
  const when=o.exported?(' ('+o.exported.replace('T',' ').slice(0,19)+'Z)'):'';
  if(st)st.textContent='Imported '+lastDevs.length+' WiFi records'+when+'. Live paused â€” toggle Live to resume.';
}
/**
 * Reads a user-selected export JSON file, validates its app/wifi shape, pauses live
 * polling, and applies it via applyImport().
 * @param inp File input element holding the selected file.
 */
async function importData(inp){
  const file=inp.files&&inp.files[0]; inp.value=''; if(!file)return;
  const st=document.getElementById('ioStatus');
  if(st)st.textContent='Reading '+file.name+' â€¦';
  let o; try{o=JSON.parse(await file.text());}
  catch(e){if(st)st.textContent='Not valid JSON: '+e;return;}
  if(!o||o.app!=='802Eleven'||!o.wifi){
    if(st)st.textContent='Unrecognised file â€” expects a 802Eleven export.';return;}
  if(liveOn)toggleLive();
  importedSnap=o;
  applyImport(o);
}
let lastSessionFiles=[];
/**
 * Derives a display label for a saved session filename, distinguishing WiFi scans
 * from full sessions by their "wscan_" prefix.
 * @param name Session/scan filename.
 * @returns Display label ("Scan: <name>" or "Session: <name>").
 */
function sessionLabel(name){ return (name.startsWith('wscan_')?'Scan: ':'Session: ')+name; }
/**
 * Fetches /api/session/list and repopulates the session dropdown, showing an
 * appropriate empty-state message when there's no SD card or no saved files.
 */
async function refreshSessionList(){
  const box=document.getElementById('sessList'); const sel=document.getElementById('sessSel');
  const row=document.getElementById('sessSelRow'); if(!box||!sel)return;
  closeConfirm();
  try{
    const d=await(await fetch('/api/session/list')).json();
    lastSessionFiles=[];
    if(!d.sd){box.innerHTML='No SD card on this board â€” sessions need a microSD slot.';if(row)row.style.display='none';return;}
    if(!d.files||!d.files.length){box.innerHTML='No saved sessions yet.';if(row)row.style.display='none';return;}
    lastSessionFiles=d.files;
    sel.innerHTML=d.files.map(f=>`<option value="${esc(f.name)}">${esc(sessionLabel(f.name))} (${fmtBytes(f.size)})</option>`).join('');
    if(row)row.style.display=''; box.innerHTML='';
  }catch(e){box.innerHTML='Error loading session list.';if(row)row.style.display='none';}
}
/**
 * Loads a named saved session (or WiFi scan) from the device, pauses live polling,
 * and applies it as the current view.
 * @param name Session/scan filename to load.
 */
async function loadSession(name){
  const st=document.getElementById('ioStatus'); if(st)st.textContent='Loading '+name+'â€¦';
  try{
    const url=(name.startsWith('wscan_')?'/api/session/wifiscan?name=':'/api/session/load?name=')+encodeURIComponent(name);
    const o=await(await fetch(url)).json();
    if(!o||o.app!=='802Eleven'){if(st)st.textContent='Corrupt session file.';return;}
    if(liveOn)toggleLive();
    importedSnap=o;
    applyImport(o);
    if(st)st.textContent='Loaded session '+name+'.';
  }catch(e){if(st)st.textContent='Error loading session.';}
}
/**
 * Loads whichever session is currently selected in the #sessSel dropdown.
 */
async function loadSelectedSession(){
  const sel=document.getElementById('sessSel'); if(sel&&sel.value)await loadSession(sel.value);
}
/**
 * Opens the confirm modal to delete the currently selected session.
 */
function requestDeleteSession(){
  const sel=document.getElementById('sessSel'); if(!sel||!sel.value)return;
  const name=sel.value;
  openConfirm('Delete "'+esc(name)+'"? This cannot be undone.','Delete',()=>doDeleteSession(name));
}
/**
 * Deletes a named session file via /api/session/delete and refreshes the session list.
 * @param name Session filename to delete.
 */
async function doDeleteSession(name){
  try{await fetch('/api/session/delete',{method:'POST',body:'name='+encodeURIComponent(name)});}catch(e){}
  refreshSessionList();
}
/**
 * Opens the confirm modal to delete every currently listed session file.
 */
function requestDeleteAllSessions(){
  if(!lastSessionFiles.length)return;
  openConfirm('Delete all '+lastSessionFiles.length+' sessions? This cannot be undone.','Delete all',doDeleteAllSessions);
}
/**
 * Deletes every session file currently in lastSessionFiles, then refreshes the
 * session list.
 */
async function doDeleteAllSessions(){
  for(const f of lastSessionFiles.slice()){
    try{await fetch('/api/session/delete',{method:'POST',body:'name='+encodeURIComponent(f.name)});}catch(e){}
  }
  refreshSessionList();
}

/**
 * Merges duplicate-MAC rows from a raw log/scan row array into one row per MAC:
 * sums cnt/life, widens min/max, and keeps the latest rssi/avg/ch/kind/vendor/rnd
 * and (if present) ssid/lat/lon.
 * @param arr Array of raw row objects (possibly containing repeat MACs).
 * @returns Array of merged rows, one per MAC.
 */
function mergeWifiLogRows(arr){
  const m=new Map();
  for(const x of arr){
    const p=m.get(x.mac);
    if(!p){m.set(x.mac,Object.assign({},x));continue;}
    p.cnt=(p.cnt||0)+(x.cnt||0);
    p.life=(p.life||0)+(x.life||0);
    if(x.min<p.min)p.min=x.min;
    if(x.max>p.max)p.max=x.max;
    p.rssi=x.rssi; p.avg=x.avg; p.ch=x.ch; p.kind=x.kind;
    p.vendor=x.vendor; p.rnd=x.rnd;
    if(x.ssid||x.ssidbad){p.ssid=x.ssid;p.ssidbad=x.ssidbad;p.ssidhex=x.ssidhex;}
    if(x.lat!==undefined&&x.lon!==undefined){p.lat=x.lat;p.lon=x.lon;}
  }
  return Array.from(m.values());
}
/**
 * Loads the SD-backed evicted-WiFi-record log (/api/session/wifilog), merges
 * duplicate MACs, pauses live polling, and applies it as the current view.
 */
async function loadWifiLog(){
  const st=document.getElementById('wlogStatus'); if(st)st.textContent='Loading logâ€¦';
  try{
    const r=await fetch('/api/session/wifilog');
    if(r.status===404){if(st)st.textContent='No log on this card yet (or no SD card).';return;}
    const o=await r.json();
    if(!o||o.app!=='802Eleven'){if(st)st.textContent='Corrupt log.';return;}
    if(o.wifi&&o.wifi.wifi)o.wifi.wifi=mergeWifiLogRows(o.wifi.wifi);
    if(liveOn)toggleLive();
    importedSnap=o;
    applyImport(o);
    if(st)st.textContent='Loaded '+((o.wifi&&o.wifi.wifi)?o.wifi.wifi.length:0)+
      ' evicted records. RSSI shown is last-seen, not avg; age/life are approximate. Live paused.';
  }catch(e){if(st)st.textContent='Error loading log.';}
}
/**
 * Clears the SD-backed evicted-WiFi-record log via /api/session/wifilog/clear.
 */
async function clearWifiLog(){
  const st=document.getElementById('wlogStatus');
  try{
    const r=await(await fetch('/api/session/wifilog/clear',{method:'POST'})).json();
    if(st)st.textContent=r.ok?'Log cleared.':('Clear failed: '+(r.err||'?'));
  }catch(e){if(st)st.textContent='Error clearing log.';}
}

/**
 * Loads the raw SD scout-capture stream (/api/session/wifisync), re-ingests it line
 * by line into the client-side WiFi aggregate maps, pauses live polling, and applies
 * the result as the current view.
 */
async function loadSdWifiCapture(){
  const st=document.getElementById('ioStatus');
  if(st)st.textContent='Loading SD captureâ€¦';
  try{
    const txt=await(await fetch('/api/session/wifisync')).text();
    wifiClientAgg.clear();
    wifiAggAssoc.clear();
    if(txt) txt.split('\n').forEach(l=>{ if(l) ingestRawWifiLine(l); });
    if(!wifiClientAgg.size){ if(st)st.textContent='No SD capture found (no card, or nothing captured yet).'; return; }
    const o={app:'802Eleven', wifi:{wifi:wifiAggAry(), assoc:wifiAggAssocAry(), deauth:[]}};
    if(liveOn)toggleLive();
    importedSnap=o;
    wifiAggActive=true;
    applyImport(o);
  }catch(e){ if(st)st.textContent='Error loading SD capture.'; }
}

/**
 * Sorts (unless presorted) and renders rows into the tbody of table #id, flashing
 * newly-seen rows, marking the selected/client rows, and (for the devices table)
 * recording the resulting row MAC order into devRowOrder.
 * @param id Table element id.
 * @param rows Row data to render.
 * @param sort {k,dir} sort spec, used only when presorted is falsy.
 * @param key A field name, or a function(row) returning the dedupe/"seen" key.
 * @param cols Function(row) returning the row's inner `<td>` markup.
 * @param seen Map of previously-seen keys; mutated to mark rows as seen (drives the flash animation).
 * @param presorted Whether rows are already sorted (skips re-sorting).
 */
function render(id,rows,sort,key,cols,seen,presorted){
  if(!presorted) rows.sort((a,b)=>cmp(a,b,sort.k,sort.dir));
  const tb=document.querySelector('#'+id+' tbody');
  tb.innerHTML=rows.map(r=>{
    const k=(typeof key==='function')?key(r):r[key], fresh=!seen[k]; seen[k]=1;
    const sel=id==='dt'&&r.mac&&r.mac===selMac?' krow':'';
    const cli=(r.kind==='client'||r._child)?' trCli':'';
    return `<tr class="${fresh?'flash':''}${sel}${cli}"${r.mac?` data-mac="${esc(r.mac)}"`:''}${r._netGroup?` data-net="${esc(r.ssid)}"`:''}>`+cols(r)+`</tr>`;
  }).join('');
  if(id==='dt') devRowOrder=rows.map(r=>r.mac).filter(Boolean);
}
/**
 * Checks whether an element carries the 'on' class.
 * @param id Element id.
 * @returns True if the element exists and has class 'on'.
 */
function on(id){const b=document.getElementById(id);return !!(b&&b.classList.contains('on'));}
/**
 * Toggles an element's 'on' class and redraws the radar.
 * @param id Element id.
 */
function tgl(id){const b=document.getElementById(id);if(!b)return;b.classList.toggle('on');drawRadar(lastDevs);}
/**
 * Checks whether a device type string denotes a randomised (locally-administered) MAC.
 * @param t Device type string.
 * @returns True for 'RND' or 'RID'.
 */
function isRnd(t){return t==='RND'||t==='RID';}
/**
 * Always false â€” this radar/table view is a live capture, not an aging store, so
 * there is no idle/inactive concept.
 * @returns false.
 */
function isInactive(){return false;}
/**
 * Merges randomised-MAC WiFi clients probing for the same named SSID into one
 * representative row (RSSI-averaged, min/max widened, count summed); every other
 * device row is passed through unchanged.
 * @param devs Device rows to collapse.
 * @returns New array with same-SSID WiFi-client rows merged.
 */
function collapseDevs(devs){
  const g={}, out=[];
  devs.forEach(d=>{
    let key,kind;
    if(d._wifi && d.type==='RND' && d.kind==='probe' && d.ssid){
      key='wifissid:'+d.ssid;
      kind='WiFi client';
    }else{ out.push(d); return; }
    (g[key]=g[key]||{m:[],kind:kind})&&g[key].m.push(d);
  });
  Object.keys(g).forEach(k=>{
    const m=g[k].m, rep=m.reduce((a,b)=>a.rssi>b.rssi?a:b);
    if(m.length===1){out.push(Object.assign({_key:k,_kind:g[k].kind},m[0]));return;}
    let cnt=0,sum=0,mn=127,mx=-128,age=1e9,life=0,name='';
    m.forEach(d=>{cnt+=d.cnt;sum+=d.avg;mn=Math.min(mn,d.min);mx=Math.max(mx,d.max);
                  age=Math.min(age,d.age);life=Math.max(life,d.life||0);name=name||d.name;});
    out.push({mac:rep.mac,type:rep.type,rssi:rep.rssi,avg:Math.round(sum/m.length),
              min:mn,max:mx,cnt,age,life,oui:rep.oui,vendor:rep.vendor,
              name,_grp:m.length,_key:k,_kind:g[k].kind,
              _wifi:rep._wifi,kind:rep.kind,ssid:rep.ssid,hid:rep.hid,ch:rep.ch,rnd:rep.rnd,
              sec:rep.sec,cip:rep.cip,pmf:rep.pmf,secie:rep.secie,sta:rep.sta});
  });
  return out;
}
let expandedNetworks=new Set();
/**
 * Groups beacon rows sharing the same SSID (multi-BSSID networks) into a single
 * `_netGroup` summary row (aggregated station count, count, age/life, min/max RSSI,
 * and channel set); rows whose SSID has only one AP pass through unchanged.
 * @param rows Device rows (post-collapseDevs) to group.
 * @returns New array with multi-AP networks replaced by their group row; the input
 * array itself if no SSID has more than one AP.
 */
function groupNetworks(rows){
  const bySsid={};
  rows.forEach(r=>{
    if(r.kind!=='beacon'||!r.ssid) return;
    (bySsid[r.ssid]=bySsid[r.ssid]||[]).push(r);
  });
  const grouped=new Set();
  Object.keys(bySsid).forEach(ssid=>{ if(bySsid[ssid].length>1) bySsid[ssid].forEach(m=>grouped.add(m)); });
  if(!grouped.size) return rows;
  const out=[];
  Object.keys(bySsid).forEach(ssid=>{
    const members=bySsid[ssid]; if(members.length<2) return;
    const rep=members.reduce((a,b)=>a.rssi>b.rssi?a:b);
    let sta=0,cnt=0,age=1e9,life=0,mn=127,mx=-128; const chans=new Set();
    members.forEach(m=>{sta+=m.sta||0;cnt+=m.cnt;age=Math.min(age,m.age);life=Math.max(life,m.life||0);
      mn=Math.min(mn,m.min);mx=Math.max(mx,m.max); if(m.ch)chans.add(m.ch);});
    out.push({_netGroup:true,_key:'net:'+ssid,mac:'',name:ssid,ssid,kind:'beacon',
      rssi:rep.rssi,avg:rep.avg,min:mn,max:mx,cnt,age,life,sta,
      _chans:[...chans].sort((a,b)=>a-b),ch:'',hid:members.some(m=>m.hid),
      sec:rep.sec,cip:rep.cip,pmf:rep.pmf,secie:rep.secie,rnd:false,oui:false,vendor:'',
      _members:members.slice().sort((a,b)=>b.rssi-a.rssi)});
  });
  rows.forEach(r=>{ if(!grouped.has(r)) out.push(r); });
  return out;
}
/**
 * Filters device rows by signal strength: within Â±band of a reference RSSI when a
 * reference device is focused (onlyNear), else by an absolute RSSI floor.
 * @param rows Device rows to filter.
 * @param refRssi RSSI of the focused reference device, or null/undefined.
 * @param band Allowed deviation from refRssi when focused, or the floor magnitude otherwise.
 * @returns Filtered rows.
 */
function signalFilter(rows,refRssi,band){
  if(refRssi!=null && onlyNear)
    return rows.filter(d=>d.mac===refMac||Math.abs(d.avg-refRssi)<=band);
  return rows.filter(d=>d.avg>=-band);
}
const BAND_MODES={
  sig: {min:0,max:100,step:1,val:100,lbl:'signal range Â±',unit:'dB'},
  seen:{min:0,step:5,lbl:'last seen â‰¤',unit:'s',dyn:'hi',fld:'age'},
  age: {min:0,step:5,lbl:'alive â‰¥',    unit:'s',dyn:'lo',fld:'life'},
  cnt: {min:1,max:100,step:1,val:1,lbl:'min count',unit:''},
  ch:  {min:0,max:13, step:1,val:0,lbl:'channel',  unit:''},
  gps: {min:0,max:2000,step:25,val:300,lbl:'distance from GPS focus â‰¤',unit:'m'}
};
let bandMode='sig';
/**
 * Reads the current numeric value of the #band range input.
 * @returns Current slider value.
 */
function bandVal(){return +document.getElementById('band').value;}
/**
 * Maps a band-slider "channel" mode value to a real WiFi channel number, resolving
 * values beyond 13 through the 5GHz channel table (WIFI_5G_CH).
 * @param v Slider value.
 * @returns Channel number, or 0 if out of range.
 */
function chSliderChan(v){ return v<=13 ? v : (WIFI_5G_CH[v-14]||0); }
/**
 * Formats the band slider's readout label for the current mode/value, showing
 * 'all'/'any' for unbounded settings in channel/age/seen modes.
 * @param m Active band mode key.
 * @param v Slider value.
 * @returns Readout text.
 */
function bandReadout(m,v){
  if(m==='gps') return gpsFocus ? ''+v : 'no focus set';
  if(m==='ch')  return v===0 ? 'all' : ''+chSliderChan(v);
  if(m==='age'&&v===0) return 'any';
  if(m==='seen'){const s=document.getElementById('band');
    if(s&&v>=+s.max) return 'any';}
  return ''+v;
}
/**
 * Computes the band slider's max value for channel mode, extended to include the
 * 5GHz channel table when scout dual-band capture is active.
 * @returns Maximum slider value.
 */
function chSliderMax(){ return 13 + (scoutDualBand ? WIFI_5G_CH.length : 0); }
/**
 * Computes a rounded-up ceiling for a dynamic band mode's slider max, based on the
 * largest current value of its backing field (age/life) across lastDevs.
 * @param m Band mode key.
 * @returns Ceiling value (at least 60, rounded up to the mode's step).
 */
function bandCeil(m){
  const c=BAND_MODES[m]; let mx=0;
  (lastDevs||[]).forEach(d=>{mx=Math.max(mx,+d[c.fld]||0);});
  return Math.max(60, Math.ceil(mx/c.step)*c.step);
}
/**
 * Grows the band slider's max for the active dynamic mode when the data now exceeds
 * it, moving the handle to the new max if it was already pinned at the old max.
 */
function growBandMax(){
  const c=BAND_MODES[bandMode]; if(!c||!c.dyn)return;
  const s=document.getElementById('band'), dm=bandCeil(bandMode);
  if(dm>+s.max){
    const wasMax=(+s.value>=+s.max);
    s.max=dm;
    if(wasMax){s.value=dm; c.val=dm; document.getElementById('bandL').textContent=bandReadout(bandMode,dm);}
  }
}
/**
 * Handles the band slider's input event: stores the mode's value, updates the
 * readout label, and redraws the radar.
 */
function onBandInput(){
  const v=bandVal(); BAND_MODES[bandMode].val=v;
  document.getElementById('bandL').textContent=bandReadout(bandMode,v);
  drawRadar(lastDevs);
}
/**
 * Switches the active band-filter mode: reconfigures the slider's min/max/step/value
 * and label/unit for the new mode, updates the mode-picker UI, and redraws the radar.
 * @param m Band mode key to switch to; no-op if unknown or already the active mode.
 */
function setBandMode(m){
  if(!BAND_MODES[m]||m===bandMode){return;}
  BAND_MODES[bandMode].val=bandVal();
  bandMode=m; const c=BAND_MODES[m], s=document.getElementById('band');
  s.min=c.min; s.step=c.step;
  if(c.dyn){
    const mx=bandCeil(m); s.max=mx;
    if(c.val==null) c.val=(c.dyn==='hi')?mx:c.min;
    s.value=Math.min(c.val, mx);
  }else{ s.max=(m==='ch')?chSliderMax():c.max; s.value=c.val; }
  document.getElementById('bandLbl').innerHTML=c.lbl;
  document.getElementById('bandUnit').textContent=c.unit;
  document.getElementById('bandL').textContent=bandReadout(m,+s.value);
  document.querySelectorAll('#bandModes button').forEach(b=>b.classList.toggle('on',b.dataset.bm===m));
  document.getElementById('bandModeCur').textContent=m.toUpperCase();
  document.getElementById('bandModes').classList.remove('open');
  drawRadar(lastDevs);
}
/**
 * Toggles the open/closed state of the band-mode picker dropdown.
 */
function toggleBandModes(){document.getElementById('bandModes').classList.toggle('open');}
const SEARCH_NUM={rssi:'rssi',avg:'avg',cnt:'cnt',age:'age',ch:'ch',min:'min',max:'max',sta:'sta',life:'life'};
const SEARCH_STR={mac:'mac',vendor:'vendor',type:'type',kind:'kind',ssid:'name',name:'name'};
/**
 * Resolves a device's display name.
 * @param d Device row.
 * @returns d.ssid, falling back to d.name, or empty string if neither is set.
 */
function devName(d){return d.ssid||d.name||'';}
/**
 * Builds a case-insensitive substring-match predicate over a field extractor.
 * @param get Function(device) returning the field value to test.
 * @param val Substring to search for.
 * @returns Predicate function(device) -> boolean.
 */
function subPred(get,val){const v=val.toLowerCase();
  return d=>String(get(d)||'').toLowerCase().includes(v);}
/**
 * Builds a numeric comparison predicate (supports >, <, >=, <=, = prefixes, default =)
 * over a device field.
 * @param field Device field name to compare.
 * @param val Comparison expression, e.g. '>-70' or '5'.
 * @returns Predicate function(device) -> boolean, or null if val isn't a valid numeric expression.
 */
function numPred(field,val){
  const m=String(val).match(/^(>=|<=|>|<|=)?\s*(-?\d+)$/); if(!m)return null;
  const op=m[1]||'=', n=+m[2];
  return d=>{const x=+d[field]; if(isNaN(x))return false;
    return op==='>'?x>n:op==='<'?x<n:op==='>='?x>=n:op==='<='?x<=n:x===n;};
}
/**
 * Parses one search-box token into a predicate. Supports 'field:value' syntax for
 * kind (including a special 'station'/'sta' associated-client match), sec/cip
 * (security/cipher label substring match, beacons only), the generic numeric/string
 * field maps, a bare MAC-like token (containing ':'), or a plain name substring match.
 * @param tok Search token, optionally prefixed with 'field:'.
 * @returns Predicate function(device) -> boolean.
 */
function tokPred(tok){
  const i=tok.indexOf(':'), field=i>0?tok.slice(0,i).toLowerCase():'';
  if(i>0 && field==='kind'){
    const val=tok.slice(i+1).toLowerCase();
    if(val==='station'||val==='sta') return d=>d.kind!=='beacon' && !!wifiClientAp[d.mac];
    return subPred(d=>d.kind,val);
  }
  if(i>0 && field==='sec' && typeof SEC_LABEL!=='undefined'){
    const val=tok.slice(i+1).toLowerCase();
    return d=>d.kind==='beacon' && (SEC_LABEL[d.sec||0]||'').toLowerCase().includes(val);
  }
  if(i>0 && field==='cip' && typeof CIP_LABEL!=='undefined'){
    const val=tok.slice(i+1).toLowerCase();
    return d=>d.kind==='beacon' && (CIP_LABEL[d.cip||0]||'').toLowerCase().includes(val);
  }
  if(i>0 && (SEARCH_NUM[field]||SEARCH_STR[field])){
    const val=tok.slice(i+1);
    if(SEARCH_NUM[field]) return numPred(SEARCH_NUM[field],val)||subPred(d=>d[SEARCH_NUM[field]],val);
    const key=SEARCH_STR[field];
    return key==='name'?subPred(devName,val):subPred(d=>d[key],val);
  }
  if(tok.includes(':')) return subPred(d=>d.mac,tok);
  return subPred(devName,tok);
}
/**
 * Splits a search-box query into whitespace-separated tokens and compiles each into
 * a predicate via tokPred().
 * @param q Raw search query string.
 * @returns Array of predicate functions; empty array for a blank query.
 */
function parseSearch(q){q=(q||'').trim(); if(!q)return [];
  return q.split(/\s+/).filter(Boolean).map(tokPred);}
/**
 * Opens or closes the device search popover (#devSearchPop), focusing its input
 * field when opened.
 */
function toggleDevSearch(){
  const pop=document.getElementById('devSearchPop'), btn=document.getElementById('devSearchBtn'),
        open=pop.style.display==='none';
  pop.style.display=open?'flex':'none';
  btn.classList.toggle('on',open);
  if(open)document.getElementById('devSearch').focus();
}
/**
 * Clears the device search box, re-renders the devices table (and radar if search
 * is synced to it), refocuses the search input, and triggers a quick data refresh.
 */
function clearDevSearch(){const el=document.getElementById('devSearch');
  el.value=''; renderDevices(); if(syncSearch)drawRadar(lastDevs); el.focus(); quickTick();}
/**
 * Closes whichever of the device-search or WiFi-filter popovers is currently open.
 * @returns True if a popover was closed, false if neither was open.
 */
function closeDevPopovers(){
  const sp=document.getElementById('devSearchPop');
  if(sp&&sp.style.display!=='none'){sp.style.display='none';
    const b=document.getElementById('devSearchBtn'); if(b)b.classList.remove('on'); return true;}
  const wp=document.getElementById('wifiFilterPop');
  if(wp&&wp.style.display!=='none'){wp.style.display='none';
    const b=document.getElementById('wifiFilterBtn'); if(b)b.classList.remove('on'); return true;}
  return false;
}
/**
 * Clears the radar box-select filter, the radar-sync toggle, and the search box,
 * then re-renders the devices table and radar and triggers a quick data refresh.
 */
function clearDevFilters(){boxSel=null; syncFromRadar=false;
  const el=document.getElementById('devSearch'); if(el)el.value='';
  const sb=document.getElementById('syncDevBtn'); if(sb)sb.classList.remove('on');
  renderDevices(); drawRadar(lastDevs); quickTick();}
/**
 * Builds and renders the current devices view: applies network grouping, client
 * collapsing, box-select/search/radar-sync/kind filters to lastDevs, updates the
 * active-filter status bar (#dfbar), and renders either the table (including
 * expanded network/AP client rows) or the card view depending on devView.
 */
function renderDevices(){
  let rows=groupNetworks(collapseDevs(lastDevs));
  if(boxSel) rows=rows.filter(d=>boxSel.has(d.mac)||(d._members&&d._members.some(m=>boxSel.has(m.mac))));
  const preds=parseSearch((document.getElementById('devSearch')||{}).value);
  if(preds.length) rows=rows.filter(d=>preds.every(p=>p(d)));
  if(syncFromRadar){
    const vis=new Set(radarFilter(lastDevs).map(d=>d.mac));
    rows=rows.filter(d=>vis.has(d.mac)||(d._members&&d._members.some(m=>vis.has(m.mac))));
  }
  const bar=document.getElementById('dfbar');
  if(bar){
    const kindFiltered=radarMode==='wifi'&&Object.values(wifiShow).some(v=>!v);
    const parts=[]; if(boxSel)parts.push('box filter'); if(preds.length)parts.push('search');
    if(syncFromRadar)parts.push('on radar'); if(kindFiltered)parts.push('kind filter');
    if(parts.length){
      bar.style.display='flex';
      bar.innerHTML=`<span>${parts.join(' + ')} &middot; <b>${rows.length}</b> devices</span>`+
        `<button onclick="${kindFiltered?'resetWifiFilters()':'clearDevFilters()'}">Show all</button>`;
    }else bar.style.display='none';
  }
  const tbl=devView==='table';
  document.getElementById('dtWrap').style.display=tbl?'':'none';
  document.getElementById('dcards').style.display=tbl?'none':'';
  if(tbl){
    rows.sort((a,b)=>cmp(a,b,dSort.k,dSort.dir));
    const withCli=[];
    rows.forEach(r=>{
      withCli.push(r);
      if(r._netGroup){
        if(expandedNetworks.has(r.ssid))
          r._members.forEach(m=>{
            withCli.push(Object.assign({_child:true,_key:'m:'+m.mac},m));
            if(expandedTableAPs.has(m.mac))
              beaconClients(m).forEach(cm=>withCli.push(clientRow(cm,m.mac)));
          });
        return;
      }
      if(r.kind==='beacon' && expandedTableAPs.has(r.mac))
        beaconClients(r).forEach(cm=>withCli.push(clientRow(cm,r.mac)));
    });
    render('dt',withCli,dSort,d=>d._key||d.mac,wifiCols,seenD,true);
  }else{
    renderCards(rows);
  }
}
const VIEW_ICON_TABLE='<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="5" x2="17" y2="5"/><line x1="3" y1="10" x2="17" y2="10"/><line x1="3" y1="15" x2="17" y2="15"/></svg>';
const VIEW_ICON_CARD='<svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><rect x="3" y="3" width="14" height="6" rx="1.5"/><rect x="3" y="11" width="14" height="6" rx="1.5"/></svg>';
/**
 * Toggles the devices display between table and card view.
 */
function toggleDevView(){ setDevView(devView==='table'?'card':'table'); }
/**
 * Switches between table and card device-list layouts.
 * Updates the `devView` global, the view-toggle button's icon/title, and re-renders the device list.
 * @param v New view mode, 'table' or 'card'.
 */
function setDevView(v){
  devView=v;
  const btn=document.getElementById('vwToggle');
  if(btn){
    const toCard=v==='table';
    btn.title=toCard?'card view - compact tiles that wrap to fit the screen, no horizontal scroll':'table view (scrolling rows)';
    btn.innerHTML=toCard?VIEW_ICON_CARD:VIEW_ICON_TABLE;
  }
  renderDevices();
}
/**
 * Renders the device list as cards into #dcards.
 * Sorts rows by the current device sort, expands grouped networks/beacon clients that are toggled open, and rebuilds `devRowOrder` from the rendered rows.
 * @param rows Device records to render.
 */
function renderCards(rows){
  rows.sort((a,b)=>cmp(a,b,dSort.k,dSort.dir));
  const wifi=radarMode==='wifi', box=document.getElementById('dcards');
  if(wifi){
    const withCli=[];
    rows.forEach(r=>{
      withCli.push(r);
      if(r._netGroup){
        if(expandedNetworks.has(r.ssid))
          r._members.forEach(m=>{
            withCli.push(Object.assign({_child:true,_key:'m:'+m.mac},m));
            if(expandedTableAPs.has(m.mac))
              beaconClients(m).forEach(cm=>withCli.push(clientRow(cm,m.mac)));
          });
        return;
      }
      if(r.kind==='beacon' && expandedTableAPs.has(r.mac))
        beaconClients(r).forEach(cm=>withCli.push(clientRow(cm,r.mac)));
    });
    rows=withCli;
  }
  box.innerHTML=rows.map(r=>{
    const k=r._key||r.mac, fresh=!seenD[k]; seenD[k]=1;
    const sel=r.mac&&r.mac===selMac?' krow':'';
    const cli=(r.kind==='client'||r._child)?' cli':'';
    return `<div class="card ${fresh?'flash':''}${sel}${cli}"${r.mac?` data-mac="${esc(r.mac)}"`:''}${r._netGroup?` data-net="${esc(r.ssid)}"`:''}>`+(wifi?wifiCard(r):devCard(r))+`</div>`;
  }).join('');
  devRowOrder=rows.map(r=>r.mac).filter(Boolean);
}

/**
 * Builds the associated-station expand/collapse button for a card, if the record has any.
 * @param r Device/AP record.
 * @returns Button HTML, or an empty string when there are no associated stations.
 */
function cardExpandBtn(r){
  const n=beaconClients(r).length; if(!n)return '';
  const open=expandedTableAPs.has(r.mac);
  return `<button class="expBtn${open?' on':''}" data-mac="${esc(r.mac)}" onclick="toggleApExpand(this.dataset.mac,event)"
    title="${open?'collapse':'expand'} ${n} associated station(s)">${open?'&#9660;':'&#9654;'} ${n} sta</button>`;
}
/**
 * Builds the card body HTML for a client/station row.
 * @param r Client record.
 * @returns Card inner HTML.
 */
function clientCard(r){
  return `<div class="ch"><span class="cm mac">&#8618; ${esc(r.mac)}</span></div>
    <div class="cbadges">${wifiKindBadge('client')}</div>
    <div class="ch"><span class="crssi">${r.rssi}<small> dBm</small></span></div>
    <div class="cg"><span>count</span><b>${r.cnt}</b><span>age</span><b>${r.age}s</b>
      <span>vendor</span><b>${vendorCell(r)}</b></div>`;
}
/**
 * Builds the card body HTML for a grouped-network row (multiple APs sharing one SSID).
 * @param r Network group record.
 * @returns Card inner HTML.
 */
function netCard(r){
  return `<div class="ch"><span class="cm ssid">${esc(r.ssid)}</span></div>
    <div class="cbadges">${wifiKindBadge(r.kind)}<span class="tag" title="${r._members.length} APs broadcasting this name">${r._members.length} APs</span></div>
    <div class="ch"><span class="crssi">${r.rssi}<small> dBm</small></span><span class="cname">ch ${netChanList(r)}</span></div>
    <div class="cg"><span>min/max</span><b>${r.min}/${r.max}</b>
      <span>count</span><b>${r.cnt}</b><span>age</span><b>${r.age}s</b>
      <span>sta</span><b>${r.sta}</b></div>
    <button class="expBtn${expandedNetworks.has(r.ssid)?' on':''}" data-ssid="${esc(r.ssid)}" onclick="toggleNetExpand(this.dataset.ssid,event)"
      title="${expandedNetworks.has(r.ssid)?'collapse':'expand'} ${r._members.length} APs">${expandedNetworks.has(r.ssid)?'&#9660;':'&#9654;'} ${r._members.length} APs</button>
    <button class="actmenu-item" data-ssid="${esc(r.ssid)}" onclick="showNetworkInfo(this.dataset.ssid)" title="show every AP broadcasting this name">Network info&hellip;</button>`;
}
/**
 * Builds the card body HTML for a WiFi device row, dispatching by kind (client, grouped network, or AP/probe).
 * @param r Device record.
 * @returns Card inner HTML.
 */
function wifiCard(r){
  if(r.kind==='client')return clientCard(r);
  if(r._netGroup)return netCard(r);
  const name=r.ssidbad?ssidHtml(r.ssid,r.ssidbad,r.ssidhex):(r.ssid?esc(r.ssid):(r.hid?'<span class="hidn" title="cloaked AP â€” SSID withheld from beacons">&#8249;hidden&#8250;</span>':'<span class="muted">(hidden)</span>'));
  const cloak=r.hid&&r.ssid?`<span class="tag hidn" title="AP cloaks its SSID; name recovered from a directed probe-response / association">cloaked</span>`:'';
  return `<div class="ch"><span class="cm ssid">${name}</span><span class="refbtn ${r.mac===refMac?'on':''}" data-mac="${esc(r.mac)}"
       title="${r.mac===refMac?'clear radar focus':'set radar focus'}" onclick="setRef(this.dataset.mac)">&#9678;</span></div>
    <div class="cbadges">${wifiKindBadge(r.kind)}${cloak}${cliBadge(r)}</div>
    <div class="ch"><span class="crssi">${r.rssi}<small> dBm</small></span><span class="cname">ch ${r.ch}</span></div>
    <div class="cg">${secCard(r)}<span>min/max</span><b>${r.min}/${r.max}</b>
      <span>count</span><b>${r.cnt}</b><span>age</span><b>${r.age}s</b>
      <span>mac</span><b class="mac">${macLink(r.mac)}</b><span>vendor</span><b>${vendorCell(r)}</b></div>
    ${cardExpandBtn(r)}`;
}
/**
 * Clears the radar box-selection and re-renders the device list and radar.
 */
function clearBoxSel(){boxSel=null; renderDevices(); drawRadar(lastDevs);}
/**
 * Toggles the collapsed state of a container element and updates its toggle button's glyph.
 * @param id Element id of the collapsible container.
 * @param btn Button element whose caret glyph is flipped.
 */
function toggleCollapse(id,btn){
  const c=document.getElementById(id).classList.toggle('collapsed');
  btn.innerHTML=c?'&#9660;':'&#9650;';
}

const WKIND={beacon:['BEACON','wbcn'],probe:['PROBE','wprb'],client:['STATION','wcli']};
/**
 * Builds the kind badge (beacon/probe/station) for a WiFi row.
 * @param k Row kind key, one of `WKIND`'s keys; falls back to probe if unknown.
 * @returns Badge HTML.
 */
function wifiKindBadge(k){const e=WKIND[k]||WKIND.probe;return `<span class="tag ${e[1]}">${e[0]}</span>`;}
/**
 * Builds the associated-station-count badge for an AP row, clickable to open its MAC info modal.
 * @param r AP record.
 * @returns Badge HTML, or an empty string when it has no associated stations.
 */
function cliBadge(r){const n=beaconClients(r).length;
  return n?`<span class="tag wcli" data-mac="${esc(r.mac)}" onclick="showMacInfo(this.dataset.mac)" title="${n} station(s) associated to this AP â€” click for the client list + activity">${n} sta</span>`:'';}
/**
 * Builds the STA table cell showing associated-station count and a NEW badge for stations associated since the last capture window.
 * @param r Device record.
 * @returns Table cell HTML; an em-dash cell for non-beacon rows.
 */
function staCell(r){
  if(r.kind!=='beacon') return '<td class="muted">&mdash;</td>';
  const cl=beaconClients(r), nn=cl.filter(m=>newStationMacs.has(m)).length;
  return `<td>${cl.length}${nn?` <span class="tag newmac" title="${nn} station${nn>1?'s':''} newly associated since the last capture window">+${nn}</span>`:''}</td>`;}

const SEC_LABEL=['?','OPEN','WEP','WPA','WPA-Ent','WPA2','WPA/WPA2','WPA2-Ent','WPA3','WPA2/WPA3','WPA3-Ent','OWE'];
const SEC_CLASS=['secu','seco','secw','secw','secw','sec2','sec2','sec2e','sec3','secmix','sec3e','sec2'];
const CIP_LABEL=['','WEP','TKIP','CCMP','TKIP+CCMP','GCMP-128','GCMP-256','?'];
const PMF_LABEL=['','PMF-capable','PMF-required'];
/**
 * Builds the descriptive security text for a record (auth label, pairwise cipher, PMF, and a "(scan)" suffix when the value came from a coarse passive scan rather than a real beacon-IE parse).
 * @param r Record with `sec`/`cip`/`pmf`/`secie` fields.
 * @returns Human-readable security description.
 */
function secText(r){const s=r.sec||0; let t=SEC_LABEL[s]||'?';
  const c=CIP_LABEL[r.cip||0]; if(c&&s>2)t+=' Â· '+c;
  const p=PMF_LABEL[r.pmf||0]; if(p)t+=' Â· '+p;
  if(s===9) t+=' Â· transition mode, WPA2 fallback possible';
  if(s>1 && !r.secie) t+=' (scan)'; return t;}
/**
 * Builds the SEC column badge, flagged as weak for open/WEP networks.
 * @param r Record with a `sec` field.
 * @returns Badge HTML with `secText()` as its tooltip.
 */
function secBadge(r){const s=r.sec||0; const weak=(s===2);
  return `<span class="tag ${SEC_CLASS[s]||'secu'}${weak?' secweak':''}" title="${esc(secText(r))}">${SEC_LABEL[s]||'?'}</span>`;}
/**
 * Builds the SEC table cell for a beacon row.
 * @param r Device record.
 * @returns Table cell HTML; an em-dash cell for non-beacon rows.
 */
function secCell(r){return r.kind==='beacon'?`<td>${secBadge(r)}</td>`:'<td class="muted">&mdash;</td>';}
const SECHDR='<th data-k="sec" title="AP security: auth/key-mgmt + pairwise cipher">SEC</th>';
/**
 * Builds the security label/value pair for the card view.
 * @param r Device record.
 * @returns HTML fragment, or an empty string for non-beacon rows.
 */
function secCard(r){return r.kind==='beacon'?`<span>sec</span><b>${secBadge(r)}</b>`:'';}
/**
 * Builds a signal-strength bar sized and coloured from an RSSI value.
 * @param rssi Signal strength in dBm.
 * @returns Bar HTML.
 */
function sigBar(rssi){const pct=Math.max(4,Math.min(100,Math.round((rssi+95)/65*100)));
  const cls=pct>66?'good':pct>33?'ok':'weak';
  return `<div class="sigbar-wrap" title="signal strength: ${rssi} dBm"><div class="sigbar ${cls}" style="width:${pct}%"></div></div>`;}

let lastFmFiles=[];
/**
 * Opens the File Manager modal and (re)loads its file list.
 */
function openFileMgr(){
  const m=document.getElementById('fileMgrModal'); if(m)m.classList.add('on');
  fmRefresh();
}
/**
 * Closes the File Manager modal.
 */
function closeFileMgr(){
  const m=document.getElementById('fileMgrModal'); if(m)m.classList.remove('on');
}
/**
 * Fetches /api/files/list and renders the File Manager's file list as stacked, wrapping rows
 * (not a <table> -- a long filename plus three action buttons has nowhere to go on a narrow
 * phone screen except onto a second line, which a nowrap table cell can't do). Shows an
 * appropriate empty-state message when there's no SD card or no files.
 */
async function fmRefresh(){
  const box=document.getElementById('fmList'); if(!box)return;
  try{
    lastFmData=await(await fetch('/api/files/list')).json();
    lastFmFiles=lastFmData.files||[];
    fmRender();
  }catch(e){box.innerHTML='Error loading file list.';fmTabsRender([]);}
}
/**
 * Where a File Manager entry belongs. Order is the tab order; the last entry catches anything else.
 */
const FM_SECTIONS=[
  {id:'sess',   label:'Sessions',   test:n=>!n.includes('/')&&/^(session_|wscan_)/.test(n)},
  {id:'gps',    label:'GPS',        test:n=>n.startsWith('gps/')},
  {id:'hs',     label:'Handshakes', test:n=>n.startsWith('handshakes/')},
  {id:'frames', label:'Frames',     test:n=>n.startsWith('frames/')},
  {id:'localap',label:'Local AP',   test:n=>n.startsWith('localap/')},
  {id:'sentinel',label:'Sentinel',  test:n=>n.startsWith('sentinel/')},
  {id:'misc',   label:'Other',      test:()=>true},
];
let lastFmData=null;
let fmSection='';
/**
 * Renders the File Manager from the last /api/files/list result: a horizontal strip of section
 * tabs (only sections that have files), then the active section's rows. Row actions still index
 * into lastFmFiles, so the original index is carried through.
 */
function fmRender(){
  const box=document.getElementById('fmList'); if(!box||!lastFmData)return;
  if(!lastFmData.sd){box.innerHTML='No SD card on this board.';fmTabsRender([]);return;}
  if(!lastFmFiles.length){box.innerHTML='No files on the card yet.';fmTabsRender([]);return;}
  const live=FM_SECTIONS.map(s=>({s,idx:[]}));
  lastFmFiles.forEach((f,i)=>live.find(g=>g.s.test(f.name)).idx.push(i));
  const shown=live.filter(g=>g.idx.length);
  if(!shown.some(g=>g.s.id===fmSection)) fmSection=shown[0].s.id;
  fmTabsRender(shown);
  const cur=shown.find(g=>g.s.id===fmSection);
  const size=cur.idx.reduce((t,i)=>t+lastFmFiles[i].size,0);
  box.innerHTML=
    `<div class="fmhead"><span>${esc(cur.s.label)}</span><span>${cur.idx.length} file(s) &middot; ${fmtBytes(size)}</span></div>`+
    cur.idx.map(i=>{const f=lastFmFiles[i];
      return `<div class="fmrow"><span class="fmname">${esc(fmBaseName(f.name))}</span>`+
      `<span class="fmsize">${fmtBytes(f.size)}</span>`+
      `<span class="fmbtns">`+
      `<button class="icobtn" onclick="fmDownload(${i})" title="Download">&darr;</button>`+
      `<button class="icobtn" onclick="requestFmRename(${i})" title="Rename">&#9998;</button>`+
      `<button class="icobtn confirm" onclick="requestFmDelete(${i})" title="Delete">&times;</button>`+
      `</span></div>`;}).join('')+
    (lastFmData.cap?`<div class="sethint">${fmtBytes(lastFmData.used)} / ${fmtBytes(lastFmData.cap)} used on card</div>`:'');
}
/**
 * Draws the section tab strip.
 * @param shown Sections that have files, each as {s,idx}.
 */
function fmTabsRender(shown){
  const tabs=document.getElementById('fmTabs'); if(!tabs)return;
  tabs.innerHTML=shown.map(g=>
    `<button class="fmtab${g.s.id===fmSection?' on':''}" role="tab" onclick="fmPick('${g.s.id}')">`+
    `${esc(g.s.label)}<b>${g.idx.length}</b></button>`).join('');
}
/**
 * Switches the File Manager to one section and redraws from the cached list.
 * @param id Section id from FM_SECTIONS.
 */
function fmPick(id){ fmSection=id; fmRender(); }
/**
 * Downloads one SD file via /api/files/download, triggering the browser's normal save flow.
 * @param i Index into lastFmFiles (looked up by index, not name, so an arbitrary uploaded
 *        filename never has to be embedded in inline JS).
 */
function fmDownload(i){
  const f=lastFmFiles[i]; if(!f)return;
  window.open('/api/files/download?name='+encodeURIComponent(f.name),'_blank');
}
/**
 * Opens the confirm modal to delete one SD file.
 * @param i Index into lastFmFiles.
 */
function requestFmDelete(i){
  const f=lastFmFiles[i]; if(!f)return;
  openConfirm('Delete "'+esc(f.name)+'"? This cannot be undone.','Delete',()=>fmDelete(f.name));
}
/**
 * Deletes one SD file via /api/files/delete and refreshes the file list.
 * @param name File name/path as reported by /api/files/list.
 */
async function fmDelete(name){
  const st=document.getElementById('fmStatus');
  try{
    const r=await(await fetch('/api/files/delete',{method:'POST',body:'name='+encodeURIComponent(name)})).json();
    if(st)st.textContent=r.ok?'Deleted '+name+'.':'Delete failed.';
  }catch(e){if(st)st.textContent='Delete failed.';}
  fmRefresh();
}
/**
 * Derives the bare (subfolder-stripped) filename part of a File Manager relName, for prefilling
 * the rename input -- a rename can't move a file between subfolder and root, only relabel it, so
 * only this part is ever editable.
 * @param relName Path as reported by /api/files/list.
 * @returns The filename with any subfolder prefix (incl. a nested one like "localap/templates/") stripped.
 */
function fmBaseName(relName){
  const i=relName.lastIndexOf('/');
  return i<0?relName:relName.substring(i+1);
}
/**
 * Opens the confirm modal (with a text input in its extra slot) to rename one SD file.
 * @param i Index into lastFmFiles.
 */
function requestFmRename(i){
  const f=lastFmFiles[i]; if(!f)return;
  const base=fmBaseName(f.name);
  openConfirm('Rename "'+esc(f.name)+'" to:','Rename',
    ()=>{ const inp=document.getElementById('fmRenameInput');
          if(inp&&inp.value&&inp.value!==base)fmRename(f.name,inp.value); },
    `<input type="text" id="fmRenameInput" value="${esc(base)}" style="width:100%;box-sizing:border-box">`);
}
/**
 * Renames one SD file via /api/files/rename and refreshes the file list. The new name is kept in
 * whatever subfolder (or root) the file already lived in -- only the bare filename is sent.
 * @param name Current file name/path as reported by /api/files/list.
 * @param newName New bare filename.
 */
async function fmRename(name,newName){
  const st=document.getElementById('fmStatus');
  try{
    const r=await(await fetch('/api/files/rename',{method:'POST',
      body:'name='+encodeURIComponent(name)+'&newname='+encodeURIComponent(newName)})).json();
    if(st)st.textContent=r.ok?('Renamed to '+newName+'.'):('Rename failed: '+(r.err||'?'));
  }catch(e){if(st)st.textContent='Rename failed.';}
  fmRefresh();
}
/**
 * Uploads a user-selected file straight into the card's /802eleven root via
 * /api/files/upload?name=<filename> (raw body, no multipart wrapping needed since the whole
 * request body IS the file).
 * @param inp File input element holding the selected file.
 */
async function fmUpload(inp){
  const file=inp.files&&inp.files[0]; inp.value=''; if(!file)return;
  const st=document.getElementById('fmStatus'); if(st)st.textContent='Uploading '+file.name+'â€¦';
  try{
    const r=await(await fetch('/api/files/upload?name='+encodeURIComponent(file.name),
      {method:'POST',headers:{'Content-Type':'application/octet-stream'},body:file})).json();
    if(st)st.textContent=r.ok?('Uploaded '+file.name+'.'):('Upload failed: '+(r.err||'?'));
  }catch(e){if(st)st.textContent='Upload failed.';}
  fmRefresh();
}
const SECTOOLS=1;
let RECON=0;RECON=1;
let hsNotified=new Set(), hsBaselined=false;
/**
 * Detects newly-completed handshakes/PMKID captures and raises a toast + flash notification for each.
 * On the first call it only baselines `hsNotified` from the current list without notifying, so a page load doesn't re-announce already-captured handshakes.
 * @param list Current handshake records (each with `mask`, `pmkid`, `client`, `bssid`).
 */
function notifyHandshakeReady(list){
  if(!hsBaselined){
    hsBaselined=true;
    (list||[]).forEach(h=>{ if((h.mask&0xF)===0xF||h.pmkid) hsNotified.add(h.client+'|'+h.bssid); });
    return;
  }
  (list||[]).forEach(h=>{
    const full=(h.mask&0xF)===0xF;
    if(!full&&!h.pmkid)return;
    const key=h.client+'|'+h.bssid;
    if(hsNotified.has(key))return;
    hsNotified.add(key);
    const hde2=document.getElementById('hde2');
    if(hde2){hde2.classList.remove('flash');void hde2.offsetWidth;hde2.classList.add('flash');}
    hsToast((full?'4-way handshake':'PMKID')+' captured for '+(h.bssid||'unknown BSSID')+' â€” see Authorisations.');
    if(typeof loadHsFiles==='function') setTimeout(loadHsFiles,1500);
  });
}
/**
 * Shows a transient toast notification, creating the toast element on first use.
 * @param msg Message text to display.
 */
function hsToast(msg){
  let t=document.getElementById('hsToastEl');
  if(!t){ t=document.createElement('div'); t.id='hsToastEl'; t.className='hsToast'; document.body.appendChild(t); }
  t.textContent=msg;
  t.classList.remove('on'); void t.offsetWidth; t.classList.add('on');
  clearTimeout(t._to); t._to=setTimeout(()=>t.classList.remove('on'),6000);
}
/**
 * Builds the 4-way-handshake progress dots (M1-M4) and a "4/4" label when complete.
 * @param mask Bitmask of received handshake messages (bit i = message i+1).
 * @returns Badge HTML.
 */
function hsBadges(mask){let h='<span class="hsdots">';
  for(let i=0;i<4;i++)h+=`<span class="${(mask&(1<<i))?'on':''}" title="M${i+1}"></span>`;
  return h+'</span>'+((mask&0xF)===0xF?' <b>4/4</b>':'');}
/**
 * Copies a PMKID hex string to the clipboard and briefly shows "copied" in the triggering element.
 * @param el Element whose text is temporarily replaced to confirm the copy.
 * @param hex PMKID hex string to copy.
 */
function copyPmkid(el,hex){if(navigator.clipboard)navigator.clipboard.writeText(hex).catch(()=>{});
  const t=el.textContent; el.textContent='copied'; setTimeout(()=>{el.textContent=t;},900);}
/**
 * Copies a MAC address to the clipboard and briefly flags the triggering element as copied.
 * @param el Element to toggle the `copied` class on.
 * @param mac MAC address to copy.
 */
function copyMac(el,mac){if(navigator.clipboard)navigator.clipboard.writeText(mac).catch(()=>{});
  el.classList.add('copied'); setTimeout(()=>el.classList.remove('copied'),900);}
/**
 * Builds the PMKID table cell, clickable to copy the full value when present.
 * @param h Handshake record.
 * @returns Cell HTML.
 */
function pmkCell(h){return h.pmkid
  ?`<span class="pmk" title="click to copy full PMKID" onclick="copyPmkid(this,'${h.pmkid}')">${h.pmkid.slice(0,12)}&hellip;</span>`
  :'<span class="pmk none">&mdash;</span>';}
/** Toggles the "PMKID only" handshake filter, updates the filter button state, and re-renders the handshakes table. */
function togglePmkOnly(){pmkOnly=!pmkOnly;
  const b=document.getElementById('pmkOnlyBtn'); if(b)b.classList.toggle('on',pmkOnly);
  renderHandshakes();}
/**
 * Renders the authorisation summary tiles (full handshakes, PMKID captures, distinct networks) from `lastHandshake` into #authSum.
 */
function renderAuthSummary(){if(RECON)return;
  const el=document.getElementById('authSum'); if(!el)return;
  const full=lastHandshake.filter(h=>(h.mask&0xF)===0xF).length;
  const pmk=lastHandshake.filter(h=>h.pmkid).length;
  const nets=new Set(lastHandshake.map(h=>h.bssid)).size;
  const tile=(v,l)=>`<div class="stattile"><span class="v">${v}</span><span class="l">${l}</span></div>`;
  el.innerHTML=tile(full,'Full handshakes')+tile(pmk,'PMKID captures')+tile(nets,'Networks');}
/**
 * Builds the PCAP download cell for a handshake row, sourcing from the SD-backed file list when available, otherwise a RAM-staged capture target.
 * @param h Handshake record.
 * @returns Cell HTML: a download link/button, a "staging" placeholder, or an em-dash when unavailable.
 */
function hsPcapCell(h){
  if(RECON) return '<span class="muted">&mdash;</span>';
  if(hsSdAvail){
    const nm=hsdByBssid.get(h.bssid);
    return nm
      ? `<a class="icobtn" href="/api/security/handshake?name=${encodeURIComponent(nm)}" download title="Download ${esc(nm)}">&darr;</a>`
      : '<span class="muted">&mdash;</span>';
  }
  const t=hsrTargets.get(h.bssid);
  if(!t) return '<span class="muted">&mdash;</span>';
  return t.ready
    ? `<button class="icobtn" data-mac="${esc(h.bssid)}" onclick="downloadRamPcap(this.dataset.mac)" title="Download pcap">&darr;</button>`
    : '<span class="muted">staging&hellip;</span>';
}
/**
 * Renders the handshakes table (#hst) from `lastHandshake`, applying the PMKID-only filter and sorting by age, and refreshes the empty-state and count elements.
 */
function renderHandshakes(){
  const tb=document.querySelector('#hst tbody'); if(!tb){renderAuthSummary();return;}
  const hhs=document.getElementById('hhs'); if(hhs)hhs.textContent=lastHandshake.length;
  const sec=document.getElementById('hsSec'), empty=document.getElementById('hsEmpty');
  if(sec)sec.style.display=lastHandshake.length?'':'none';
  if(empty)empty.style.display=lastHandshake.length?'none':'';
  const rows=(pmkOnly?lastHandshake.filter(h=>h.pmkid):lastHandshake).slice().sort((a,b)=>a.age-b.age);
  tb.innerHTML = rows.length ? rows.map(h=>{
    const full=(h.mask&0xF)===0xF;
    return `<tr class="${full?'hs-full':''}">`+
      `<td data-label="Age">${h.age}s</td>`+
      `<td class="mac" data-label="Client">${macCell(h.client)}</td>`+
      `<td class="mac" data-label="BSSID (SSID)">${bssidCell(h.bssid)}</td>`+
      `<td data-label="Progress">${hsBadges(h.mask)}</td>`+
      `<td data-label="PMKID">${pmkCell(h)}</td>`+
      `<td data-label="RSSI">${h.rssi}</td>`+
      `<td data-label="Cnt"><b>${h.cnt}</b></td>`+
      `<td data-label="PCAP">${hsPcapCell(h)}</td></tr>`;
  }).join('') : (pmkOnly?`<tr><td colspan="8" class="muted" style="padding:14px">No PMKID captures seen.</td></tr>`:'');
  renderAuthSummary();
}
/**
 * Formats a byte count as a human-readable size in B, KB, or MB.
 * @param n Size in bytes.
 * @returns Formatted size string.
 */
function humanSize(n){if(n<1024)return n+' B';if(n<1048576)return (n/1024).toFixed(1)+' KB';return (n/1048576).toFixed(1)+' MB';}
/**
 * Extracts the BSSID encoded in a handshake pcap filename (`hs_<...>.pcapng`, last 12 hex chars before the extension).
 * @param name File name to parse.
 * @returns Colon-separated uppercase MAC, or null if the name doesn't match the expected pattern.
 */
function hsFileBssid(name){
  if(!name.startsWith('hs_')||!name.endsWith('.pcapng'))return null;
  const mid=name.slice(3,-7);
  if(mid.length<12)return null;
  const hex=mid.slice(-12);
  if(!/^[0-9a-fA-F]{12}$/.test(hex))return null;
  return hex.match(/.{2}/g).join(':').toLowerCase();
}
let hsdByBssid=new Map();
/**
 * Fetches the SD-stored handshake pcap file list from `/api/security/handshakes`, rebuilds `hsdByBssid`, renders the file table (#hsdt), and re-renders the handshakes view.
 * @returns Promise resolved once the fetch and render complete (rejections are swallowed).
 */
function loadHsFiles(){
  if(RECON){
    ['hsdSec','hsdEmpty','hsRamSec','pmkOnlyBtn'].forEach(id=>{
      const e=document.getElementById(id); if(e)e.style.display='none';
    });
    if(!document.getElementById('_reconColStyle')){
      const st=document.createElement('style');
      st.id='_reconColStyle';
      st.textContent='#hst thead th:nth-child(5),#hst tbody td:nth-child(5),#hst thead th:nth-child(8),#hst tbody td:nth-child(8){display:none}';
      document.head.appendChild(st);
    }
    return Promise.resolve();
  }
  return fetch('/api/security/handshakes').then(r=>r.json()).then(d=>{
    hsSdAvail=!!d.sd;
    const ramSec=document.getElementById('hsRamSec');
    if(ramSec)ramSec.style.display=hsSdAvail?'none':'';
    const tb=document.querySelector('#hsdt tbody'), cnt=document.getElementById('hsdc'),
          sec=document.getElementById('hsdSec'), empty=document.getElementById('hsdEmpty');
    if(!tb)return;
    const files=d.files||[];
    if(cnt)cnt.textContent=files.length;
    if(sec)sec.style.display=files.length?'':'none';
    if(empty)empty.style.display=files.length?'none':'';
    hsdByBssid=new Map();
    for(const f of files){ const b=hsFileBssid(f.name); if(b)hsdByBssid.set(b,f.name); }
    tb.innerHTML=files.map(f=>{
      const nm=esc(f.name);
      return `<tr><td class="mac">${nm}<span class="muted" style="margin-left:8px">${humanSize(f.size)}</span></td>`+
        `<td style="text-align:right;white-space:nowrap"><div style="display:inline-flex;gap:6px">`+
        `<a class="icobtn" href="/api/security/handshake?name=${encodeURIComponent(f.name)}" download title="Download ${nm}">&darr;</a>`+
        `<button class="icobtn" onclick="openHsDelModal('${nm}')" title="Delete ${nm}">&times;</button>`+
        `</div></td></tr>`;
    }).join('');
    renderHandshakes();
  }).catch(()=>{});
}
let hsDelPending=null;
/**
 * Opens the handshake-file delete-confirmation modal.
 * @param name File name pending deletion, stored in `hsDelPending`.
 */
function openHsDelModal(name){
  hsDelPending=name;
  const body=document.getElementById('hsDelModalBody');
  if(body)body.textContent='Delete "'+name+'"? This cannot be undone.';
  const err=document.getElementById('hsDelModalErr'); if(err)err.style.display='none';
  document.getElementById('hsDelModal').classList.add('on');
}
/** Clears the pending delete target and hides the handshake-file delete modal. */
function closeHsDelModal(){
  hsDelPending=null;
  document.getElementById('hsDelModal').classList.remove('on');
}
/**
 * Submits the pending handshake-file deletion to `/api/security/handshake`, closing the modal and reloading the file list on success or showing an error in the modal otherwise.
 */
function confirmHsDelete(){
  if(!hsDelPending)return;
  const name=hsDelPending;
  const btn=document.getElementById('hsDelModalBtn'); if(btn)btn.disabled=true;
  const body=new URLSearchParams({name,del:'1'});
  fetch('/api/security/handshake',{method:'POST',body})
    .then(r=>r.json()).then(d=>{
      if(btn)btn.disabled=false;
      if(!d.ok){
        const err=document.getElementById('hsDelModalErr');
        if(err){err.textContent='Delete failed: '+(d.err||'unknown error');err.style.display='';}
        return;
      }
      closeHsDelModal();
      loadHsFiles();
    }).catch(e=>{
      if(btn)btn.disabled=false;
      const err=document.getElementById('hsDelModalErr');
      if(err){err.textContent='Delete failed: '+e;err.style.display='';}
    });
}
let hsrArmed=false, hsSdAvail=false;
let hsrTargets=new Map();
/** Toggles RAM-based handshake capture arming via `/api/security/handshake/capture` and refreshes the armed-state UI on success. */
function toggleHsRamCapture(){
  const want=!hsrArmed;
  fetch('/api/security/handshake/capture',{method:'POST',body:new URLSearchParams({on:want?'1':'0'})})
    .then(r=>r.json()).then(d=>{if(d.ok){hsrArmed=d.armed;renderHsRamArmed();loadHsRam();}})
    .catch(()=>{});
}
/** Updates the RAM-capture armed-status pill and arm/disarm button to reflect `hsrArmed`. */
function renderHsRamArmed(){
  const pill=document.getElementById('hsrArmedPill'), btn=document.getElementById('hsrCapBtn');
  if(pill){pill.className='statuspill '+(hsrArmed?'up':'down');
    pill.innerHTML='<span class="dot"></span>'+(hsrArmed?'Armed':'Off');}
  if(btn){btn.classList.toggle('on',hsrArmed); btn.textContent=hsrArmed?'Disarm':'Arm';}
}
/**
 * Downloads a RAM-staged handshake pcap for a target BSSID and triggers a browser save; toasts an error message on failure.
 * @param bssid Target AP BSSID whose staged capture to download.
 */
async function downloadRamPcap(bssid){
  try{
    const r=await fetch('/api/security/handshake/ram?bssid='+encodeURIComponent(bssid));
    if(!r.ok){
      let msg='HTTP '+r.status;
      try{ const e=await r.json(); if(e&&e.err)msg=e.err; }catch(_){}
      hsToast('Download failed ('+msg+') -- target may have been cleared or not ready yet.');
      return;
    }
    const blob=await r.blob();
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url; a.download='hs_ram_'+bssid.replace(/:/g,'')+'.pcapng';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),4000);
  }catch(e){ hsToast('Download failed: '+e); }
}
/**
 * Fetches RAM-staged handshake capture state from `/api/security/handshakes/ram` and re-renders the handshakes view; no-op when SD storage is in use.
 */
function loadHsRam(){
  if(hsSdAvail)return;
  fetch('/api/security/handshakes/ram').then(r=>r.json()).then(d=>{
    hsrArmed=!!d.armed; renderHsRamArmed();
    hsrTargets=new Map((d.targets||[]).map(t=>[t.bssid,t]));
    renderHandshakes();
  }).catch(()=>{});
}
const TDONGLE=1;

/**
 * Builds the table-view associated-station expand/collapse button for a beacon row.
 * @param r Device record.
 * @returns Button HTML, or an empty string for non-beacon rows or rows with no associated stations.
 */
function expandCell(r){
  if(r.kind!=='beacon')return '';
  const n=beaconClients(r).length; if(!n)return '';
  const open=expandedTableAPs.has(r.mac);
  return ` <button class="expBtn${open?' on':''}" data-mac="${esc(r.mac)}" onclick="toggleApExpand(this.dataset.mac,event)"
    title="${open?'collapse':'expand'} ${n} associated station(s)">${open?'&#9660;':'&#9654;'} ${n} sta</button>`;
}
/**
 * Toggles whether a grouped network's member APs are expanded in the device list.
 * @param ssid SSID of the network group to toggle.
 * @param ev Optional triggering event, whose propagation is stopped so the row click isn't also handled.
 */
function toggleNetExpand(ssid,ev){
  if(ev){ev.stopPropagation();}
  if(expandedNetworks.has(ssid))expandedNetworks.delete(ssid); else expandedNetworks.add(ssid);
  renderDevices();
}
/**
 * Builds the expand/collapse button for a grouped-network row.
 * @param r Network group record.
 * @returns Button HTML, or an empty string for non-group rows.
 */
function netExpandCell(r){
  if(!r._netGroup)return '';
  const n=r._members.length, open=expandedNetworks.has(r.ssid);
  return ` <button class="expBtn${open?' on':''}" data-ssid="${esc(r.ssid)}" onclick="toggleNetExpand(this.dataset.ssid,event)"
    title="${open?'collapse':'expand'} ${n} APs broadcasting this name">${open?'&#9660;':'&#9654;'} ${n} APs</button>`;
}
/**
 * Formats a network group's channel list for display.
 * @param r Network group record with a `_chans` array.
 * @returns Comma-separated channel list, or a muted placeholder when empty.
 */
function netChanList(r){
  return r._chans&&r._chans.length ? r._chans.join(', ') : '<span class="muted">-</span>';
}
/**
 * Builds the rotating-MAC group-size badge for a collapsed set of randomised probe MACs.
 * @param r Device record with a `_grp` count.
 * @returns Badge HTML, or an empty string when the group has one member.
 */
function wifiGrpBadge(r){
  if(!(r._grp>1))return '';
  return ` <span class="tag wprb" title="${r._grp} rotating randomised MACs probing for &quot;${esc(r.ssid)}&quot; â€” one shown, RSSI averaged">&times;${r._grp}</span>`;
}
/**
 * Builds the NEW badge for a device not seen before the most recent capture window.
 * @param r Device record with an `isNew` flag.
 * @returns Badge HTML, or an empty string.
 */
function wifiNewBadge(r){
  return r.isNew?' <span class="tag newmac" title="not seen before the most recent capture window">NEW</span>':'';
}
/**
 * Builds the HOTSPOT heuristic badge for a beacon with a locally-administered (randomised) BSSID.
 * @param r Device record.
 * @returns Badge HTML, or an empty string when not applicable.
 */
function wifiHotspotBadge(r){
  if(r.kind!=='beacon'||!r.rnd)return '';
  return ` <span class="tag hotspot" title="locally-administered BSSID â€” typical of a phone/PC software hotspot rather than a hardware router (heuristic)">HOTSPOT</span>`;
}
/**
 * Builds the DEVICES table row cells for a WiFi record, branching by row type (client, grouped network, or AP/probe).
 * @param r Device record.
 * @returns Concatenated `<td>` HTML for the row.
 */
function wifiCols(r){
  if(r.kind==='client')return `
  <td class="ssid">${esc(r.mac)}${r.vendor?` <span class="venlbl">(${esc(r.vendor)})</span>`:(r.rnd?' <span class="muted">(random addr)</span>':'')}${wifiNewBadge(r)}</td>
  <td>${wifiKindBadge(r.kind)}</td>${secCell(r)}${staCell(r)}
  <td class="rssi">${r.rssi}</td>
  <td>${r.ch||'<span class="muted">-</span>'}</td><td class="muted">${r.age}s</td>
  <td class="mac">${macLink(r.mac)}</td><td>${r.vendor?esc(r.vendor):(r.rnd?'<span class="muted">(random addr)</span>':'<span class="muted">(unknown OUI)</span>')}</td>`;
  if(r._netGroup)return `
  <td class="ssid"><span class="maclink" data-ssid="${esc(r.ssid)}" onclick="showNetworkInfo(this.dataset.ssid)" title="show every AP broadcasting this name">${esc(r.ssid)}</span>${netExpandCell(r)}</td>
  <td>${wifiKindBadge(r.kind)}</td>${secCell(r)}<td>${r.sta}</td>
  <td class="rssi">${r.rssi}</td>
  <td>${netChanList(r)}</td><td class="muted">${r.age}s</td>
  <td class="mac"><span class="maclink" data-ssid="${esc(r.ssid)}" onclick="showNetworkInfo(this.dataset.ssid)" title="show every AP broadcasting this name">${r._members.length} APs</span></td><td class="muted">&mdash;</td>`;
  return `
  <td class="ssid">${r.ssidbad?ssidHtml(r.ssid,r.ssidbad,r.ssidhex):(r.ssid?esc(r.ssid):(r.hid?'<span class="hidn" title="cloaked AP â€” SSID withheld from beacons">&#8249;hidden&#8250;</span>':'<span class="muted">-</span>'))}${r.hid&&r.ssid?' <span class="hidn" title="AP cloaks its SSID; name recovered from a directed probe-response / association">cloaked</span>':''}${wifiNewBadge(r)}${wifiHotspotBadge(r)}${wifiGrpBadge(r)}${expandCell(r)}</td>
  <td>${wifiKindBadge(r.kind)}</td>${secCell(r)}${staCell(r)}
  <td class="rssi">${r.rssi}</td>
  <td>${r.kind==='probe'?'<span class="muted">-</span>':r.ch}</td><td class="muted">${r.age}s</td>
  <td class="mac">${macLink(r.mac)}</td><td>${vendorCell(r)}</td>`;}
const DEVHDR_WIFI=`<th data-k="ssid">NAME / SSID</th><th data-k="kind">KIND</th>`+
  SECHDR+
  `<th data-k="clients" title="stations associated to this AP â€” click to sort, APs with clients first">STA</th>`+
  `<th data-k="rssi">RSSI</th>`+
  `<th data-k="ch">CH</th><th data-k="age">AGE</th>`+
  `<th data-k="mac">MAC</th><th data-k="vendor">VENDOR</th>`;
/**
 * Rebuilds the DEVICES table header for the WiFi view and rewires column-sort click handlers.
 */
function setDevHeader(){
  const tr=document.querySelector('#dt thead tr');
  if(tr){tr.innerHTML=DEVHDR_WIFI; wireSort('dt',dSort);}
}

const rc=document.getElementById('radar'), rx=rc.getContext('2d');
let hist={};
let rhist={};
let spawnAt={};
const SPAWN_MS=420;
/**
 * Overshoot ease-out easing function used for the device spawn animation.
 * @param t Normalised progress, 0-1.
 * @returns Eased value (may briefly exceed 1).
 */
function easeOutBack(t){const c1=1.70158,c3=c1+1;return 1+c3*Math.pow(t-1,3)+c1*Math.pow(t-1,2);}
let spawnAnimOn=false;
/**
 * Drives the spawn-in animation loop, redrawing the radar each frame until no tracked device is still within its spawn window.
 * Guarded by `spawnAnimOn` so only one animation loop runs at a time.
 */
function runSpawnAnim(){
  if(spawnAnimOn)return; spawnAnimOn=true;
  const step=()=>{
    requestAnimationFrame(()=>{
      let live=false;
      try{
        drawRadar(lastDevs);
        const now=Date.now();
        Object.keys(spawnAt).forEach(m=>{if(now-spawnAt[m]<SPAWN_MS)live=true;});
      }finally{
        if(live)step(); else spawnAnimOn=false;
      }
    });
  };
  step();
}
let plots=[];
let deauthPlots=[];
let labelOffsets={}, dragLabel=null, labelPlots=[];
let view={s:1,cx:null,cy:null};
let selRect=null;
let boxSel=null;
let spread=false;
let showAll=true;
let hideGhosts=false;
let syncSearch=false;
let syncFromRadar=false;
